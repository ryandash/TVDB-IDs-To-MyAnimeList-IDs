            "# Episodes": 34,
            "Episodes": {
                "1": {
                    "ID": "440778",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440778",
                    "Titles": {
                        "eng": "Eto Ranze's Secret",
                        "jpn": "エトランゼの秘密"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "登校初日、真壁クンに一目惚れしてしまったランゼ。恋のライバル曜子と言い争ううちに、魔界の能力が覚醒！噛みついた相手に変身できる能力が目覚めてしまう。その夜、母は一人前のモンスターになったのだからと魔界へ通じる扉の秘密を打ち明け、人間を決して好きになってはならない、それが魔界の掟だと教える。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "440779",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440779",
                    "Titles": {
                        "eng": "Door to The Demon World",
                        "jpn": "魔界への扉"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "大王様に会って普通の女の子に戻してもらうよう魔界に行く決心をしたランゼ。だって私、恋してしまったんだもん♡　開かずの扉から魔界の城へ向かうが、道に迷ってしまったランゼは途中で池に落ちてしまう。その池は、自分が一番会いたいと思っている人のところに行けるという不思議な力を持つ想いヶ池。ランゼが行きついたところとは…！？"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "440780",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440780",
                    "Titles": {
                        "eng": "Bathroom Crisis",
                        "jpn": "バスルームの危機"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "真壁クンと少しでも一緒にいたくて、学校帰りランゼは小鳥に変身して真壁クンを追跡、部屋に忍び込む。学校では見せない真壁クンの優しい素顔に接して、ランゼ幸せ♡だけど、ひょんな事から真壁クンとバスルームでふたりきりになってしまってランゼ大大大ピーンチ！！きゃぁ～っ、どうしよう…！"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "440781",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440781",
                    "Titles": {
                        "eng": "A Small Friendship",
                        "jpn": "小さな友情"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパ、ママ！ケンカばかりしてるとボク家出しちゃうからねっ！リンゼは家出を決行したものの行くあてがない。途中、ロードワークをする俊に出会いすっかりなついてしまう。お腹をすかしたリンゼを見かねた俊がリンゼを連れレストランに入ると、そこには曜子が。３人で仲良く食事をする様子を見てしまったランゼは…！"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "440782",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440782",
                    "Titles": {
                        "eng": "Ranze Goes to The Demon World",
                        "jpn": "ランゼ魔界へ行く"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "モーリとシーラは大王様から呼び出しを受け魔界へ向かう。大王からふたりに下されたのは、人間界で王子を探せという極秘命令だった。大王には魔界の王子の他にもうひとり、人間界に息子がいるというのだ！手がかりはひとつ。腕に残る星型のアザ…。一方ランゼは、魔界でちょっとドジで不思議な少年と出会う。その少年とは…？"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "440783",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440783",
                    "Titles": {
                        "eng": "Foggy Night Romance",
                        "jpn": "霧の夜のロマンス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今日の放課後は真壁クンのボクシングの試合。試合のあと勝利のお祝いにとデートに誘ったら、先約があるからって断られちゃった。ショック！一方、大王様に王子の捜索を依頼されたシーラは大張り切り。シーラに急かされしぶしぶ王子探しを開始したモーリは、ランゼの初恋の人真壁クンを知り、ランゼにシーラとの馴れ初めを話す。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "440784",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440784",
                    "Titles": {
                        "eng": "The Cultural Festival Terror",
                        "jpn": "恐怖の文化祭"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "もうすぐ文化祭。クラスの出し物がモンスターランドに決まった。神谷さんはお父様の財力にものを言わせモンスターの着ぐるみを調達。私はホンモノで勝負よっ！という事で、内緒で魔界のモンスターたちに文化祭への招待状を送っちゃった！真壁クンとふたり、お化け屋敷でムフフ～なコトになっちゃったりして～♡…でも、やっぱり大騒ぎに～？！"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "440785",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440785",
                    "Titles": {
                        "eng": "Love, Camera, Action",
                        "jpn": "恋のアクションカメラ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今日の放課後は真壁クンとデート！（ホントは宿題を忘れたバツにクラスメイトのお見舞いなんだけど。）…のハズだったのに、神谷さんの策略で邦彦クンと行くハメに。一方、魔界では王子がランゼを想ってため息をついていた。王子から人間界のランゼの様子を写真に撮ってくるよう命じられたサンドは、人間界でランゼを探すことに…。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "440786",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440786",
                    "Titles": {
                        "eng": "Tamasaburo's Love",
                        "jpn": "玉三郎の恋"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "学校帰り、ランゼは玉三郎の恋の相談に乗る。玉三郎は病院で看護婦をしている真壁クンの母・華枝に会いたくて、あの手この手で入院を試みるも上手くいかない。ついに救急車で運ばれたことから神谷組の面々が玉三郎が死んだと勘違いしてしまい大騒ぎに！困った玉三郎を見かねたランゼは、一計を案じて…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "440787",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440787",
                    "Titles": {
                        "eng": "The Invisible girl, Miel",
                        "jpn": "透明少女ミエール"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "透明人間の女の子ミエールがランゼの部屋に突然やって来た。魔界に嫌気がさして抜け出してきたという。当分お邪魔するわと、ランゼについて学校にまでやって来たミエール。そこで、よりによって真壁クンに恋しちゃったって！どうしよう…！そんなミエールが、人間界で普通の女の子になりたい、と言い出して…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "440788",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440788",
                    "Titles": {
                        "eng": "The Full Moon's Birthday",
                        "jpn": "満月の誕生日"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今日はリンゼの誕生日。ホームパーティに真壁クンが来てくれることに♡　お母さんは大反対だけど、リンゼも喜んでるし張り切らなくっちゃ！でも、それを聞きつけた神谷さんが邦彦クンを連れてやって来ちゃったから、もう大変！しかも今夜は満月。雨が降って月が隠れてくれないと…お母さん、狼女に変身しちゃう！"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "440789",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440789",
                    "Titles": {
                        "eng": "Eh?! Ranze's Wish",
                        "jpn": "うふッ!? ランゼのお願い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "真壁クンがクリスマスに欲しいものは、本物のサンタさんしかプレゼントできないものなんだって。それなら本物のサンタさんを！…と探す事になったこランゼの前に、サンタの姿をしたスーパーの宣伝マンが。なんとこの人、魔界を追い出された本物のサンタさんだったの！魔界に帰りたいサンタさんに協力することになったランゼは…。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "440790",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440790",
                    "Titles": {
                        "eng": "White Sweethearts",
                        "jpn": "白い恋人達"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "スキー教室にやって来たランゼ。班対抗のスキーマラソンでみんなに迷惑がかからないようにと、ランゼは俊から特訓を受けいいムードに。一方、スキー場へ駆けつけたシーラは俊がランゼを誘惑したと誤解、二人の間に入ろうとする。止めに入るモーリ。しかし、ランゼを守ろうと狼女になったシーラが俊に襲い掛かる！"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "440791",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440791",
                    "Titles": {
                        "eng": "I saw it!! Ranze is a Japanese Raccon!",
                        "jpn": "見た!! ランゼはたぬき"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "俊を助けたランゼはもう3日も目覚めない。ランゼが目覚めさせるため、モーリとシーラは先祖の墓からララおばあちゃんを呼び出す。ララおばあちゃんの助けで目覚めたランゼだったが、満月に似た丸いものを見ると狼の耳としっぽが出てしまう体になってしまった！学校に戻ったランゼは、うっかり曜子にも耳を見られてしまう。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "440792",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440792",
                    "Titles": {
                        "eng": "Excuse The Nudity",
                        "jpn": "裸でごめんなさい"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ランゼの耳を見てしまった曜子は、正体を暴こうとつきまとう。…すると、しっぽまで目撃してしまったのだ！困ったランゼはララおばあちゃんを頼り今度こそ正しい呪文でランゼを治してもらう。一方、ランゼを化けダヌキと確信した曜子はタヌキ退治！と大騒ぎ！。しかし誰も信用せず、落ち込む曜子を励まそうと玉三郎は…。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "440793",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440793",
                    "Titles": {
                        "eng": "The Young Runner's Love",
                        "jpn": "恋の青春ランナー"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "邦彦クンから告白を受けたランゼは、慌てて適当な返事をした事から、マラソン大会で真壁クンに勝ったら付き合ってもいい…と誤解されてしまう。張り切って猛特訓を始めた邦彦を見て、俊はその気がないのなら自分で責任を持てとランゼに忠告する。俊の言葉に、邦彦に自分の気持ちを正直に話すランゼは…。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "440794",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440794",
                    "Titles": {
                        "eng": "Fickle Magician",
                        "jpn": "浮気な魔術師"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "視聴する\r\nランゼが原因不明の高熱に。ただの風邪だが人間の風邪をうつされたモンスターは前代未聞。目覚めてみると、ランゼは人の心を操り人形のように自由にできるというマリオネット光線を使えるようになっていた。ララおばあちゃんの遺伝なんだって！元気になったランゼは、さっそくマリオネット光線を使って真壁クンをデートに誘うが…"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "440795",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440795",
                    "Titles": {
                        "eng": "Title Match of Love",
                        "jpn": "恋のタイトルマッチ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔界からお忍びでアロン王子がやって来た。アロンを王子とは知らないシーラは家から叩き出してしまう。人間界の街を興味津々で歩くアロン。王子を捜しに出かけたランゼはアロンと一緒のところを曜子に見とがめられ、一緒に俊がいるジムに行くことに。そこでアロンと俊は一触即発。ふたりはボクシングの試合をすることになってしまう。"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "440796",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440796",
                    "Titles": {
                        "eng": "The Sentimental Giant",
                        "jpn": "センチメンタル大巨人"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "シーラが巨人村のシャイアンツを魔界から呼び寄せた。ママ、お見合いなんて絶対イヤよ！ところが、シャイアンツは途中で出会った曜子に一目惚れしてしまい、デートをとりもって欲しいという。仕方なく曜子に頼みに行くランゼ。シャイアンツの1万年に1日の休日を悲しい日にしてしまうのは可哀そうと、曜子の交換条件を受け入れることに。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "440797",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440797",
                    "Titles": {
                        "eng": "Mayhem! Ranze's Full Capacity",
                        "jpn": "大混乱! ランゼがいっぱい"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "学校に行くのめんどくさーい。もう一人の自分がいればいいのに…と思ったとたん、もう一人のランゼが出現！アロンがくれたコンパクトは自分のＣＯＰＹを生み出す複写機だったのだ！さっそくCOPYを学校に送り出したランゼは、うまく入れ替わって真壁クンをデートに誘う。やったぁ、真壁クンとのデート大成功！…と思ったら…！！"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "440798",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440798",
                    "Titles": {
                        "eng": "Love Letter from E.T",
                        "jpn": "E.Tからのラブレター"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "イニシャルＥ.Ｔと名乗る女の子から俊へラブレターが届く。気になるランゼと曜子が追跡すると、そこには憧れの先輩・多岐川エリカ先輩が…ショック！翌日、俊が車で連れ去られるのを邦彦が目撃。真壁クンが誘拐された！ラブレターの主が犯人では？とランゼと曜子はエリカを問い質す。真壁クン、絶対助けるから待っててねっ！"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "440799",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440799",
                    "Titles": {
                        "eng": "Doki! Doki! Pajama Game",
                        "jpn": "ドキドキ! パジャマゲーム"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "玉三郎が社員旅行で出掛けるというので、曜子は一晩ひとりでお留守番。これはチャンス！と、俊にボディガードに来てもらう事に。俊とふたりで迎えるはじめての夜…♡と思ったら、ランゼや邦彦クンまで乱入してガックシ。せっかくふたりだけで過ごせると思ったのに…！！そこに怪しい雪男の怪物が現れて大騒ぎに！"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "440800",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440800",
                    "Titles": {
                        "eng": "Sand's Love Story",
                        "jpn": "サンドの恋の物語"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "僕がアロン王子よりデキが悪いなんて…暗いムードをまき散らし、めちゃくちゃ落ち込んで魔界からやって来たサンド。気分転換に出かけたところ、華枝さんに出会い一目惚れをしてしまう。その様子を玉三郎が見たから大変！神谷組・総員警備体制で華枝さんの警護を開始。華枝さんに近づく怪しい男サンドを撃退すべく待ち受ける！"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "440801",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440801",
                    "Titles": {
                        "eng": "Ardent Love! Great War in Demon World",
                        "jpn": "熱愛!魔界大戦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "人間界にやって来たアロン。しかしランゼと俊の仲がいい様子を見て嫉妬心に駆られ、ランゼと俊、曜子の3人を魔界へテレポートさせてしまう。しかも魔界を知った人間は生きては帰れないというのだ。脱出を図るも捕まってしまうランゼたち。魔力を使わず剣で勝負を決めようという俊の決死の挑戦に、アロンと俊の決闘が始まった！"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "440802",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440802",
                    "Titles": {
                        "eng": "He Saw The Transformation! Kill Shun",
                        "jpn": "見られた変身! 俊を殺して"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "赤ちゃんを乗せた乳母車が暴走！とっさに犬に噛みつき乳母車を止めたランゼは、俊に変身を見られてしまう。人間に秘密を知られたら、魔界に帰るか、その人間を殺すかを選ばなければならないのが掟だ。「真壁クンを殺すくらいなら、私を殺して！」ランゼの心からの叫びに、一家は魔界へ帰る決断をする。俊に最後のお別れをするランゼは…。"
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "440803",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440803",
                    "Titles": {
                        "eng": "Execution Battleship! Space Wars",
                        "jpn": "処刑戦艦! スペースウォーズ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ランゼを追って魔界の扉にやってきた俊は、魔界人の仲間になると誓う。そこへ大王の戦艦が飛来し俊を連れ去ってしまう。大王は、同じ種族同士ですら殺し合う邪悪な心を持つ人間は魔界に災いをもたらすと、俊を処刑するという。モーリとシーラは俊が信用に足る人間である事を証明するチャンスを乞い、大王は俊とランゼに試練を与える。"
                    },
                    "Aliases": []
                },
                "27": {
                    "ID": "440804",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440804",
                    "Titles": {
                        "eng": "Clash! Rocky VS. Shun",
                        "jpn": "激突・ロッキーVS俊"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "俊とロッキー赤木との試合が組まれた。赤木が自分の強さを驕りボクシングを貶めていると感じた俊は、格上の相手と分かっていても戦う決意をしたのだ。ランゼとともに特訓に励む俊。試合前日。「こんなことは一度もなかったのに…怖いんだ…」と俊はランゼに弱い心を告白する。そんな俊を初めて見たランゼは…。"
                    },
                    "Aliases": []
                },
                "28": {
                    "ID": "440805",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440805",
                    "Titles": {
                        "eng": "Delinquent Angel, Hunter of Love",
                        "jpn": "つっぱりエンジェル恋のハンター"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ランゼと俊が映画デートですって！許せない！…そんな時、玉三郎がキューピッドを見つけてきた。え～っ本物！？もしかしてコイツを使えば俊は私のモノね！映画館の前。キューピッドの矢が命中し曜子と真壁クンはラブラブ。真壁クン、急にどうしちゃったの？…。いたずらが過ぎて魔界から勘当されたというキューピッドにランゼは…。"
                    },
                    "Aliases": []
                },
                "29": {
                    "ID": "440806",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440806",
                    "Titles": {
                        "eng": "Shock! Future Encounter",
                        "jpn": "ショック! 未来との遭遇"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ひどい、お母さん！日記を見るなんて…！地下室に駆け込んだランゼ。そこは時間旅行が出来るという“過去への扉”だった。ランゼは10年前の扉をくぐり、過去への小旅行を経験する。…でも、もしかして、過去の扉があるって事は未来の扉もあるはず！と、未来の扉に飛び込んだランゼ。そこには大人になった3人がいた…。"
                    },
                    "Aliases": []
                },
                "30": {
                    "ID": "440807",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440807",
                    "Titles": {
                        "eng": "The Prince's Assassination Instruction",
                        "jpn": "王子からの暗殺指令"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ランゼを振り向かせるには真壁を殺すしかない！アロンはモーリに俊の殺害を命じる。命令には絶対従うのが魔界の掟。しかしそんな事をすればランゼが悲しみ、モーリとアロンを恨むのは必定。それに気づかないアロンはモーリを急かし、ウキウキと待っている。モーリは殺すこともできず逡巡するが、ついに深夜俊の家に忍び込む。"
                    },
                    "Aliases": []
                },
                "31": {
                    "ID": "440810",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440810",
                    "Titles": {
                        "eng": "The Migratory Bird Returns",
                        "jpn": "帰ってきた渡り鳥"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "大変！玉三郎さんとリンゼがギャングにさらわれた！曜子とともに、港の倉庫に向かったランゼ。しかし、居合わせた俊と共に捕まってしまう。ギャングの大ボスの跡目を玉三郎から奪おうというのだ。跡目を譲らなければ全員の命を奪うと脅すギャング。その時、ギャングの一味ジョーが俊とボクシングで決着をつけることを提案する…。"
                    },
                    "Aliases": []
                },
                "32": {
                    "ID": "440811",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440811",
                    "Titles": {
                        "eng": "Venture! Island of Sweethearts",
                        "jpn": "冒険! 恋人たちの島"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みんなで海にやって来た！巨大なサメに襲われそうになった欄是を助けた美しい女性・乙姫がみんなを恋人島へ招待してくれるという。竜宮城のような豪邸に招かれウキウキの一行を迎えた乙姫は豹変。乙姫は海底魔界の大魔王の娘で、みんなを奴隷にするために島へ誘ったのだという。どうすればみんなを助けられるの？！"
                    },
                    "Aliases": []
                },
                "33": {
                    "ID": "440812",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440812",
                    "Titles": {
                        "eng": "Hard times from an manga",
                        "jpn": "マンガときめき昔ばなし"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今日はリンゼの人間社会の勉強のために家族で科学博物館にやって来た。人間最古の壁画に描かれた様子があまりにモーリとシーラ、そして曜子と俊とそっくりな事から、ランゼの空想が膨らんで…。太古の世界で繰り広げるときめきワールド？！"
                    },
                    "Aliases": []
                },
                "34": {
                    "ID": "440813",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tokimeki-tonight/episodes/440813",
                    "Titles": {
                        "eng": "Love! Love! Eternal Triangle",
                        "jpn": "恋して! 愛して! 三角関係"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "視聴する\r\n人間界にいるという、もうひとりの王子とランゼが結婚をする夢を見たシーラ。これは正夢だわ！シーラに急かされモーリは王子探しを再開、俊の腕に星型のアザを発見する。もうひとりの王子とは真壁クンだったの！？大王に呼び出され、魔界へ向かう俊。…本当に真壁クンは王子様なの！？これからどうなってしまうのかしら…。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}