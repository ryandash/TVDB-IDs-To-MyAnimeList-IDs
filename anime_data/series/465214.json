            "Episodes": {
                "1": {
                    "ID": "11216193",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/towa-no-yugure/episodes/11216193",
                    "Titles": {
                        "eng": "The Woman Who Sailed the Soul",
                        "jpn": "星の海に魂の帆をかけた女"
                    },
                    "Summaries": {
                        "eng": "Akira is a stranger in a strange land. As the locals decide his fate, he must learn what happened to Towasa and the world that left him behind.",
                        "jpn": "テロリストに銃で撃たれ、意識を失ったアキラ。目を覚ました時には約200年が経過し、目の前には信じられない光景が広がっていた。戦争によって荒廃した街。国はもはやなく、“OWEL”と呼ばれる統一機構によって人々が管理される世界になっていた。結婚とはまた違う新しい“エルシー”と呼ばれる制度。かつて生きていた世界から何もかもが変わってしまった未来に放り出され、愕然とするアキラ。時を同じくしてアキラの行動を監視するものが現れ……。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "11362408",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/towa-no-yugure/episodes/11362408",
                    "Titles": {
                        "eng": "In the North After Doomsday",
                        "jpn": "終末の過ぎた北の地で"
                    },
                    "Summaries": {
                        "eng": "Akira needs answers. But between an android insisting on marriage and an aspiring storybook artist, his search for the past may lead him somewhere entirely unexpected instead.",
                        "jpn": "トワサとそっくりなアンドロイド・ユウグレから結婚を申し込まれたアキラ。その願いを拒否するも、トワサや世界に関する情報を知るユウグレと一緒に行動することに。2人は王真樹家があるトーキョーを目指して旅を始める。ハコダテから本州へ渡った2人が出会ったのは絵本作家になることを夢見る少女・アモル。オソレザンまでの道案内を申し出たアモルについて行くアキラとユウグレだったが！？"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "11362409",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/towa-no-yugure/episodes/11362409",
                    "Titles": {
                        "eng": "Dancing With You Under the Rainy Summer Sky",
                        "jpn": "雨降る夏空にきみと踊る"
                    },
                    "Summaries": {
                        "eng": "Despite Yugure's protests, Akira can't leave Amoru in the hands of OWEL. But a high-stakes rescue is the least of their troubles.",
                        "jpn": "アキラたちを逃がした罰でOWELの独房に縛られるアモル。彼女を助けるためにアキラは単身、OWELの管理局に乗り込む。アモルを発見し、助け出すアキラ。管理局から脱出を図る2人だったが途中、OWELの衛兵たちに包囲され絶体絶命の危機に……。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "11362410",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/towa-no-yugure/episodes/11362410",
                    "Titles": {
                        "eng": "A Game of Lime and Allegiance",
                        "jpn": "石化と誠実のゲーム"
                    },
                    "Summaries": {
                        "eng": "Akira and Yugure are drawn into a double date as well as family baggage.",
                        "jpn": "お見合いパーティー「FICA」で出会ったマフィアの跡継ぎ候補・カルクラムから“エルシー”を申し込まれたユウグレ。翌日、カルクラムからデートの誘いを受ける。アキラとの比較対象として、カルクラムとデートへ出かけるユウグレ。一方、カルクラムの姉・フィーデスからも“エルシー”を申し込まれたアキラ。マフィアの跡目争いが生むWデートに巻き込まれるアキラとユウグレ、さらにアモルまで同行して……。"
                    },
                    "Aliases": []
                },
