                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "急遽金沢の実家へ帰ることになった夏歩。\r\nいなくなって初めて夏歩への気持ちに気づいた奏であったが、すでに夏歩は新幹線の中。\r\n奏は仲間と一緒に、夏歩を追いかけ、自転車で金沢へ向かう。"
                    },
                    "Aliases": []
                },
                "9": {
