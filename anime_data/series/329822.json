            },
            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "6125438",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6125438",
                    "Titles": {
                        "eng": "What is evil? Whatever springs from weakness.",
                        "jpn": "悪とは何か――弱さから生ずるすべてのものだ。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "6188391",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6188391",
                    "Titles": {
                        "eng": "It takes a great talent and skill to conceal one's talent and skill.",
                        "jpn": "才能を隠すのにも卓越した才能がいる。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "6190198",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190198",
                    "Titles": {
                        "eng": "Man is an animal that makes bargains: no other animal does this - no dog exchanges bones with another.",
                        "jpn": "人間は取引をする唯一の動物である。骨を交換する犬はいない。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "6190200",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190200",
                    "Titles": {
                        "eng": "We should not be upset that others hide the truth from us, when we hide it so often from ourselves.",
                        "jpn": "他人が真実を隠蔽することに対して、我々は怒るべきでない。なぜなら、我々も自身から真実を隠蔽するのであるから。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "6190201",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190201",
                    "Titles": {
                        "eng": "Hell is other people",
                        "jpn": "地獄、それは他人である。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "6190203",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190203",
                    "Titles": {
                        "eng": "There are two kinds of lies; one concerns an accomplished fact, the other concerns a future duty.",
                        "jpn": "嘘には二種類ある。過去に関する事実上の嘘と未来に関する権利上の嘘である。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "6190204",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190204",
                    "Titles": {
                        "eng": "Nothing is as dangerous as an ignorant friend; a wise enemy is to be preferred.",
                        "jpn": "無知な友人ほど危険なものはない。賢い敵のほうがよっぽどましだ。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "6190206",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190206",
                    "Titles": {
                        "eng": "Abandon all hope, ye who enter here.",
                        "jpn": "汝等ここに入るもの、一切の望みを捨てよ。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "6190207",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190207",
                    "Titles": {
                        "eng": "Man is condemned to be free.",
                        "jpn": "人間は自由の刑に処されている。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "6190209",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190209",
                    "Titles": {
                        "eng": "Every man has in himself the most dangerous traitor of all.",
                        "jpn": "裏切者の中で最も危険なる裏切者は何かといえば、すべての人間が己れ自身の内部にかくしているところのものである。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "6190210",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190210",
                    "Titles": {
                        "eng": "What people commonly call fate is mostly their own stupidity.",
                        "jpn": "しかし、概して人々が運命と呼ぶものは、大半が自分の愚行にすぎない。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "6190212",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/6190212",
                    "Titles": {
                        "eng": "Genius lives only one story above madness.",
                        "jpn": "天才とは、狂気よりも1階層分だけ上に住んでいる者のことである。"
                    },
                    "Aliases": []
                }
            }
        },
        "2": {
            "ID": "1986398",
            "URL": "https://thetvdb.com/series/classroom-of-the-elite/seasons/official/2",
            "Titles": {
                "eng": null,
                "jpn": null
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "9139577",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9139577",
                    "Titles": {
                        "eng": "Remember to keep a clear head in difficult times.",
                        "jpn": "困難の中でこそ、平静な心を保たねばならない。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "9230640",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230640",
                    "Titles": {
                        "eng": "There are two main human sins from which all the others derive: impatience and indolence.",
                        "jpn": "あらゆる罪の源たる、ふたつの大罪がある。焦りと怠惰だ。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "9230641",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230641",
                    "Titles": {
                        "eng": "The greatest souls are capable of the greatest vices as well as of the greatest virtues.",
                        "jpn": "最高の魂は、この上ない悪徳と極限の美徳を発揮できる。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "9230642",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230642",
                    "Titles": {
                        "eng": "The material has to be created.",
                        "jpn": "人材は作り出す必要がある。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "9230643",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230643",
                    "Titles": {
                        "eng": "Every failure is a step to success.",
                        "jpn": "すべての失敗は成功への過程に過ぎない。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "9230644",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230644",
                    "Titles": {
                        "eng": "Adversity is the first path to truth.",
                        "jpn": "逆境は真実へと至る最初の道筋である。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "9230645",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230645",
                    "Titles": {
                        "eng": "To doubt everything or to believe everything are two equally convenient solutions; both dispense with the necessity of reflection.",
                        "jpn": "すべてを疑うこともすべてを信じることも共に安易で、 思考を放棄するに等しい。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "9230646",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230646",
                    "Titles": {
                        "eng": "The wound is at her heart.",
                        "jpn": "胸の底で、傷は静かに生きている。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "9230647",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230647",
                    "Titles": {
                        "eng": "If you make a mistake and do not correct it, this is called a mistake.",
                        "jpn": "過ちを犯しながら、それを改めないことをこそ、 真の過ちという。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "9230648",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230648",
                    "Titles": {
                        "eng": "People, often deceived by an illusive good, desire their own ruin.",
                        "jpn": "人々は常にその破滅を願っている。偽りの善に 欺かれるがゆえに。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "9230649",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230649",
                    "Titles": {
                        "eng": "A man who cannot command himself will always be a slave.",
                        "jpn": "自分自身を御せない者は、いつまでも奴隷のままだ。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "9230650",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230650",
                    "Titles": {
                        "eng": "Force without wisdom falls of its own weight.",
                        "jpn": "思慮なき力は自らの質量によって崩れ去る。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "9230651",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/9230651",
                    "Titles": {
                        "eng": "The worst enemy you can meet will always be yourself.",
                        "jpn": "あなたが出会う最悪の敵は、常にあなた自身だ。"
                    },
                    "Aliases": []
                }
            }
        },
        "3": {
            "ID": "2074736",
            "URL": "https://thetvdb.com/series/classroom-of-the-elite/seasons/official/3",
            "Titles": {
