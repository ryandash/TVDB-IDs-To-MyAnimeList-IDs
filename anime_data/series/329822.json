            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "10160751",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160751",
                    "Titles": {
                        "eng": "The Strongest Principle of Growth Lies in the Human Choice.",
                        "jpn": "何かを選ぶことこそが、成長の最大の糧となる。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "10160752",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160752",
                    "Titles": {
                        "eng": "Man Is Wolf to Man.",
                        "jpn": "人にとって、他の人間は獰猛な狼のようなものだ。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "10160753",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160753",
                    "Titles": {
                        "eng": "We Never Forget What We Endeavor to Forget.",
                        "jpn": "忘れたいことほど、忘れることはできない。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "10160754",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160754",
                    "Titles": {
                        "eng": "To Work You Have the Right, but Not to the Fruits Thereof.",
                        "jpn": "あなたにできるのは自分の目的のために行動することまでで、その結果を望むようにすることはできない。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "10160755",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160755",
                    "Titles": {
                        "eng": "Fortune Favors the Bold.",
                        "jpn": "運命は勇気ある者を助ける。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "10160756",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160756",
                    "Titles": {
                        "eng": "It Is Better to Receive an Injury Than to Inflict One.",
                        "jpn": "悪を行うよりも、その悪に傷つけられる方が良い。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "10160757",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160757",
                    "Titles": {
                        "eng": "People Will Do Anything, No Matter How Absurd, in Order to Avoid Facing Their Own Souls.",
                        "jpn": "人は自らの本質と向き合うのを避けるためなら、 どんな愚かな行いにも手を染めてしまう。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "10160758",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160758",
                    "Titles": {
                        "eng": "Those Who Cannot Remember the Past Are Condemned to Repeat It.",
                        "jpn": "過去を顧みぬ者はそれを繰り返し、裁かれる。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "10160759",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160759",
                    "Titles": {
                        "eng": "Extreme Justice Is Extreme Injustice.",
                        "jpn": "最高の法は、最大の不正を生み出す。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "10160760",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160760",
                    "Titles": {
                        "eng": "The First Cause of Absurd Conclusions I Ascribe to the Want of Method.",
                        "jpn": "不条理な結論に至る第一の原因は、 解決の手段が不足していることだ。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "10160761",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160761",
                    "Titles": {
                        "eng": "There Is Only One Rule in Love Bring Happiness to Those You Love.",
                        "jpn": "愛にはたったひとつの決まりしかない。それは愛する者を幸福に導くことだ。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "10160762",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10160762",
                    "Titles": {
                        "eng": "Change Your Desires Rather Than the Order of the World.",
                        "jpn": "欲望のために世界を変えるのではなく、まず己を変えよ。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "10205506",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/classroom-of-the-elite/episodes/10205506",
                    "Titles": {
                        "eng": "Love is the best teacher.",
                        "jpn": "愛は最も良い教師である。"
                    },
                    "Aliases": []
                }
            }
        },
