            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "10150546",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10150546",
                    "Titles": {
                        "eng": "Abandoned Metal Crab",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "So began Ceobe the Storyteller her tale under the classroom's door frame on a pleasant morning: If it pleases you, lords and ladies, I'd love to tell a story about a metal crab, a mistress, and a table loaded with desserts; about how a lost soul found its way true—a design unchanged in tales of adventure both novel and antique.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "10192033",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10192033",
                    "Titles": {
                        "eng": "Bravery and Chocolates",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "What's a better place than a newly opened cafe for three young ladies to hold their salon on ideals? How else could their sweet dreams wash away the bitter taste of freshly brewed coffee? Let imagination chart the course ahead, so that the ferries of fate may follow.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "10192034",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10192034",
                    "Titles": {
                        "eng": "Dreams and Spices",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "As if it was just yesterday... After breaking into the ventilation pipe system, would the \"rogues\" find the answer they sought among intertwined fates?",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "10192035",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10192035",
                    "Titles": {
                        "eng": "The Invisible Man and Pamphlets",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Long, long ago, there was an invisible man who had a unique heart. While others of his kind had unfettered winds in theirs, his was teeming with foods and naps, as well as his expectations which we have yet to find out...",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "10204703",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10204703",
                    "Titles": {
                        "eng": "Metal Crab Mountain",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "So there he stands before us all: a tall, wide, furry figure, with a stack of leaflets in his hands. The arrival of \"Metal Crab Mountain\" thus heralds the end of the cafe's anonymous ages.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "10204704",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10204704",
                    "Titles": {
                        "eng": "Showdown",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Legends speak of an unprecedented war that took place at the source of all strawberry milkshakes and bubble sodas...",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "10210706",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10210706",
                    "Titles": {
                        "eng": "Bunny Puppet",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "This day, a grievous fate knocked at the lone invisible man's door, a fate warmer than trouble but no less vexing—a hug from a fluffy bunny, it was.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "10210707",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10210707",
                    "Titles": {
                        "eng": "The Day Papa Comes to Visit",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Bubble, the cactus devourer, the chocolate game master, the paper sword gladiator, was perplexed by the fact that everyone had been dodging her since her return... Could it also be part of the trial she had to conquer? Still, nothing could wash away the bitter taste of solitude in her mouth, not even an extra-thick milkshake.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "10215968",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10215968",
                    "Titles": {
                        "eng": "The Vanishing Homework",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "A series of bizarre dreams had visited this Perro student in her sleep before she would hand in her homework on that fateful day. Can one tell good dreams from bad ones? Hardly, as one cannot judge a future that's yet to happen. Still, what of those dreams of past shadows? What they render reality into? All these questions, the Perro would have to answer by herself.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "10215969",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10215969",
                    "Titles": {
                        "eng": "Becoming You For a Day",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "As the creation of Ceobe the Artist hit the neck bottle at a young age, Beanstalk, a Metal Crab breeder, ignited her spark of inspiration that has burned forever bright.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "10266954",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10266954",
                    "Titles": {
                        "eng": "Kay's Dream",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "The young lady ponders as her concentration divides her from the rest of the clamorous cafe. She wants to be an artist. No, not an artist, a writer would be better. Or maybe... an ordinary person who adds unordinary surprises to her ordinary life? Still, there are things she needs to take care of at present.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "10266955",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/kays-daily-doodles/episodes/10266955",
                    "Titles": {
                        "eng": "Whitewashing and Painting",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Once upon a time, there was a girl whose mind was as blank as an untainted canvas... And at the end of her journey, she found that all the colors, however majestic, need a white canvas as their base.",
                        "jpn": null
                    },
                    "Aliases": []
                }
            }
        }
