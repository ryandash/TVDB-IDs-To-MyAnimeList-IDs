        "3": {
            "ID": "1832827",
            "URL": "https://thetvdb.com/series/tv-bastard-nanana/seasons/official/3",
            "Titles": {
                "eng": "Kaibutsu Kraken wo Oe!",
                "jpn": "怪物クラーケンを追え!",
                "spa": "¡Cazando al legendario Kraken!",
                "fra": "Chase the Kraken Monster!"
            },
            "Summaries": {
                "eng": null,
                "jpn": "貧乏テレビ局「テレビナナーナ」は、少ない制作費を知恵と体力とチームワークでカバーしながら、日々ライバル局との競争に明け暮れていた。しかし、若者のテレビ離れ、広告収入の激減、さらに独自路線の番組作りも飽きられてしまい、いまだかつてない苦境に立たされてしまった。\r\n　そこで、起死回生の高視聴率番組を制作しようと、探検部のディレクター・七岡、カメラマン・七森、AD・七山の３人は伝説の怪物・クラーケンの撮影に挑むことになった。向かうは、魔の海域・バナーナ・トライアングル！3人は禁漁中のイカ釣り漁船をチャーターし、さっそく大海原へと出港した。魔の海域で彼らを待ち構えていたのは、凶暴なサメ、巨大なクジラ、恐ろしい海賊船！さらに、命からがら漂着した絶海の孤島では、奇怪なキャラクターたちが次々と出現する。\r\n　シーズン３を迎え、ますます炸裂する文原ワールド。攻めすぎてハラハラするパロディ。どんどんグダグダになるコメディ。今度こそワクワクするアドベンチャー！果たして３人は怪物クラーケンを撮影し、過酷な探検から無事に戻ってくることができるのか？！",
                "spa": null,
                "fra": null
            },
            "# Episodes": 24,
            "Episodes": {
                "1": {
                    "ID": "7679346",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7679346",
                    "Titles": {
                        "eng": "Wacky TV Ships Out!",
                        "jpn": "出港！ テレビ野郎"
                    },
                    "Summaries": {
                        "eng": "Life doesn't seem to get any easier for the TV Nanana expedition crew, as the troubles that affect all of modern TV seem to weigh extra heavily on their tiny company. With a mandate to travel to the distant Banana Triangle in order to capture footage of the legendary Kraken, it's up to Director Nanaoka, AD Nanayama, and cameraman Nanamori to survive a fierce trip across the ocean in pursuit big ratings!",
                        "jpn": "プロデューサー七口から新たな冒険番組の制作が発表された。今回のターゲットは伝説の大だこ“クラーケン”。禁漁中のイカ釣り漁船に乗り込んだ探検隊は、危険な海域“バナーナトライアングル”に向かう。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "7780923",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780923",
                    "Titles": {
                        "eng": "Voyage! On the Good Ship Cost Performance",
                        "jpn": "航海！ コスパのいい船"
                    },
                    "Summaries": {
                        "eng": "The expedition crew takes to the sea in search of the Kraken, but their ship seems a little less than comfortable, and the captain a little more than intoxicated.",
                        "jpn": "イカ釣り漁船は、安い代わりにとんでもなくオンボロな船だった。しかし、泥酔したアル中船長の予測不能な舵さばきで、サメや障害物を巧みにかわしてゆく。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "7780931",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780931",
                    "Titles": {
                        "eng": "Staying Healthy! With the Unmotivated Adventurers",
                        "jpn": "健康! やる気のない勇者たち"
                    },
                    "Summaries": {
                        "eng": "Swallowed by a whale, Nanaoka and his team encounter a long-lost TV Nanana director and his staff.",
                        "jpn": "クジラの体内で座礁してしまったイカ釣り漁船。そこでは元テレビ局のディレクターが、クジラからの脱出を諦めて優雅な生活を送っていた。クジラの中は想像以上の快適な空間だったのだ。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "7780934",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780934",
                    "Titles": {
                        "eng": "A Slice of Heaven! Blissing Out Inside a Whale",
                        "jpn": "極楽! クジラでととのう"
                    },
                    "Summaries": {
                        "eng": "After making peace with being swallowed by a massive aquatic mammal, the expedition crew decide to enjoy the spa facilities found within. But will their bliss last for long?",
                        "jpn": "ロケを放り出して、クジラの中で一日中サウナを楽しむ取材班。しかし、プロデューサー七口の顔が七岡の脳裏に浮かびあがり、鬼の形相でロケに行くよう指示される。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "7780935",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780935",
                    "Titles": {
                        "eng": "Defend With Your Lives! The Mini Golden Time Slot",
                        "jpn": "死守! ゴールデンのミニ枠"
                    },
                    "Summaries": {
                        "eng": "The expedition crew have decided to escape the whale that swallowed them. But if they want to keep their general-audiences friendly timeslot, they're going to need to avoid the... natural... way that objects that are swallowed by animals get expelled!",
                        "jpn": "クジラの体内でようやく出口を見つけるが、漁船がエンジンの不調で肛門に向かって流され始めてしまった。しかし、七岡はサウナから着想を得たある秘策を使って、クジラからの脱出を図る"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "7780936",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780936",
                    "Titles": {
                        "eng": "Super Deluxe! -5G Communications",
                        "jpn": "高級! －5Gの通信手段"
                    },
                    "Summaries": {
                        "eng": "While scouring the seas for the legendary Kraken, the TV Nanana boat has run into engine trouble! And to make matters worse, the cell phones that their workplace provided have been replaced with a more analog, and feathery, solution.",
                        "jpn": "漁船は洋上で立ち往生。さらに経費節約のあおりを受けて会社からスマホを没収されてしまったので救援が呼べない。しかし、昔ながらのある通信手段を使って、プロデューサーと連絡を取る。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "7780938",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780938",
                    "Titles": {
                        "eng": "Rescue! Sea-Sent SOS",
                        "jpn": "救援! 大海原のSOS"
                    },
                    "Summaries": {
                        "eng": "The expedition crew are adrift at sea after encountering engine trouble. They pin their hopes for rescue to messenger pigeons, who manage to bring in help... and even more trouble!",
                        "jpn": "依然としてエンジンの不調を抱える漁船。取材班はあらゆる手段を使って救援を求め、ようやく一隻の船が助けに来てくれた。しかしそれは、周辺の海域で恐れられている、大金稼ぎの海賊団の船だった。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "7780940",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tv-bastard-nanana/episodes/7780940",
                    "Titles": {
                        "eng": "Captured! Terror Aboard the Pirate Ship",
                        "jpn": "拿捕! 恐怖の海賊船"
                    },
                    "Summaries": {
                        "eng": "Nanaoka, Nanayama, and Nanamori are now hostages aboard a pirate ship. They'll be freed as long as the network pays for their ransom, but will the notoriously spendthrift TV station be willing to save the crew's lives?",
                        "jpn": "たいした身代金が期待できない小さなテレビ局は、口封じのため海に沈められることになった。必死に「キー局」ということをアピールする取材班。果たして彼らの主張は聞き入れてもらえるのか。"
                    },
                    "Aliases": []
                },
