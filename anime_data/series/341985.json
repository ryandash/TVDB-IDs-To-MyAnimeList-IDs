                "1": {
                    "ID": "6545431",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6545431",
                    "Titles": {
                        "eng": "When you lose your composure, you cannot reach the truth or reality.",
                        "jpn": "冷静さを見失うと、真実と真理にたどり着くことはできない。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "6627331",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627331",
                    "Titles": {
                        "eng": "Anxiety, irritation, and other such negative emotions spread to others.",
                        "jpn": "不安、無燥などといつた負の感情は他人を巻き込んでいく。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "6627332",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627332",
                    "Titles": {
                        "eng": "Why do we live? The further we pursue the meaning of life, the more confused we become.",
                        "jpn": "何故、生きているのか？人生について突き詰めて行けば行くほど、混乱してしまう。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "6627333",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627333",
                    "Titles": {
                        "eng": "People who do not respect themselves will not be respected by others.",
                        "jpn": "自分の存在を認めない人間は、他人からも尊敬されない。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "6627334",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627334",
                    "Titles": {
                        "eng": "Everyone gets hurt. But those who don't realize they're hurting can't be healed.",
                        "jpn": "誰でも傷つくことはある。だが、傷ついていることに気付かない者は癒やされない。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "6627335",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627335",
                    "Titles": {
                        "eng": "Looking forward doesn't equal progress on its own. Understanding one's situation is also an important step.",
                        "jpn": "前向きなだけが前進とは言えない。状況を知ることも大切な一歩だ。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "6627336",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627336",
                    "Titles": {
                        "eng": "When you're in a desperate situation, it's all the more important to keep smiling.",
                        "jpn": "絶望的な状況である時こそ、笑顔をたたえることが必要だ。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "6627337",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627337",
                    "Titles": {
                        "eng": "Your life shouldn't be built from someone else's blueprint. No matter how unskilled you may be, you should draw it yourself.",
                        "jpn": "人生とは、他人の設計図で作るものではない。どんなに稚拙でも自分で描くべきだ。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "6627338",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627338",
                    "Titles": {
                        "eng": "Even if something has already happened, you can still choose what you do.",
                        "jpn": "何かが起こってしまった後であっても、何をするかは自分で選択できる。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "6627339",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627339",
                    "Titles": {
                        "eng": "Caligula",
                        "jpn": "Caligula"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "6627340",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627340",
                    "Titles": {
                        "eng": "People constantly seek out the right answer. Yet, is being right really all that matters?",
                        "jpn": "人は常に正解を求める。だが、正しければ本当にそれでいいのか？"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "6627341",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/caligula/episodes/6627341",
                    "Titles": {
                        "eng": "Destroy your ideals and self, and return to hell and reality.",
                        "jpn": "理想(きみ)を壊して、現実(じごく)へ帰る――。"
                    },
                    "Aliases": []
                }
            }
        }
    }
