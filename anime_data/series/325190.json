                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6050393",
                    "Titles": {
                        "eng": "The Moonlit Night and the Hedgehog",
                        "jpn": "月夜とハリネズミ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "なかなかツインエンジェルとしての自覚が高まらないめぐるとすみれにしびれを切らして家出してしまうみるくちゃん。みるくちゃんがいない間に特訓する２人だが彼女たちが目指す“必殺技”は完成するのだろうか……。そして、みるくちゃんは戻ってくるのか!?"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "6050394",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6050394",
                    "Titles": {
                        "eng": "Q.E.D.! The Scientific Genius",
                        "jpn": "証明完了！ 理系の天才"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ある日突然転校してきた、フケ顔の転校生・田中勝利ことビリー。理系の天才を自称する彼の正体は、ツインエンジェルの正体を探るために敵組織からやってきた組織の幹部だった。彼独自の理論でツインエンジェルの正体を見破ったと勝ち誇るビリーだったが……!?"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "6066183",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6066183",
                    "Titles": {
                        "eng": "Yuimaru! The Field Trip to Okinawa",
                        "jpn": "ゆいまーる！ 沖縄修学旅行"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今日は聖チェリーヌ学院の修学旅行！　行き先は沖縄。テンションの上がりまくるめぐるたち一行だが、そこでアイドルグループ“トゥニエイツ”に出会いさらにテンションが上がることに！　イベントを手助けしためぐるたちはその夜のライブにも招待される。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "6066184",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6066184",
                    "Titles": {
                        "eng": "The Legendary Monster, the Black Rose Man!",
                        "jpn": "うわさの怪人・黒薔薇男！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "めぐるたちの学校のまわり出没し、被害が広がっている「黒薔薇男」を正義の味方として調査したいめぐる。中学生のひとり歩きは危険だと判断したみるくちゃんは、知り合いの長月という老人をお供に呼び寄せる。長月とめぐるのパトロールの結末は……!?"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "6066185",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6066185",
                    "Titles": {
                        "eng": "The Long-Awaited School Life! Veil's Club Visit",
                        "jpn": "念願の学院生活☆ヴェイルの部活訪問"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "沖縄で出会ったトゥニエイツのヴェイルとヌイが、なぜか聖チェリーヌ学院に転校してくることに。歓迎ムードの中ヴェイルと仲良くなっためぐるは、彼女を連れて学校の部活を紹介していく。一方、ヌイと荻野目先生の密談を聞いてしまったすみれは……!?"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "6066186",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6066186",
                    "Titles": {
                        "eng": "The Secret Revealed",
                        "jpn": "暴かれるひみつ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ヴェイルとの親交を深めていくめぐるだったが、ヌイとすみれはお互いの正体に気づき始め、警戒を強めていく。ヌイはヴェイルに理由は言えないがめぐるとは仲良くするなと伝えるのだが、納得の行かないヴェイルはその話をめぐるに伝えてしまう。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "6107207",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6107207",
                    "Titles": {
                        "eng": "Ideals, Reality, and Litmus Paper",
                        "jpn": "理想とリアルとリトマス紙"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "めぐるに体の秘密を知られ、落ち込むヴェイル。だが、そんな事を気にせずにヴェイルを訪ねてきためぐるに対してさらに友情を感じてしまう。戦うことに戸惑いと嫌気のさしたヴェイルはヌイと話し、メアリに組織から抜けたいと告げる。そこでメアリはとある提案をするのだが……。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "6107208",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6107208",
                    "Titles": {
                        "eng": "The Collapse of a Heart",
                        "jpn": "瓦解する心"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ヌイとヴェイルとの戦いの結果を受け入れられず、落ち込むめぐる。そんなめぐるの心の傷をえぐるように近づいてくるメアリ。居所がわからないめぐるを懸命に探すすみれは、長月やみるくちゃんに連れられて神無月家の当主と出会うことになる。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "6107209",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6107209",
                    "Titles": {
                        "eng": "Friends",
                        "jpn": "ともだち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "めぐるが故郷のチイチ島にいることがわかったすみれとみるくちゃんは島に急行する。パワーアップしたメダルの力により、大きな力を手にしたメアリと戦うすみれだが、めぐるは捉えられ不利な状況は続く。果たしてすみれとみるくちゃんに勝ち目はあるのか!?"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "6107211",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/twin-angel-break/episodes/6107211",
                    "Titles": {
                        "eng": "The Outcome of Fate! Because I Want to See Everyone Smile",
                        "jpn": "運命のゆくえ！　みんなの笑顔が見たいから"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "めぐるの力を利用して力を強め続けるメアリ。そんな中、窮地を脱する鍵を探し続けるすみれとみるくちゃん。果たしてツインエンジェルBREAK2人の運命は!?　物語のクライマックスを見逃すな!!"
                    },
                    "Aliases": []
                }
            }
