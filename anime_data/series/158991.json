        "1": {
            "ID": "236141",
            "URL": "https://thetvdb.com/series/space-pirate-mito/seasons/official/1",
            "Titles": {
                "eng": null,
                "jpn": "宇宙海賊ミトの大冒険"
            },
            "Summaries": {
                "eng": null,
                "jpn": "天野原町に住む中学生の少年・光国葵は、母・美都と1年ぶりに父親の墓参りに行く。ところが、その最中に銀河パトロール局員の年賀睦月・正月の姉弟が乱入して美都に襲い掛かる。なんとか年賀姉弟を退けるが、美都の身体の中から小学生くらいの少女が現れる。実は彼女は、宇宙を股にかける海賊のキャプテン・ミトだったのだ。"
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "2121801",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121801",
                    "Titles": {
                        "eng": "I am Mito!",
                        "jpn": "あたしがミトよ！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "天野原町に住む中学生・光国葵は、アメリカから帰ってくるはずの母親、美都を駅で待っていた。その頃、木星付近には銀河パトロールを相手に大暴れしている海賊船・チュウナゴンの姿が……。その艦長の名は葵の母と同じミト。そう、なぁ〜んとどう見ても10歳位にしか見えない女の子こそ、葵の母親の真の姿だったのだぁ〜！"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "2121811",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121811",
                    "Titles": {
                        "eng": "Call Me Mom",
                        "jpn": "母さんと呼んで！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "なんと葵の母は、宇宙人で子供で宇宙海賊だった!? ショックのあまり失神してしまう葵。一方、クラスにはかわいい女の子が転校してきた。と・こ・ろ・が、年賀睦月と名乗るその娘の正体は銀河パトロール局員だったのだあ！ その上、授業参観を理由にミトまで学校にきてしまった!! どうなる葵の学園生活!?"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "2121821",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121821",
                    "Titles": {
                        "eng": "Sabu and Shin!",
                        "jpn": "サブとシン！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "葵に接近してミトの情報を得ようとする睦月。だが睦月の優しさ（軟弱さ？）にどうも調子が変。ま・ま・まさか、これは恋の予感?! 一方、サブとシンは、葵の軟弱さ加減に呆れ果て、真の力を試すべく葵を宇宙に連れ出す。そこへ年賀兄弟の追跡が!! 葵はヘナチョコなまま、宇宙のもくずと消えるのか?!"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "2121831",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121831",
                    "Titles": {
                        "eng": "Trouble at the Firefly Festival!",
                        "jpn": "大変な蛍祭り！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今日は、天野原の蛍祭り。母子の関係も曖昧なままに、ミトを残し祭りに出かけた葵。そこで葵は、偶然を装い近づいてきた睦月にばったりとご対面！ 照れ会う2人をよそに華風子、美都、そして正月らが加わり祭りは大騒動に!!"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "2121841",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121841",
                    "Titles": {
                        "eng": "Romance Starts With A Blush?",
                        "jpn": "なれそめで頬染め？の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "えっ！父さんとの出会い!? それは葵にとって初めて聞かされる男と女の話……。かつて父がそうしたように葵は、睦月を誘い蛍舞う川のほとりで笹舟を流す……。揺れ動く睦月の心！ これが恋なのか？それとも……!?"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "2121851",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121851",
                    "Titles": {
                        "eng": "Love Gone Astray?",
                        "jpn": "はぐれる恋心？の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「光国葵はミトのスパイだ！」正月の言葉とは裏腹に、葵への想いに揺れ動かされる睦月。自分の気持ちに整理をつけられないまま戦いの火蓋は切り落とされ、正月の放ったビームが葵を直撃ーっ!!?? どうする睦月!?"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "2121861",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121861",
                    "Titles": {
                        "eng": "Inviting Disaster!",
                        "jpn": "招かれた災厄！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "かつて爛磐と会ったことがあるなんて……!? 爛磐艦隊につかまった葵は幼い日のとんでもない記憶を思い出す。逃げ出そうとした葵の手が偶然にも爛磐のマスクをはじきとばしたーっ!! そっそこには驚くべき真実が……!?"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "2121871",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121871",
                    "Titles": {
                        "eng": "Broken Heart!",
                        "jpn": "破られた心！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "捕まえた葵をたてに、印篭を渡せとミトに迫る爛磐。ミトは葵のブレスレットを渡そうとするが、そこに睦月が乱入する。隙を見て葵を助けようとするミトだが、葵はミトと爛磐との戦いを目の当たりにして愕然とする。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "2121881",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121881",
                    "Titles": {
                        "eng": "Ranban and Mito!",
                        "jpn": "爛盤とミト！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "爛磐に捕らえられたミトを救出すべく動き出した双房。一方、ダイナゴンでは爛磐とミトが昔語りをしていた。やがて意外なことに爛磐はミトの地球行きを許可する。地球で葵と再会したミトは……。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "2121891",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121891",
                    "Titles": {
                        "eng": "Disaster Revisited!",
                        "jpn": "禍再び！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "自らの手で母を傷つけてしまった葵。そして彼は、「光国葵は冷血宇宙人だっ」という正月の言葉でついに逃げ場を失ってしまう。だが、しかーし。大久保都＆瀬賀たちクラスメイトは立ち上がったのだ。絶体絶命のピンチから葵を救う奇想天外な作戦開始――!!"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "2121901",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121901",
                    "Titles": {
                        "eng": "Fear and Power!",
                        "jpn": "怖れと力！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ミトとの再会を果たした葵。だが、それは母にあらず、宿敵・爛磐だった！ とらわれの身となった葵は爛磐の過酷なまでの仕打ちに大ピンチ！「どうだ、ミト！お前のものは全て奪ってやったぞ!!」"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "2121911",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121911",
                    "Titles": {
                        "eng": "Our Seal!",
                        "jpn": "我が印籠！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついに始まったミトと爛磐の一騎打ち。だが、爛磐の力の秘密を知るミトは、非情になりきれず圧倒される。銀河の覇権を握るのは、やはり爛磐なのか!? それとも…！"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "2121921",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2121921",
                    "Titles": {
                        "eng": "Pillage! Grand Finale!",
                        "jpn": "略奪せよ。大団円！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "この銀河を救い、爛磐をやっつけるには“伝家の砲塔”しかない――。だが、葵には、それを発動させるのに決定的に欠けているものがあった。そっそれは一体何なのか!? そして待ち受けるとんでもないクライマックス!! あ〜っ僕を探さないで!!"
                    },
                    "Aliases": []
                }
            }
        },
        "2": {
            "ID": "307011",
            "URL": "https://thetvdb.com/series/space-pirate-mito/seasons/official/2",
            "Titles": {
                "eng": null,
                "jpn": "宇宙海賊ミトの大冒険 2人の女王様"
            },
            "Summaries": {
                "eng": null,
                "jpn": "前作で、天野原町の危機を救ったミトと葵。しかし、葵の身体が女になってしまい、彼が銀河星王家の王位継承者だったことも判明したことから、銀河星王家の女王と女子高生を掛け持つ日々を送りつつも、平穏な日々が過ぎていた天野原町。そんなある日、葵の地位を狙って、銀河星王家初代女王・陽怒が現れ、宇宙規模のバトルが巻き起こる。"
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "2735311",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735311",
                    "Titles": {
                        "eng": "The Queen Has Risen",
                        "jpn": "女王の目醒め！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "爛磐から天野原町の危機を救ったミトと葵たち。しかぁし、葵の姿は胸が膨らみオンナノコへと変化してしまった。女子高生になった葵、小学校に入学したミト（？）。平穏な日々が過ぎていた天野原町に葵の地位を狙って銀河星王家初代女王を名乗る陽怒（ヒカリ）が現れて、ま〜たまた壮絶なるバトルの気配がっ!!"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "2735321",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735321",
                    "Titles": {
                        "eng": "The Fake Fog",
                        "jpn": "偽りの濃霧？の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "女王と側近の立場になり、あくまで臣下として振る舞う睦月に対し寂しさを感じる葵。そんな中、みんなで裏山へきもだめしに行くことに…。しかし怪しい霧がたちこめ道に迷ってしまった!!そこに襲い来る山伏軍団!!　責任感の強い睦月は、葵を守ろうと奮闘するが…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "2735331",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735331",
                    "Titles": {
                        "eng": "Mutsuki's Wishes",
                        "jpn": "睦月の想い！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "真実を知るため、睦月の身を案じ、一人で裏山へ足を運ぶ葵。しかし、再び山伏軍団に襲われ、危ないところでミトたちに助けられる。葵を守ることに必死な睦月は葵に信用されてないのかと、すっかり自信を失うことに…。２人の気持ちがすれ違う中、初代女王陽怒が姿を現し、戦いの火蓋は切り落とされた!"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "2735361",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735361",
                    "Titles": {
                        "eng": "Tears and Flower Petals",
                        "jpn": "涙と花弁！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "葵を守れなかったことですっかり自信を無くし、警護役を辞めたいと申し出る睦月。しかし、それは睦月にとって自分を一から鍛え直すのに必要な時間だった。一人で黙々と特訓に励む睦月と、その間警護が手薄になった葵に、陽怒と山伏軍団の魔の手が襲いかかる!!"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "2735371",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735371",
                    "Titles": {
                        "eng": "The Galactic War Begins",
                        "jpn": "始まった宇宙戦争！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "陽怒の宣戦布告を受けた葵は、捕まってしまった睦月を助けるため、攻撃を開始する!!しかし、陽怒の神殿はびくともしない！睦月を救い出すことに必死な葵は、ミト達が止める中、正月の力を借りて一人っきりで陽怒の神殿に乗り込む!!"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "2735381",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735381",
                    "Titles": {
                        "eng": "Suffering and Joy",
                        "jpn": "苦悩と微笑！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "睦月を救うため、陽怒の神殿にやってきた葵。しかし、陽怒によっていたぶられる睦月を見ていられない。苦悩の果てに葵は、ついに大納言を陽怒に渡すことを決意する。三種の神器の２つ目「剣」を手に入れた陽怒は、地球を破壊するべく、その剣を振り下ろす！"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "2735391",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735391",
                    "Titles": {
                        "eng": "Love and War",
                        "jpn": "闘争と懸想？の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "陽怒の手により占領されてしまった天野原町。町のみんなは陽怒から逃れるため、ランバンの張った結界に避難していた。だが、肝心の葵は陽怒の強さに、ただ自信を失っているだけ。しかし、ランバンの激が葵を奮い立たせた!!「陽怒を倒せるのはお前しかいない！」睦月たちを助けるため、葵の猛特訓が始まった!!"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "2735401",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735401",
                    "Titles": {
                        "eng": "The Lonely Queen",
                        "jpn": "独りの女王様！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "町のみんなを助けようと、爛磐の厳しい特訓に耐える葵。だが、陽怒の発した“アキツ”という言葉が妙に気になり集中できない。天野原町解放戦線と山伏軍団の激闘が続く中、不利を承知で最後の神器を探しに宇宙へ出るミト。陽怒はミト不在の機を狙い、葵を孤立させようと、葵の仲間達を自らの下僕へと変えていく！"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "2735411",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735411",
                    "Titles": {
                        "eng": "Distress",
                        "jpn": "降りかかる苦難！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "葵を守るため、次々と陽怒の下僕とされていく仲間たち。辛い現実に耐えながらも葵は、決して希望は捨てず爛磐との特訓に励む。一方陽怒は、葵が、唯一愛した“アキツ”の生まれ変わりだと確信し、葵に“アキツ”の記憶を呼び覚まそうとするが…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "2735421",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735421",
                    "Titles": {
                        "eng": "Everyone With Mito!",
                        "jpn": "みんなと、ミトと！の巻"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついに陽怒との戦いが始まった！だが、操られた仲間たちが敵のため、なかなか攻め入れない葵。大納言を取り戻し、町のみんなを解放するべく、ミトと葵は一計を案じる。二手に分かれて陽怒の陣地へ乗り込んだのだ！しかし、その行く手には陽怒の罠が待っていた！"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "2735431",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-pirate-mito/episodes/2735431",
                    "Titles": {
                        "eng": "The Last Promise",
                        "jpn": "最後の誓い！の巻"
                    },
                    "Summaries": {
                        "eng": "",
