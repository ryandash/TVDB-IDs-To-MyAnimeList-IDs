        "1": {
            "ID": "1888530",
            "URL": "https://thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/seasons/official/1",
            "Titles": {
                "eng": null,
                "jpn": null,
                "pt": null,
                "rus": null
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "pt": "Antes de ser eliminada pelos deuses, a humanidade tem uma última chance de provar que merece viver. Que comecem as batalhas do Ragnarok!",
                "rus": "Прежде чем быть уничтоженным богами, у человечества есть последний шанс доказать, что он заслуживает жизни. Пусть начнутся сражения Рагнарока!"
            },
            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "8115009",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8115009",
                    "Titles": {
                        "eng": "Ragnarok",
                        "jpn": "ラグナロク"
                    },
                    "Summaries": {
                        "eng": "At the Council of Valhalla, the gods vote unanimously for humankind's extinction. But Brünnhilde, eldest of the Valkyrie sisters, raises her objection.",
                        "jpn": "ヴァルハラ評議会では、神々が全会一致で人類の絶滅に投票します。 しかし、ヴァルキリー姉妹の長男であるブリュンヒルデは、彼女の異議を唱えています。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "8481724",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481724",
                    "Titles": {
                        "eng": "Worthy Opponent",
                        "jpn": "好敵手"
                    },
                    "Summaries": {
                        "eng": "In the first round of the Ragnarok battle, Han dynasty warlord Lü Bu puts up a good fight against Norse god Thor, surprising the gods in attendance.",
                        "jpn": "ラグナロクの戦いの最初のラウンドでは、漢王朝の武将呂布が北欧神話のトールとの良い戦いを繰り広げ、出席している神々を驚かせました。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "8481725",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481725",
                    "Titles": {
                        "eng": "Killer Move",
                        "jpn": "必殺技"
                    },
                    "Summaries": {
                        "eng": "To give Lü Bu the upper hand against Thor, Brünnhilde summons her sister Randgriz and asks her to transform into a sacred weapon — the Shield Breaker.",
                        "jpn": "呂布がトールに対して優位に立つために、ブリュンヒルデは妹のランドグリズを召喚し、聖なる武器であるシールドブレイカーに変身するように頼みます。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "8481726",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481726",
                    "Titles": {
                        "eng": "Joy",
                        "jpn": "歓喜"
                    },
                    "Summaries": {
                        "eng": "Lü Bu’s legs are crushed by the mighty Geirröd Thor's Hammer attack, but just when all hope seems lost, the warlord’s trusty horse Red Hare rides in.",
                        "jpn": "呂布の足は強力なゲイルロズトールのハンマー攻撃によって押しつぶされますが、すべての希望が失われたように見えるとき、武将の信頼できる馬赤兎馬が乗り込みます。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "8481727",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481727",
                    "Titles": {
                        "eng": "FILE No.00000000001",
                        "jpn": "ファイルNo.00000000001"
                    },
                    "Summaries": {
                        "eng": "Chosen for the next round is the father of humankind and the man bearing more hatred towards the gods than anyone else: Adam himself.",
                        "jpn": "次のラウンドのために選ばれたのは、人類の父であり、他の誰よりも神々に対してより多くの憎しみを抱いている男、アダム自身です。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "8481728",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481728",
                    "Titles": {
                        "eng": "Great Emulation",
                        "jpn": "華麗なる模倣"
                    },
                    "Summaries": {
                        "eng": "Zeus insists on going up against Adam, who joins forces with Valkyrie Reginleif to obtain a most peculiar weapon: a knuckleduster.",
                        "jpn": "ゼウスは、ヴァルキリー・レギンレイフと力を合わせて最も独特な武器であるナックルダスターを手に入れるアダムに立ち向かうことを主張します。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "8481729",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481729",
                    "Titles": {
                        "eng": "Expelled from Paradise",
                        "jpn": "楽園追放"
                    },
                    "Summaries": {
                        "eng": "Just when it looks like Adam will earn humankind the victory they long for, Zeus gathers his strength to ask Adam why he's really fighting.",
                        "jpn": "アダムが人類に彼らが切望する勝利を得るように見えるちょうどその時、ゼウスは彼が本当に戦っている理由をアダムに尋ねるために彼の力を集めます。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "8481730",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481730",
                    "Titles": {
                        "eng": "Grace Abounding",
                        "jpn": "あふれる愛"
                    },
                    "Summaries": {
                        "eng": "Zeus has transformed into his final most powerful form, but after the beating he's suffered, he may not last much longer in the fight.",
                        "jpn": "ゼウスは彼の最後の最も強力な形に変身しました、しかし彼が苦しんだ殴打の後、彼は戦いでそれほど長くは続かないかもしれません。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "8481731",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481731",
                    "Titles": {
                        "eng": "Tyrant of the Ocean",
                        "jpn": "大海の暴君"
                    },
                    "Summaries": {
                        "eng": "Humankind is desperate to win the next bout, but the god they're going up against is one of the mightiest of them all: Poseidon",
                        "jpn": "人類は次の試合に勝つために必死ですが、彼らが立ち向かう神はそれらすべての中で最も強力なものの1つです：ポセイドン"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "8481732",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481732",
                    "Titles": {
                        "eng": "Greatest Loser",
                        "jpn": "最強の敗者"
                    },
                    "Summaries": {
                        "eng": "Kojiro Sasaki uses his mighty Tsubame Gaeshi move to finish off Poseidon, but the god of the sea won't be sunk so easily.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "8481733",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481733",
                    "Titles": {
                        "eng": "The Swallow Gazes into the Abyss",
                        "jpn": "燕が見た深淵"
                    },
                    "Summaries": {
                        "eng": "Through the power of Valkyrie Hrist, Kojiro's broken blade is transformed into dual swords, allowing him to tap into the depths of his inner strength.",
                        "jpn": "ヴァルキリー・フリストの力で、小次郎の折れた刃は二刀流に変身し、内なる力の奥底を掴むことができる。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "8481734",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/episodes/8481734",
                    "Titles": {
                        "eng": "And Ragnarok Goes On",
                        "jpn": "そしてラグナロクはつづく"
                    },
                    "Summaries": {
                        "eng": "Despite Kojiro's Niten Ganryu duel blade method, Poseidon's powerful attacks continue to wear him down. But the battle isn't over yet.",
                        "jpn": "小次郎の二天がん竜決闘刃法にもかかわらず、ポセイドンの強力な攻撃は彼を疲れさせ続けています。 しかし、戦いはまだ終わっていません。"
                    },
                    "Aliases": []
                }
            }
        },
        "2": {
            "ID": "2006185",
            "URL": "https://thetvdb.com/series/shuumatsu-no-valkyrie-record-of-ragnarok/seasons/official/2",
