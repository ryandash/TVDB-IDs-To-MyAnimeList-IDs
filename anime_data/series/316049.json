                    "Titles": {
                        "eng": "Twilight",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Trapped on the roof, Sonshin has nowhere to run against Chou-sensei. He's forced to fight, but his spiritual power is weak. He attempts to surrender to spare Shuuyu any further pain, but as her armor glints in the setting sun, it seems he has another plan in mind...",
                        "jpn": null
                    },
                    "Aliases": []
