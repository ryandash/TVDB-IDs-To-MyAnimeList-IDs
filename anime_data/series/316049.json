                    "Titles": {
                        "eng": "Enlightenment",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Chou-sensei continues to pursue Shuuyu and Sonshin throughout the school. Sonshin lacks the spiritual power needed to fully use Shuuyu's abilities, so he has no choice but to flee. The situation grows even more dire when the two of them are trapped on the roof, and Gien destroys the fire escapes, leaving them nowhere to run...",
                        "jpn": null
