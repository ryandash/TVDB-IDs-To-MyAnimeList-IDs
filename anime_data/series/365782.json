        "3": {
            "ID": "1998583",
            "URL": "https://thetvdb.com/series/martial-universe-animation/seasons/official/3",
            "Titles": {
                "eng": null,
                "jpn": null,
                "zho": "第三季"
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "zho": "为了变强在之后的族比中击败林琅天，林动小貂和小炎一同踏上修行之路，一路上惊险不断。在小貂的指引下林动最终来到大荒古碑，成功获得了吞噬祖符的线索，并且在林琅天和众多强者的角逐下成功获得造化武学，大荒囚天指！"
            },
