            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "5440383",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5440383",
                    "Titles": {
                        "eng": "A Visceral Allegory of Seven Years of My Artistic Life",
                        "jpn": "私の芸術的人生の7年間を要約する現実的寓意"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今まで散々石膏デッサンをさせられてきた美大生・石本美希は石膏像に嫌気が差し、石膏像や美術とは全く関係のない芸能事務所に就職する。しかし、石本美希は入社初日から新人アイドルユニットのマネージャー担当に！"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "5466226",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5466226",
                    "Titles": {
                        "eng": "What Are We? Where Are We Going? Where Do We Come From?",
                        "jpn": "我々はどこから来たのか、我々は何者か、我々はどこへ行くのか"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "石膏像の新人アイドルユニット『石膏ボーイズ』の担当マネージャーに抜擢された石本美希の初仕事は、石膏ボーイズをテレビ局に連れて行くこと。何とかテレビ局に辿り着くが、石膏ボーイズの不満は募る一方で――。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "5466227",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5466227",
                    "Titles": {
                        "eng": "Giuliano de' Medici, Duke of Nemours",
                        "jpn": "ヌムール公ジュリアーノ・デ・メディチ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついに石膏ボーイズにドラマ出演のオファーが来た！ しかし、オファーがあったのはお金持ちで苦労知らずのメディチだけ。マネージャーである石本美希はメンバーの仲に亀裂が入らないようにフォローしようとするが…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "5480031",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480031",
                    "Titles": {
                        "eng": "St. Giorgius, Disposer of Dragons",
                        "jpn": "竜を退治する聖ゲオルギウス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "石膏ボーイズの知名度が少しずつ上がってきた中、CDショップでイベントが行われることが決定。リーダーの聖ジョルジョは勇み登壇する。イベントは成功に終わるかと思いきや、得意の“聖人ギャグ”を披露し始めて。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "5480032",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480032",
                    "Titles": {
                        "eng": "Minerva Protecting Peace from Mars",
                        "jpn": "マルスから平和を守るミネルヴァ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "国民的トーク番組『節子のやーへー』に出演することになった石膏ボーイズ。節子さんに太刀打ちできるのは誰？ 白羽の矢が立ったのは軍神マルス。彼なら強引な力技で節子さんのボケもツッコミも切り抜けられるはず！"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "5480033",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480033",
                    "Titles": {
                        "eng": "Primavera",
                        "jpn": "プリマヴェーラ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "石膏ボーイズの中でも一番人当たりがよいヘルメス。しかし、ヘルメスの私生活は謎につつまれており、どこに住んでいるのかさえ誰も知らなかった。石本美希はメディチを連れてヘルメスの私生活を探りに向かう。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "5480034",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480034",
                    "Titles": {
                        "eng": "Civil War Brewing",
                        "jpn": "内乱の予感"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "往年の人気アイドルデュオ『ダンディ2メン』のディナーショーに行くことになった石膏ボーイズ。石膏ボーイズは大興奮。白熱し過ぎて言い争いが始まってしまう。ディナーショー前だというのに何だか不穏な空気に。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "5480035",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480035",
                    "Titles": {
                        "eng": "Allegory of Music and Prudence",
                        "jpn": "音楽と分別の寓意"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "生放送音楽番組『ミュージックスタジオ』の出演が決まった石膏ボーイズ。しかし、晴れの舞台にも関わらず調子に乗っていた。台本は読まずリハーサルもすっぽかす、と完全に気が抜けている。そんな中収録が始まって。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "5480036",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480036",
                    "Titles": {
                        "eng": "The Forge of Vulcan",
                        "jpn": "ウルカヌスの鍛冶場"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "人気音楽番組に出演できた石膏ボーイズ。人気も上昇気流に乗り始めた時、マルスが人気アイドルと自宅デートしている所をパパラッチされてしまう。どうやってスキャンダルから逃れるべきか、石本は頭を悩ませる。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "5480037",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480037",
                    "Titles": {
                        "eng": "The Weeping Woman",
                        "jpn": "泣く女"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "『We Are Boys』でデビューした石膏ボーイズ。しかし、この曲はダサいからウケたという衝撃的な事実が判明。イメージの違う新曲を作ることを決意した石本は、音楽プロデューサーを見つけようと駆け回る。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "5480038",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480038",
                    "Titles": {
                        "eng": "The Return of the Prodigal Son",
                        "jpn": "放蕩息子の帰宅"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "マネージャーとして頑張ってきた石本。しかし、評価されないことにショックを受け、実家に帰ってしまう。石膏ボーイズは石本に戻ってもらおうと連絡を取るが、石膏だから動くことができない。どうする石膏ボーイズ！"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "5480039",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sekko-boys/episodes/5480039",
                    "Titles": {
                        "eng": "The Last Judgment",
                        "jpn": "最後の審判"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "石本がマネージャーに復帰した直後メディチが誘拐された。そんな中、音楽プロデューサーからライブに出演して欲しい連絡が入る。ライブまでにメディチを見つけ出さなければ。最大の危機とチャンスが一度に訪れた！"
                    },
                    "Aliases": []
                }
            }
        }
    }
}