            "# Episodes": 5,
            "Episodes": {
                "1": {
                    "ID": "11418212",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/hatokakuteru-karahuru/episodes/11418212",
                    "Titles": {
                        "eng": "Stone Letter",
                        "jpn": "ストーン・レター"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "恋愛で有頂天になっているころに、突然転勤になった新聞記者の慎二。　月に一度のデートを楽しみにしていたが、新型コロナ感染流行で会うことが叶わなくなる。そんなある日、彼女から分厚い手紙が届き、中には小石が入っていた！その石に込められた思いとは？"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "11418213",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/hatokakuteru-karahuru/episodes/11418213",
                    "Titles": {
                        "eng": "The Planet Beneath Our Feet",
                        "jpn": "この星の上"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "介護士として働く、シングルマザーの楓。仕事と子育ての両立はハードだが、高校時代に天文部でともに過ごした裕介が心の支えになっている。ある日、裕介が働く楓を公園で見かけ、電話をかけてくる…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "11418214",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/hatokakuteru-karahuru/episodes/11418214",
                    "Titles": {
                        "eng": "Tandem Venus",
                        "jpn": "タンデム・ヴィーナス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "職場の上司・時任紗矢にほのかな憧れを抱いている「ボク」。しかしあるとき、紗矢が女性と仲よくバイクに乗ってデートしている姿を目撃してしまう。思いはつのるばかりだが打ち明けられないでいるうちに、紗矢は西日本の支社へ異動してしまい…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "11418215",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/hatokakuteru-karahuru/episodes/11418215",
                    "Titles": {
                        "eng": "Gentle Rain",
                        "jpn": "ジェントル・レイン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "やさしく雨が降る、春の夜。とあるバーに、若い女性と年配男性のカップルが訪れた。まもなく結婚するという２人は店主に“あるもの”を差し出し、話を切り出す。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "11418216",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/hatokakuteru-karahuru/episodes/11418216",
                    "Titles": {
                        "eng": "The Beauty Who Turned Around",
                        "jpn": "見返り美人"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "コロナ禍も落ち着いた春。グループ会社の研修会で、久しぶりに同僚の静華と対面した「ボク」。美しい富士山をバックに振り返った静華に、一瞬で恋に落ちてしまう。しかし静華には、ほかに付き合っている人がいて…。"
                    },
                    "Aliases": []
                }
            }
        },
