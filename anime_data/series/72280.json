                "11": {
                    "ID": "79802",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/corrector-yui/episodes/79802",
                    "Titles": {
                        "eng": "Heart Thumping Double-Date Part One",
                        "jpn": "わくわく♡ダブルデート"
                    },
                    "Summaries": {
                        "eng": "When Yui's dad asks her and some friends to test his company's latest VR, \"\"Marine Adventure Land,\"\" Yui is thrilled. But not all of Yui's friends are free, so double-dates (Yui and Shun, Haruna and Takashi) are arranged. The new game uses recordings of real whale songs to make people serene and happy... something Grosser's not about to let happen!",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "79803",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/corrector-yui/episodes/79803",
                    "Titles": {
                        "eng": "Heart-Thumping Double Date Part Two",
                        "jpn": "どきどき♡ダブルデート"
                    },
                    "Summaries": {
                        "eng": "Yui and Haruna's double-date is ruined when Grosser's Corruptors come to Marine Adventure Land. All seems lost... but then Yui meets two new components of Professor Inukai's software. Can Corrector Yui---with the help of Peace, and Follow---manage to protect Marine Adventure Land from an attack by Grosser himself?",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "79804",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/corrector-yui/episodes/79804",
                    "Titles": {
                        "eng": "Secrets Of The Eight Software",
                        "jpn": "8つのソフトの謎"
                    },
                    "Summaries": {
                        "eng": "It's an exciting, guided tour inside the world of Corrector Yui...lead by Yui herself! Look back on how Yui and IR first met, and at their adventures to date. Features a closer look at Corrector Yui's various Element Suits--- and also at the abilities of the Corrector Software's programs, and their fight against the evil supercomputer Grosser and his henchmen!",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "79805",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/corrector-yui/episodes/79805",
                    "Titles": {
                        "eng": "Showdown at Western Net",
                        "jpn": "ウェスタンネットの決闘"
                    },
                    "Summaries": {
                        "eng": "There's trouble at Western Net! The Corruptors have taken over Western Town...but, this time, something's different---the usually selfish, self-serving Corruptors are working as one! Can Yui convince Control, leader of the Correctors, to work with her and the other Correctors to fight off the combined power of Grosser's minions?",
                        "jpn": ""
                    },
                    "Aliases": []
                },
