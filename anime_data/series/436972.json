        "2": {
            "ID": "2109759",
            "URL": "https://thetvdb.com/series/agate/seasons/official/2",
            "Titles": {
                "eng": null,
                "jpn": null,
                "zho": null
            },
            "Summaries": {
                "eng": "The suddenly awakening ghost power leads to a conflict between Alois and the five ghosts that have been lingering in Agate's house. It turns out that these ghosts were all Agate's friends before death. The two sides have a negotiation at Agate's family graveyard. Alois wants all ghosts to go to the Hell Valley for reincarnation, but all ghosts want to find out the cause of Agate's suffering. In order not to hurt Agate any more, all ghosts decide to leave. They share their memories with Alois before leaving, hoping that he could find some clues. After seeing the memories of a woman called A Zhu, another child called Lv collapses, and Alois feels very weak and also the urgency.",
                "jpn": null,
                "zho": "地狱谷不知为何被水填满，水压过大挤破了岩层，让生活在地下世界的鬼族损失惨重。王子阿洛伊斯潜入地狱湖底探查，发现灾难的源头竟来自半个魔女脑袋的眼泪。为了将乱丢脑袋的魔女绳之以法，阿洛伊斯向地面出发了……"
            },
