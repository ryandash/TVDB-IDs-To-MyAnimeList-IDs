                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "9271346",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271346",
                    "Titles": {
                        "eng": "First Day at School",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng puts Kung Fu Sock up in her home for the night and takes him to school the next morning, hoping to show that school is fun. Eager to fulfill his mission, Kung Fu Sock sneaks away to look for Kwei again.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "9271347",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271347",
                    "Titles": {
                        "eng": "Dragonface",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng accidentally finds a cave under an old manhole cover. In the cave she finds an ancient temple and a cute baby dragon! She decides to call it 'Dragonface.'",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "9271348",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271348",
                    "Titles": {
                        "eng": "Home Not So Alone",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng gets up late and hurries to school. In the rush, she mistakes a normal sock for Kung Fu Sock and leaves the real Kung Fu Sock in her room. Before Kung Fu Sock can enjoy some time alone, he's put into a laundry basket and ends up on his own adventure.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "9271349",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271349",
                    "Titles": {
                        "eng": "Rainbow Cat",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng is going to Rainbow Cat Park with her best friend, Min. Tee Zeng plans to ask Min to join them in finding and fighting Kwei, but Kung Fu Sock doesn't approve.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "9271350",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271350",
                    "Titles": {
                        "eng": "Fishing",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng and Min plan to go to a seafood restaurant but can't find a coupon. Instead, they find an old fishing pole. To get some free seafood, Tee Zeng decides that they should go on a fishing trip.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "9271351",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271351",
                    "Titles": {
                        "eng": "Bun House Mystery",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "There's one thing that Tee Zeng can't live without: spicy buns from the local bun house. But the bun house is closed because their secret ingredient has gone missing! Tee Zeng decides this is a perfect opportunity for her to become a real detective.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "9271352",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271352",
                    "Titles": {
                        "eng": "Old Comb",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Min has a nice comb that's made of precious old wood, but Tee Zeng accidently breaks it in two. Kung Fu Sock tells Tee Zeng to come clean, but she worries it might hurt their friendship, so she decides to hide it from Min and make her a new comb.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "9271353",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271353",
                    "Titles": {
                        "eng": "Daddy's Gift",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "When Tee Zeng gets to school she's happy to receive a gift sent by her dad, but her happiness soon turns to sorrow because what she really wants is to spend more time with her dad.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "9271354",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271354",
                    "Titles": {
                        "eng": "Wishing Well",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng is upset when her mum doesn't buy her a new Rainbow Cat plush. When Tee Zeng complains to Min while next to an ancient well, a brand-new Rainbow Cat plush appears right in front of Tee Zeng, just as she wanted.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "9271355",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271355",
                    "Titles": {
                        "eng": "Relaxation With Tee Zeng",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Kung Fu Sock is stressed out by the mission to find Kwei and has nightmares every day. A worried Tee Zeng replaces the scroll with a fake one that doesn't light up and plans a day of fun for Kung Fu Sock to take his mind off things.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "9271356",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271356",
                    "Titles": {
                        "eng": "Manipulens: Part 1",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "On the same day that Kung Fu Sock comes to Starry Island, Manipulens, aka evil star Hierarch, arrives too. He's also turned into an object: a pair of sunglasses on a shelf in a beach shop.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "9271357",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271357",
                    "Titles": {
                        "eng": "Manipulens: Part 2",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Having controlled the beach shop owner, Manipulens sets out to find Tee Zeng, who has the scroll. He gives out sunglasses for free, through which he can control anyone who wears them. In the meantime, Tee Zeng, Kung Fu Sock and Min hang out at the beach.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "9271358",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271358",
                    "Titles": {
                        "eng": "Master and Student",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Manipulens looks for ways to break the scroll's seal in order to obtain Kwei's power. Min figures out that Manipulens must be hiding in a deserted cable car station where seagulls live.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "9271359",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271359",
                    "Titles": {
                        "eng": "Sword Hero's Arrival",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "It's all over the news that Sword Hero of the nearby island has saved a ship. This catches Kung Fu Sock's attention, and he wants to meet the superhero.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "9271360",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271360",
                    "Titles": {
                        "eng": "New Classmate",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "At school, Tee Zeng is surprised to see that Hiro Hao has transferred to her class! Tee Zeng is appointed Hiro Hao's buddy to help him adapt to the new environment. Meanwhile, Manipulens is searching for Kung Fu Girl.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "9271361",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271361",
                    "Titles": {
                        "eng": "Kung Fu Girl's Show",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Kung Fu Girl's story is adapted into a play. All the girls in school come to audition for the leading part, including Tee Zeng. At the same time, Manipulens sees a poster for the play and thinks he's found Kung Fu Girl.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "9271362",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271362",
                    "Titles": {
                        "eng": "The Magician",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng's classmate Gossip Boy is an enthusiast of magic tricks, but he's never successfully performed any in front of his classmates. At a magic shop, he buys a wand that's said to have belonged to Mr Magic, a legendary magician.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "9271363",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271363",
                    "Titles": {
                        "eng": "Hero's Defeat",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "In order to detect abnormal energy, Hiro Hao invents a searching device. Following the detector, Hiro Hao goes to the bun house and Tee Zeng's family's laundry store, but can't figure out where the abnormal energy is.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "9271364",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271364",
                    "Titles": {
                        "eng": "The Duel",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Manipulens comes up with many traps to drive a wedge between Kung Fu Girl and Sword Hero. After starting another quarrel, Manipulens hides himself in the crowd and tries to provoke Sword Hero.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "9271365",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271365",
                    "Titles": {
                        "eng": "Cyber Battle",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Gossip Boy is addicted to a Kung Fu Girl video game. Tee Zeng borrows the game and gets addicted too. Kung Fu Sock doesn't think much of the game at first, but soon he's attracted by the gorgeous Kung Fu moves in the game.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "9271366",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271366",
                    "Titles": {
                        "eng": "Animal Shelter Encounter",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng takes the wrong sock to a school field trip. Traumatised from the last time, Kung Fu Sock sneaks out of the window and tries to catch up with her, only to end up at the same animal shelter as Manipulens.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "9271367",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271367",
                    "Titles": {
                        "eng": "Cave Rescue",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "After school, Tee Zeng gets a video call from Gossip Boy, who claims to be in a scary cave. When the call is cut off, a worried Tee Zeng, Min and Hiro Hao head to the cave.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "9271368",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271368",
                    "Titles": {
                        "eng": "Kung Fu Sock's Injury",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng transforms into Kung Fu Girl to fight a Kwei-possessed Mosquito Monster. During the fight, she accidentally scratches Kung Fu Sock, who becomes very weird after he's injured.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "9271369",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271369",
                    "Titles": {
                        "eng": "Night of the Shooting Stars",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng, Min and Kung Fu Sock go to the temple fair to see a meteor shower. It's lively, full of people, and fun - until Kwei shows up and causes chaos.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "9271370",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271370",
                    "Titles": {
                        "eng": "Hao's Disappearance",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng is almost certain that Hiro Hao is Sword Hero. She wants to tell Hiro Hao her secret identity as Kung Fu Girl, too. Kung Fu Sock doesn't like the idea, but admits they need to join forces to fight Manipulens.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "27": {
                    "ID": "9271371",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271371",
                    "Titles": {
                        "eng": "Hao's Secret",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "To save Hao from Manipulens, Tee Zeng, Min and Kung Fu Sock go to Hao's home for more clues. Kung Fu Sock crawls his way in and opens the door. As the squad tries to crack into the computer, they trigger the alert system.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "28": {
                    "ID": "9271372",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271372",
                    "Titles": {
                        "eng": "Hao's Memory",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Hao tries to answer Tee Zeng, but he is confined in his own consciousness. Manipulens points out that Hao walked into his trap voluntarily, but Hao doesn't seem to remember, so they go back in time to the night it happened.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "29": {
                    "ID": "9271373",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271373",
                    "Titles": {
                        "eng": "Wake Up, Hao",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Previously, Hao was possessed by Manipulens and attacked Tee Zeng and Min when they tried to wake him up. Tee Zeng is so worried about Hao that she stays.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "30": {
                    "ID": "9271374",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271374",
                    "Titles": {
                        "eng": "Broken Glass",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Early in the morning, Tee Zeng's mum goes upstairs to wake up Tee Zeng. She finds Tee Zeng's room a total mess and gets mad. Later, when Tee Zeng is having breakfast, she spills her bun leaving a stain.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "31": {
                    "ID": "9271375",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271375",
                    "Titles": {
                        "eng": "Sweet vs. Spicy",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Now Manipulens has Hao, the seagull is no longer his favourite puppet. He forces the seagull out and tells it not to return unless it finds Kung Fu Sock's whereabouts. Eager to prove its usefulness, the seagull is determined to find Kung Fu Sock.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "32": {
                    "ID": "9271376",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271376",
                    "Titles": {
                        "eng": "Who is Kung Fu Girl?",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng finds herself getting up late again. In order to rush to school, she transforms into `Kung Fu Girl', and unfortunately, this happens to be seen by her classmate, Gossip Boy.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "33": {
                    "ID": "9271377",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271377",
                    "Titles": {
                        "eng": "A Cold Day",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng catches a bad cold at night. The next morning, she sneezes and wakes up Kung Fu Sock. Kung Fu Sock hardly has a chance to express his concern when Tee Zeng sneezes again and the air blows Kung Fu Sock away.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "34": {
                    "ID": "9271378",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271378",
                    "Titles": {
                        "eng": "Friendship Repair",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "A sacred scroll lights up when Tee Zeng and her Kung Fu Sock, a Kung Fu master from another dimension, watch the rehearsal of the performer Miss Peach, AKA `Princess and the Twins'.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "35": {
                    "ID": "9271379",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271379",
                    "Titles": {
                        "eng": "The Board Game",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Tee Zeng thinks about Hao's rescue plan for a whole day. To cheer her up, Min and Gossip Boy bring her a space adventure board game from an antique shop. The sacred scroll lights up, but before Kung Fu Sock can give a warning, the gang vanish.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "36": {
                    "ID": "9271380",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271380",
                    "Titles": {
                        "eng": "Hero Manipulens",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "A tree monster is attacking the islanders at the park. Controlling Hao's body, Manipulens absorbs the Kwei. In front of the news cameras, he introduces himself as `Hero Manipulens'.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "37": {
                    "ID": "9271381",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271381",
                    "Titles": {
                        "eng": "The Lotus Pond",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "The gang visit a famous lotus pond on Starry Island. Legend has it that a giant lotus lives here. Tee Zeng goes to look for the giant lotus but gets separated from the gang.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "38": {
                    "ID": "9271382",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271382",
                    "Titles": {
                        "eng": "Hao's Plan",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Hao pretends to cooperate with Manipulens and offers to help him with his technological prowess. Manipulens is unsure at first, but he's convinced and let's Hao loose after he beats Kung Fu Girl.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "39": {
                    "ID": "9271383",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271383",
                    "Titles": {
                        "eng": "Hao's Return",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Manipulens grows a little bit stronger every time he absorbs a Kwei. In fact, he just needs one more Kwei to fully restore his body. Meanwhile, at school, Tee Zeng is still thinking about Hao.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "40": {
                    "ID": "9271384",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271384",
                    "Titles": {
                        "eng": "Student and Master",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Hao is finally back and he, Tee Zeng and Kung Fu Sock are working on plans to deal with Manipulens.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "41": {
                    "ID": "9271385",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271385",
                    "Titles": {
                        "eng": "Manipulens' Past",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Manipulens gets badly hurt when he's pushed out of Hao's body. He must find a place to meditate and recuperate. While Manipulens tries to cure himself, his thoughts take him back to when he was a little boy.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "42": {
                    "ID": "9271386",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/422605-/episodes/9271386",
                    "Titles": {
                        "eng": "Team Work",
                        "jpn": null
