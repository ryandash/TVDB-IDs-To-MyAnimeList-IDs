            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "7550890",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7550890",
                    "Titles": {
                        "eng": "A Misfit's Attempt at Self-Reform",
                        "jpn": "社会のはみ出し者は自己変革を目指す"
                    },
                    "Summaries": {
                        "eng": "Uozumi Rikuo runs into his old crush, Morinome Shinako, and Nonaka Haru runs into her old crush, Rikuo.",
                        "jpn": "大学卒業後、定職には就かずにコンビニでアルバイトをしている魚住陸生。\r\n特に目標もないまま、将来に対する焦燥感を抱えながら生きる陸生の前に、ある日カラスを連れたミステリアスな少女ハルが現れる。\r\nハルの破天荒な振る舞いに戸惑う陸生。\r\n更に、かつて憧れていた大学の同期生森ノ目榀子が東京に戻ってきたことを知らされる。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "7668970",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7668970",
                    "Titles": {
                        "eng": "cul-de-sac",
                        "jpn": "袋小路"
                    },
                    "Summaries": {
                        "eng": "Hayakawa Rou is a student at the school where Morinome Shinako teaches. They seem to have some kind of shared history.",
                        "jpn": "桜の季節、赴任した高校の卒業式を控え髪を短く切った榀子。\r\n幼馴染みの高校生 早川浪が転校してくることになり、金沢での過去の記憶が蘇る。\r\n夜の公園で偶然榀子を見かけた陸生は、気まずいながらも声をかける。\r\n陸生の告白を断った榀子であったが、陸生に以前と変わらずに友達でいてほしいと言う。\r\n陸生に対して煮え切らない態度の榀子が気に入らない野中晴は榀子に会いに行く。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "7677636",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7677636",
                    "Titles": {
                        "eng": "What Is Love?",
                        "jpn": "愛とはなんぞや"
                    },
                    "Summaries": {
                        "eng": "Rikuo catches a cold after standing in the rain with Haru. She invites him to the movies as a way of apologizing.",
                        "jpn": "陸生への想いの強さとは逆に心のどこかに逃げ場を作る晴。\r\n晴のアプローチに戸惑う陸生に対し、自ら一線を引いてしまう。\r\n映画のチケットをもらったことを口実に陸生を誘うが、いつまで待っても待ち合わせ場所に現れない陸生。\r\n陸生の身に何かあったと心配する晴であったが、その時陸生は…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "7683811",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683811",
                    "Titles": {
                        "eng": "As the River Flows, Shinako Returns Home",
                        "jpn": "川は流れて 榀子帰郷"
                    },
                    "Summaries": {
                        "eng": "Hayakawa Rou is in love with Morinome Shinako, who hasn’t moved on from the late Hayakawa Yuu, Rou’s brother. She visits their home back in Kanazawa.",
                        "jpn": "美術大学合格を目指し美術予備校に通う浪は、周囲との技術や知識の差に焦りを感じていた。\r\n亡き兄へのコンプレックスから、いつまでも自分を子供扱いする榀子に浪は思いの丈を伝えるが、榀子の気持ちは動かない。\r\n予備校の帰りに陸生が働くコンビニに立ち寄った浪は晴と陸生の関係を知り、自分の心の葛藤を晴に話すことで思いを新たにする。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "7683814",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683814",
                    "Titles": {
                        "eng": "The Man Named Minato",
                        "jpn": "ミナトという男"
                    },
                    "Summaries": {
                        "eng": "Minato Kouichi was a classmate of Morinome Haru, and a student of photography. They run into each other at Rikuo’s workplace.",
                        "jpn": "カメラが趣味だった陸生は福田から紹介されたギャラリーでのバイトを始め、大学生の湊航一と出会う。\r\n高校時代の同級生だった晴が想いを寄せる陸生に対し冷たく当たる湊。\r\n年下ながら経験に勝る湊の態度に苛つく陸生。\r\nそんなある日、湊が晴をバイト先から家に送る途中に、大学時代の友人達との飲み会から帰る陸生と榀子に遭遇する。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "7683815",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683815",
                    "Titles": {
                        "eng": "The Woman Named Yuzuhara",
                        "jpn": "ユズハラという女"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "突然バイト先に現れた高校時代の彼女、柚原チカを家に泊めることになった陸生。\r\nバイト先のギャラリーの専務から写真スタジオの仕事を勧められ、自分は本当にカメラマンになりたいのかを考え始めていた。\r\n一方、陸生の優しさに甘え、都合のいいように利用しているのではないかと思い悩む榀子。\r\n同僚たちとの飲み会の帰り道にコンビニで偶然晴と出会い、陸生が風邪で寝込んでいることを知った二人は家まで見舞いに行くが、出てきたのは柚原だった…。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "7683822",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683822",
                    "Titles": {
                        "eng": "Premonition of a Couple",
                        "jpn": "恋人たちの予感"
                    },
                    "Summaries": {
                        "eng": "Shinako and Rou get into a fight. Rikuo tries to help mend things, but the answers aren’t clear.",
                        "jpn": "晴との食事の場で陸生は写真スタジオでのバイトに挑戦することを打ち明ける。\r\n陸生が前向きになって行くことを喜ぶ晴。\r\n一方、将来が見えず不安を抱える浪は、焦りから榀子に辛く当たってしまう。\r\n浪との距離感を図れずにいた榀子は陸生に相談するが、思いがけない陸生の言葉に励まされ改めて浪と向き合おうとするのだった。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "7683824",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683824",
                    "Titles": {
                        "eng": "Innocent Blue",
                        "jpn": "イノセント・ブルー"
                    },
                    "Summaries": {
                        "eng": "Shinako invites Rikuo over, but she chickens out, making a fragile friendship even more tenuous.",
                        "jpn": "陸生への気持ちの変化を意識し始めていたが、一歩踏み込めないでいる榀子。同僚の杜田に悩みを打ち明け、背中を押される。\r\n榀子との関係が進展し始めたにも関わらず、何故か心から喜べない陸生は写真スタジオの仕事に没頭していた。\r\n二人の関係を知らない晴は、多忙な陸生に何とか会いに行こうとする。\r\nそして陸生は写真スタジオの正社員に昇格、コンビニを辞め晴や榀子に会う機会が少なくなっていた。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "7683827",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683827",
                    "Titles": {
                        "eng": "Christmas Carol",
                        "jpn": "クリスマス・キャロル"
                    },
                    "Summaries": {
                        "eng": "Rikuo’s friends want to invite him and Shinako over for Christmas. Rou has plans of his own.",
                        "jpn": "久しぶりに浪の家に食事を作りに行く榀子。\r\n強引に迫ったことを反省し想いを語る浪に対し、榀子もこれまでの関係は壊したくないと告げる。\r\n関係が修復し気を良くした浪は、榀子にクリスマスパーティーをしないかと提案する。\r\n晴は、自分が会いに行くことが陸生の負担になると考え自ら引いたものの、気持ちが抑えきれず悩む。\r\n杏子に相談するが、晴自身はどうしたいのかと問われてしまう。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "7683828",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683828",
                    "Titles": {
                        "eng": "A New Year of Beginnings",
                        "jpn": "はじまりの新年"
                    },
                    "Summaries": {
                        "eng": "Shinako calls off going back to Kanazawa for the new year. She and Rikuo make plans to spend it together.",
                        "jpn": "福田家のホームパーティーに突然現れた榀子。\r\n陸生や福田らと大学時代の思い出話などで和やかな時間を過ごす。\r\n福田夫妻からの後押しもあり、帰り道に榀子にクリスマスプレゼントを渡す陸生。\r\nそんな陸生の態度に絆され、正月を一緒に過ごさないかと誘う榀子。\r\n二人が一緒にいることを知らない晴は、陸生の部屋の前でずっと帰りを待つのだった。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "7683829",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683829",
                    "Titles": {
                        "eng": "A Spring Storm",
                        "jpn": "はるの嵐"
                    },
                    "Summaries": {
                        "eng": "A burglar breaks into Haru’s place. Rikuo gives her company for the night after.",
                        "jpn": "警察からの電話で晴の家に向かった陸生。\r\n空き巣の被害はなかったものの、晴に懇願され家に泊まることにした。\r\nゆっくり話す機会がありながらも、陸生は榀子とのことは言えないでいた。\r\n一方、榀子も徐々に進展して行く陸生との関係を浪に言えないでいた。\r\n晴はお礼を口実に自分が作ったベーグルサンドを持って陸生のアパートに向かうが、家から出てきた陸生と榀子に遭遇してしまう…。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "7683830",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/sing-yesterday/episodes/7683830",
                    "Titles": {
                        "eng": "The Long Way",
                        "jpn": "遠回り"
                    },
                    "Summaries": {
                        "eng": "Rikuo notices that something isn’t quite right between him and Shinako. Meanwhile, Haru suffers.",
                        "jpn": "届かぬ思い。\r\n拭えない違和感。\r\nそれぞれが抱える心の葛藤。\r\n本当の幸せとは…？\r\n昨日とは違う自分へ、4人は歩き出した。"
                    },
                    "Aliases": []
                }
            }
        }
