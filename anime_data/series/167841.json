                "1": {
                    "ID": "3919901",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-miserables-2007/episodes/3919901",
                    "Titles": {
                        "eng": "Fantine and Cosette",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Fantine unsuccessfully searches for a job in Montfermeil alongside her three-year-old daughter, Cosette, and eventually drops Cosette off under the care of the Thénardier family, while she travels to the economically-thriving town of Montreuil-sur-Mer. Little does Fantine know, the Thénardiers are a wicked and abusive family, who force Cosette into hard labor, while Cosette waits for the return of her mother.",
                        "jpn": null
                    },
                    "Aliases": []
