                    "Summaries": {
                        "eng": "",
                        "jpn": "ある日、お買いものパンダたちのお家に届いたのは、「あると最高に楽しくなるもの!」テント。キャンプに行こうと誘うが、小パンダは山にも川にも行きたくないという。そこで、お買いものパンダが思いついたのは...!?"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "10789926",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/okaimono-panda/episodes/10789926",
                    "Titles": {
                        "eng": null,
                        "jpn": "シャワーヘッド"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "お買いものパンダが買ったのは、すごく汚れが落ちるシャワーヘッド。「おパンも美容とか気にするんだ」と感心する小パンダに、お買いものパンダは「シャワーヘッドで洗い流したいもの」について切々と語るが...。"
                    },
                    "Aliases": []
                },
