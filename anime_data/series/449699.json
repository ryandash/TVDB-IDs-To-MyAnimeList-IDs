                    "Titles": {
                        "eng": null,
                        "jpn": "謎のタマゴ"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "自宅に届いた段ボールの中には、大きなタマゴが。「産まれたらむぎのお友達になれると思って」と、わくわくしながら温め始めるお買いものパンダだが、何のタマゴかは知らない。一体何が生まれるのか...!?"
                    },
                    "Aliases": []
                },
                "4": {
