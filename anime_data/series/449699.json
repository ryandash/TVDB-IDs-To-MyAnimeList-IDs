                    "Titles": {
                        "eng": null,
                        "jpn": "肝試し"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "お買いものパンダと小パンダは、どちらの方がより“ビビリ”なのかを検証するため心霊スポットへ赴く。お買いものパンダが取り出した「ビビリ測定器」で、お互いの心拍数を測定しようとするのだが...。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "11619098",
                    "TYPE": null,
