                    "Titles": {
                        "eng": null,
                        "jpn": "蚊取り"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "あつ~い夏のある日、お買いものパンダのお家に1匹の蚊が現れる。「豚の蚊取り線香」や「電撃蚊取り器」など、お取り寄せしたものを使って、あの手この手で蚊を退治しようとするお買いものパンダだったが...。"
                    },
                    "Aliases": []
                },
                "5": {
