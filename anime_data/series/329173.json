            },
            "# Episodes": 26,
            "Episodes": {
                "1": {
                    "ID": "6107176",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107176",
                    "Titles": {
                        "eng": "Out to Sea, to Adventure!",
                        "jpn": "冒険だ海へ出よう！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "町ネズミのガンバとボーボは、ひと目海を見ようと川を下った。港に着いたのは夜で海はよく見えないが、港の倉庫でネズミたちのパーティーに参加して大さわぎ。そこへ一匹のボロボロに傷ついたネズミ、忠太がやってくる…。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "6107177",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107177",
                    "Titles": {
                        "eng": "Ganba Goes Nuts Onboard",
                        "jpn": "ガンバ、船で大暴れ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ガンバは忠太と共に通称“ノロイ島”に向かう船の船倉に乗り込んだ。そこへノロイと戦う決心をしたネズミたち、ヨイショ、ガクシャ、シジン、そしてボーボが合流する。初めての航海でひどい船酔いになるガンバだったが…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "6107178",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107178",
                    "Titles": {
                        "eng": "Mission: Save Chûta!",
                        "jpn": "忠太を救え！大作戦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "忠太の傷は治らず、高熱が続いていた。寄港した港の町で薬を調達することになるが、その町は、イカサマの生まれ故郷だった。下船したイカサマは港のネズミ相手にいかさまバクチをして追いかけられる。そこへ偶然、薬を手に入れたガンバとボーボが通りかかり、3匹は町のネズミと戦うハメに…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "6107179",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107179",
                    "Titles": {
                        "eng": "Battered by a Storm",
                        "jpn": "嵐にやられてメッタメタ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ようやく忠太の体も回復し、のんびり航海を楽しむガンバたち。しかし突然大きな嵐に襲われ、船は沈没してしまう。かろうじて海に飛び込んだガンバたちだったが、ボーボが行方不明になる。ボーボを探し回るネズミたち。しかし空しく夕日が沈もうとしていた…。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "6107180",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107180",
                    "Titles": {
                        "eng": "What Awaits on Battleship Island?",
                        "jpn": "なにが飛び出す？軍艦島"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ボーボはリンゴ箱の中で発見された。リンゴ箱の船で出発したガンバたちは、座礁した軍艦を見つけて上船する。軍艦の中には水につかった大量のカンヅメがあったが、巨大な魚がいるので近づけない…。どうするガンバ！？"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "6107181",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107181",
                    "Titles": {
                        "eng": "Fun, Fun Diving",
                        "jpn": "たのしいたのしい潜水艦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "なぜかタテに浮いてしまう潜水艦だったが、足こぎスクリューでどんどん進む。順調に航海を続けるガンバ達であったが、途中で巨大なクジラにはじき飛ばされ、小さな島に打ち上げられてしまう。しかも！それは満ち潮と共に水面に沈んでしまう小島だった！！"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "6107182",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107182",
                    "Titles": {
                        "eng": "Scary, Scary Black Shadow",
                        "jpn": "ぶきみなぶきみな黒い影"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "全員、無事に島にたどりついた。食べ物も豊かだったが、妙に静かなのが気にかかる。案の定、ガンバたちを不気味な黒い獣が襲う！みなは必死で海辺に逃げるが、ボーボがいないことに気づく。森の中を探し歩くガンバは、急に何者かに腕をつかまれた…。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "6107183",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107183",
                    "Titles": {
                        "eng": "Bobo's First Love",
                        "jpn": "ボーボが初めて恋をした"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "島にはザクリと呼ばれ恐れられているキツネがいた。早く島を離れろ、とクリークは言うが、ガンバたちはどうしても放っておけない。しかしガンバたちの勝手な行動で、リスの仲間が犠牲になってしまう…。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "6107184",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107184",
                    "Titles": {
                        "eng": "Difficult Battle with the Black Fox",
                        "jpn": "黒ギツネとの苦しい戦い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "イエナを助けるためザクリのねぐらを探すことにしたガンバ達。ボーボが自慢の鼻でイエナの匂いをかぎつけ、ザクリのねぐらを突きとめることができた。ガクシャの提案でねぐらを水攻めにする作戦が練られたが、その前にイエナを救出しなければ…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "6107185",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107185",
                    "Titles": {
                        "eng": "Seven Split Boards Going Their Separate Ways",
                        "jpn": "かじって別れた七つのイカダ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ザクリを倒したガンバたちは島を出発するが、海は大なぎでイカダは一向に進まない。そこへ巨大な船体が近づき、波を受けたガンバが海に放り出されてしまう。ガンバは体に全く力が入らず、ただ空しく海に浮いていた。そこへ1頭のイルカが現れて…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "6107186",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107186",
                    "Titles": {
                        "eng": "After Toragoro, the Swindler!",
                        "jpn": "ぺてん師トラゴローを追え！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "イカダはついに陸地に到着。ここからカラス岳を越えれば、対岸にノロイ島が見えるはずだ。馬車にもぐり込み、のどかな村をいくガンバたち。途中、トラゴローと名乗る旅のネズミに出会う。トラゴローにだまされ、みんなはさんざんな目に合うが…。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "6107187",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107187",
                    "Titles": {
                        "eng": "A Party, a Fight, an Uproar",
                        "jpn": "祭りだ 喧嘩だ 大騒動"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "とんだ回り道をした一行だったが、なんとかカラス岳のふもとの村に到着。神社のおみこしの中にもぐり込むが、なんと村は祭りの真最中だった。ついでに祭りを楽しもうとくり出すガンバたちだった。しかし早くノロイ島に戻りたい忠太は、気分が乗らない。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "6107188",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107188",
                    "Titles": {
                        "eng": "Special Training!! Operation Moo-moo",
                        "jpn": "特訓！！モーモー大作戦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "カラス岳を目指して強引に進むガンバのリードに、ガクシャをはじめ仲間たちから文句が出始める。やがて広大な砂地に出ると、ついにガクシャとガンバの意見の対立が表面化してしまう！7匹は砂地を進む組と森を迂回する組に別れ、別行動をとることに…。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "6107189",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107189",
                    "Titles": {
                        "eng": "Attack of a Pack of Hunting Dogs",
                        "jpn": "襲いかかる猟犬の群れ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "砂地をいくことになったガンバ達は途中で迷子の子ウサギに出会う。その子ウサギを家に返してやろうとすると、猟犬たちが襲って来る。なんとか猟犬の牙をのがれ、子ウサギを家に送り届けるガンバたち。しかし、子ウサギはガンバと一緒にいくとだだをこねて…。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "6107194",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107194",
                    "Titles": {
                        "eng": "Ganba Kidnapped by an Eagle",
                        "jpn": "鷹にさらわれたガンバ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ガクシャたちは、嵐に巻きこまれたガンバたちの捜索に必死だった。そうとは知らず、ガクシャたちに先を越されまいと絶壁をよじ登り、ひと眠りするガンバたち。ところがガンバは眠っている間に鷹にさらわれてしまう！"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "6107198",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107198",
                    "Titles": {
                        "eng": "Climbing Formidable Crow Peak!",
                        "jpn": "魔のカラス岳を登れ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ガンバは遅れを取り戻そうと山頂をめざす。ボーボたちも、ガンバを捜しつつ前進していた。一方、ガクシャたちは山の北壁を登り、なだれに巻きこまれる。雪の中から彼らを掘り起こしたのは、ガンバだった！ 再会を喜ぶガンバ達だったが…。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "6107199",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107199",
                    "Titles": {
                        "eng": "Run, Run, for the Weasel is Near",
                        "jpn": "走れ走れノロイは近い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "仲直りしたガンバたちはリーダーを譲り合い、結局山のふもとまで全員が順番にリーダーになることに。それぞれ自分の番には持てる力を十分に発揮するガンバたち。谷川を下り、線路に出た時、ボーボが列車に引っ掛かってしまう！"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "6107200",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107200",
                    "Titles": {
                        "eng": "Curious, Fat Mice",
                        "jpn": "奇妙なふとったネズミたち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ふもとの町に下りたガンバたち。食べ物を求めて高蔵に入ると、以前ノロイの襲撃を受けたネズミ達が、すでにノロイがいないにもかかわらず、蔵から一歩も出ずに暮らしていたのだ。ガンバは彼らを臆病者呼ばわりしてしまう…。"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "6107202",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107202",
                    "Titles": {
                        "eng": "Streaked Shearwater Sinking in Darkness",
                        "jpn": "闇に潜むオオミズナギ鳥"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ガンバたちはなんとか海峡を渡ろうとするが、あまりの潮の速さに手も足も出ない。そんなガンバたちを襲うオオミズナギ鳥たち。鳥のリーダー、ツブリは、ガンバたちをノロイの仲間と勘違いしたのだ。そんな彼らの誤解が解けた時、ガンバに海峡を渡るいいアイデアが浮かぶ。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "6107203",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107203",
                    "Titles": {
                        "eng": "I Saw a White Weasel!",
                        "jpn": "白イタチノロイを見た！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ノロイ島に上陸したガンバたちは、草原でイタチの襲撃に合う。危機一髪、ノロイの合図でイタチたちは退いていくが、姿を見せぬノロイにもてあそばれていることを思い知るガンバたち。ガンバたちはとうとう忠太の仲間の待つ穴に到着するが、そこはもぬけのカラだった…。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "6107204",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107204",
                    "Titles": {
                        "eng": "13 Eyes Wet with Tears",
                        "jpn": "涙にぬれた13の瞳"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "海に飛び込んで難を逃れたガンバたちだが、休む間もなくノロイの追跡は続く。かろうじて逃げ込んだ穴に、忠太の姉、潮路が姿を現し、火山の火口にある隠れ家にガンバ達は案内された。島のネズミたちの歓迎を受けるが、翌朝、水をくみに出たガンバと潮路は、ノロイの襲撃を受ける。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "6107205",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107205",
                    "Titles": {
                        "eng": "Friends from Across the Sea",
                        "jpn": "海を渡って来た仲間"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "食料を調達に村に下りたガンバたちは、イタチに追われてせっかくの食料も台なしにしてしまう。その時、空からツブリが食料を運んで来てくれる。高蔵のネズミたちも一緒だ。しかし食料を火口に運ぶ途中、またしてもノロイが襲い、高蔵ネズミの一郎たちは命を落としてしまった…。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "6107206",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/adventures-of-ganba/episodes/6107206",
                    "Titles": {
                        "eng": "Traitor's Fortress",
                        "jpn": "裏切りの砦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "火口には島中のネズミたちが集結しつつあった。活気にあふれる砦。しかし多くはイタチに火口に追い込まれた、というのが現実だった。そんな中に、潮路の幼なじみの太一がいた。実は太一は弟の順太をノロイに人質に取られていた…。"
                    },
                    "Aliases": []
                },
