    "Titles": {
        "eng": "Emily Of New Moon (2007)",
        "jpn": "風の少女エミリー"
    },
    "Summaries": {
        "eng": "Emily is an orphan who gets sent to live with her relatives on Prince Edward Island, after her father dies. In New Moon she lives with her Aunt Elizabeth, Aunt Laura, and Cousin Jimmy, and learns to adapt with the help of her imagination and new friends.",
        "jpn": "エミリーは、父親が亡くなった後、プリンスエドワード島で親戚と一緒に暮らすために送られた孤児です。 ニュームーンでは、彼女はエリザベス叔母、ローラ叔母、いとこジミーと一緒に暮らし、想像力と新しい友達の助けを借りて適応することを学びます。"
    },
    "Aliases": [
        "Emily Of New Moon (2007)",
        "Emily, the Wind Girl",
        "Kaze no Shoujo Emily"
    ],
