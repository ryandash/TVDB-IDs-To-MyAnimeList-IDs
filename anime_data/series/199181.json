            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "3006651",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006651",
                    "Titles": {
                        "eng": "Hear the Voice of the Awakening Call",
                        "jpn": "目覚めよと呼ぶ声が聞こえ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "強い日差しの下、奇岩が立ち並ぶ荒野をあてどもなく歩く2人の女子高生・エリとユコ。エリが川で遊んでいる姿を、ユコが呆れながら見ていると、突然小さな生き物に襲われる。それはこの異世界での“ヒト”であった。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "3006661",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006661",
                    "Titles": {
                        "eng": "It is Shut by the Silence",
                        "jpn": "あたりは沈黙に閉ざされ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "この世界に関心を持ちたくないユコは、人が死んだことやこの世界の情勢にも興味がなかった。そんなユコはエリが村の人たちに何かしようと言いだしたことに腹を立て、「自分には関係ない」と言ってしまう。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "3006671",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006671",
                    "Titles": {
                        "eng": "In the Dark of Night a Time Ago",
                        "jpn": "いつかのような暗い夜に"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "村を出たユコとエリに付き従うシャルたち国境警備隊。しかし、ユコはこの世界に対する警戒が強く、シャルたちの言葉にも、食事にも見向きしなかった。その頃、村ではレカが出ていったシャルを想い、涙を流していた。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "3006681",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006681",
                    "Titles": {
                        "eng": "When the Sky Darkened All of a Sudden",
                        "jpn": "空が急にかげったように"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "アリラ王女が囚われているというバルジダン派のところに向かう一向、そして1日遅れでそれを追うレカとマニ。しかし、レカとマニはその途中でバルジダンゲリラを追討していたオルト率いるグリアニア兵に遭遇する。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "3006691",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006691",
                    "Titles": {
                        "eng": "Past the Forest and Across the Plains",
                        "jpn": "森を過ぎ、野を越えて"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "シャルが村を出た後に守備隊長となったダールは村長に詰め寄り、警備の方針の180度変更し、攻撃は最大の防御であると説得する。 一方、村の外ではシャルとシュラが剣と剣を交えて戦いを続けていた。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "3006701",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006701",
                    "Titles": {
                        "eng": "A Shrewd Hunter",
                        "jpn": "抜け目のない狩人は"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "夜、一行が野営地でくつろいでいると、そこへ敵であるバルジダン兵が急襲し、ベレーたちを人質にする。近くのバルジダンの砦まで付いてくるように脅されたユコは、仕方なく彼らに付いていくことに。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "3006711",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006711",
                    "Titles": {
                        "eng": "No One Should Sleep",
                        "jpn": "誰も寝てはならぬ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "牢屋から一旦は逃げだしたユコたちであったが、再びレビアンに捕まってしまう。そして、レビアンの同僚のデウムの口から、シャルはアリラ王女が崖から足を滑らせて死んでしまったと聞かされる。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "3006721",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006721",
                    "Titles": {
                        "eng": "The Gentle Evening Star",
                        "jpn": "やさしい夕星よ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「何かをすべき」と逃げだす決意をしたユコエリとレカマニ。牢からの脱出を図るシャルたちはデウムから逃れようとするレビアンとグローナの行動によってバルジダンゲリラの砦から逃げだすことに成功する。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "3006731",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006731",
                    "Titles": {
                        "eng": "Pity, Honor and Love",
                        "jpn": "憐れみも、誉れも、愛も"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "追手からとりあえず逃れた一行。しかし、ベルゼーグルに戻ってきた一行が見たものは荒れ果てた村の姿だった。どうやらダールが村の男たちを連れて戦いに出たが誰も戻ってこなかったということらしく…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "3006741",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006741",
                    "Titles": {
                        "eng": "It Has Vanished, the Delicate Traces",
                        "jpn": "消え去れ、やさしい面影よ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ベルゼーグルにやってきたのはオルト率いるグリアニアの兵隊だった。ティングル国王はグリアニアにバルジダン国境付近の警備を委任したという。オルトは村長に魔人を出せと命令するがユコエリは村を出た後だった。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "3006751",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006751",
                    "Titles": {
                        "eng": "The Bitter Pleasure, the Sweet Condemnation",
                        "jpn": "苦い喜び、甘い責め苦を"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "警備という名目でオルトたちグリアニア部隊が村に侵入し、村は完全に占領された。兵士たちの機嫌を取るべく開かれた酒宴の席で、オルトに酌をするレカ。シャルやベレーたちは馬の世話や小間使いとして酷使される。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "3006761",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006761",
                    "Titles": {
                        "eng": "The Radiant Rising Sun",
                        "jpn": "さしのぼる太陽よ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "夜、マニと語りあっていたエリは、外が明るくなっていることに気づく。驚いて表に出ると、村に火が放たれていた。バルジダンの夜襲に対し、グリアニア軍は戦わずに逃げ、村はバルジダンの手に落ちてしまう。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "3006771",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/strange-dawn/episodes/3006771",
                    "Titles": {
                        "eng": "The Mind That Opens to Your Voice",
                        "jpn": "あなたの声に心はひらく"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "グリアニア陣営とバルジダン陣営との間で休戦協定が結ばれる。その条件は魔人を1人ずつ双方が確保することと、戦犯としてシャルをバルジダン陣営に、ダールをグリアニア陣営に引き渡すことだった。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}