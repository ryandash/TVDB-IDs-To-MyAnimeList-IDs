                    "Titles": {
                        "eng": "Episode 1",
                        "jpn": "元祖！バンドリちゃん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "さあさ寄ってらっしゃい見てらっしゃい！\r\n「元祖！バンドリちゃん」が始まるよっ！\r\n元祖って何なんだい！バンドリちゃんって何なんだい！\r\n言いたいことは色々あろうがまずはおつむを空っぽにして、\r\n軽い気持ちで見ておくんない！\r\n\r\nお代は見てのお帰りだよっ！"
                    },
                    "Aliases": []
                },
