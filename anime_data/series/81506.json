            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "356002",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356002",
                    "Titles": {
                        "eng": "Blues of the Rubbish Heap",
                        "jpn": "はきだめのブルース"
                    },
                    "Summaries": {
                        "eng": "Tadashi is a young man living on a junk heap of a planet. He lives his life by his fists, fighting the neighborhood gangs and going out with his girlfriend. His live changes when he returns home to find his father dead and zombie like creatures hanging over his father’s corpse. He is saved from the creatures by the notorious captain Harlock who invites him onto his ship to become a man.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "356003",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356003",
                    "Titles": {
                        "eng": "For Whom the Friend Sleeps",
                        "jpn": "誰がために友は眠る"
                    },
                    "Summaries": {
                        "eng": "As Harlock has returned to the junk planet its local police force is on the edge. Meanwhile Tadashi discovers the nature of the work his dead father Daiba did on the notorious space ship.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "356004",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356004",
                    "Titles": {
                        "eng": "The Voice calling for Noo from Afar",
                        "jpn": "はるかなるヌーの呼び声"
                    },
                    "Summaries": {
                        "eng": "Earth has vanished following the mysterious attack from the Fata Morgana, now a ghost ship which was once used by Professor Daiba for a scientific expedition.\r\nTadashi decides to accept the proposal of Captain Harlock and to board the Arcadia.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "356005",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356005",
                    "Titles": {
                        "eng": "Yattaran's 30-Second Bet",
                        "jpn": "ヤッタラン・30秒の賭け"
                    },
                    "Summaries": {
                        "eng": "Yattaran, Kei Yuki and the other former ship mates of Harlock are being held on the prison planet and are condemned to capital punishment. While the Arcadia strives to set them free, the commander Ilita takes the head of the space armada which should fight the Fata Morgana.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "356006",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356006",
                    "Titles": {
                        "eng": "Battlefield-The Tombstone Planet",
                        "jpn": "戦場は墓標の星に"
                    },
                    "Summaries": {
                        "eng": "The Arcadia investigates the disappearance of the Earth. During this time, army commander Ilita prepares to engage in combat, but will they last long against the most frightening weapon of the ghost ship: fear!",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "356007",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356007",
                    "Titles": {
                        "eng": "A Gentle Smile on the Skull of Memory",
                        "jpn": "追憶の髑髏は優しく嗤う"
                    },
                    "Summaries": {
                        "eng": "The armada is decimated, and Ilita is the only survivor. While the Arcadia approaches the battlefield, Tadashi burns to revenge his father's death. But will the brave crew of the Arcadia resist the servants of evil?",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "356010",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356010",
                    "Titles": {
                        "eng": "The Moon Waits in the Promised Land",
                        "jpn": "約束の地に月は待つ"
                    },
                    "Summaries": {
                        "eng": "On a mining planet, an evil roar resonates in the heart of a mountain. A minor has disappeared.\r\nMaji, a former companion of Herlock, goes looking for him.\r\nMeanwhile, the crew of the Arcadia discovers a mysterious pyramid buried in a crater of the Moon.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "356011",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356011",
                    "Titles": {
                        "eng": "Somewhere within the Decimated Planet lies the Castle Ruins",
                        "jpn": "死滅の星の魔城"
                    },
                    "Summaries": {
                        "eng": "Yuki is brought aboard the Arcadia.\r\nMeanwhile, Maji witnesses Tadashi being kidnapped, resulting in him being captured, too.\r\nIt is a sad fate that is reserved for them by Noo: they have no choice than to kill each other!",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "356012",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356012",
                    "Titles": {
                        "eng": "In the Depths of the Shadows of the Soul",
                        "jpn": "友よ。魂の深き闇の果てに"
                    },
                    "Summaries": {
                        "eng": "Come to save his friends, Herlock manages to find enough strength in himself to defeat an evil entity of Noo.\r\nBut while the crew of the Arcadia is working to unravel the mysteries of Earth by decrypting Tadashi's  medallion, an insidious threat sneaks aboard the ship...",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "356013",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356013",
                    "Titles": {
                        "eng": "Kei-Illusion",
                        "jpn": "蛍・幻想"
                    },
                    "Summaries": {
                        "eng": "Captured by the Noo, the body of Kei Yuki surveys the corridors of the Arcadia with an aim of destroying the computer of the vessel. During this time, Kei, captive of her dreams, meets the spirits of the missing scientists, who tell her the tragic story of the crew of the Fata Morgana.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "356014",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356014",
                    "Titles": {
                        "eng": "Trembling Universe",
                        "jpn": "震える宇宙"
                    },
                    "Summaries": {
                        "eng": "After Noo took on Herlock in a duel, the Arcadia flies to the planet Neoterra to help them in their combat against the Fata Morgana. The Noo then shows all its destructive power by causing an earthquake which shakes the entire universe. Will the Arcadia manage to escape from it?",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "356015",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356015",
                    "Titles": {
                        "eng": "The Soul Drifts to the Far Ends, with No Words at Parting",
                        "jpn": "さいはてに魂は流れる。別れに言葉もなく"
                    },
                    "Summaries": {
                        "eng": "The crew must find a way to save the Arcadia unassisted by the on-board computer.\r\nMeanwhile, Irita engages in a fight against the Fata Morgana.\r\nIn a final act of heroism, he sacrifices himself to embed a tracker into the vessel which will allow Herlock to trace Noo...",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "356016",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/captain-herlock-the-endless-odyssey/episodes/356016",
                    "Titles": {
                        "eng": "... the end",
                        "jpn": "…涯"
                    },
                    "Summaries": {
                        "eng": "Harlock is left alone on the ship save Mimeh. He follows the Noo into the realm the earth is hidden in. Meanwhile Tadashi is visited by his father’s ghost who tells him of a promise Harlock made him.",
                        "jpn": ""
                    },
                    "Aliases": []
                }
            }
        }
    }
