        "4": {
            "ID": "1984323",
            "URL": "https://thetvdb.com/series/384640-/seasons/official/4",
            "Titles": {
                "eng": "Across the Endless Sea",
                "jpn": null,
                "zho": "初入星海",
                "vie": "Sơ Nhập Tinh Hải",
                "rus": "Через бескрайнее море"
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "zho": "韩立英雄救美，却被昏迷中的南宫婉吸噬功力，修为从【筑基期】跌至【练气期】。韩立离开天南的心意已决，通过修复和使用古传送阵，他成功和曲魂传成功来到了【乱星海】。他们在新的地域斩妖兽，开洞府，养灵宠。渐渐地韩立已经恢复到了筑基期，还将曲魂炼制成了自己的【身外化身】。在参加了六连殿举办的镇妖大典并成功胜出的时候，他们不知自己正陷入由【极阴岛】与【六连殿】合谋搞出的一场变动之中。逃亡中邂逅了【妙音门】的【汪凝】，还斩杀了一名结丹期的六连殿长老。这下要准备冲击结丹了。",
                "vie": null,
                "rus": null
            },
