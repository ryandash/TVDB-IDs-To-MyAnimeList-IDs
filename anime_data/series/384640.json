        "3": {
            "ID": "1965303",
            "URL": "https://thetvdb.com/series/384640-/seasons/official/3",
            "Titles": {
                "eng": "Farewell Tiannan",
                "jpn": null,
                "zho": "再别天南",
                "vie": "Tạm Biệt Thiên Nam",
                "rus": "Прощай, Тианнан."
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "zho": "韩立离开京城后，在嘉元城找到并夺回了被人占据身体的曲魂，同时知晓七派中的【灵兽山】已经在暗地里勾结了魔道六宗。七派联盟与魔道大战，最终惨败。韩立没有参与前线战事，但他与黄枫谷的其他弟子一样，被当作诱饵给抛弃了。韩立在师父李化元的协助下，脱离了险境，但李化元却在与【元婴】级别的【云露老魔】面前英勇战死。黄枫谷被灭，南宫婉因为惦记着韩立的安危，独自犯险寻找韩立，却被魔道的人围攻。",
                "vie": null,
                "rus": null
            },
