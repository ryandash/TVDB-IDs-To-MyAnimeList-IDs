        "2": {
            "ID": "1873835",
            "URL": "https://thetvdb.com/series/384640-/seasons/official/2",
            "Titles": {
                "eng": "Clash with the Demonic Sects",
                "jpn": null,
                "zho": "魔道争锋",
                "vie": "Ma Đạo Tranh Phong",
                "rus": "Столкновение с демоническими сектами"
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "zho": "韩立被七派同盟令召集去袭击魔道控制的一个灵石矿洞，经历一番勾心斗角之后，韩立发现一处看似已经破损的古代传送阵。回到七派同盟前线，韩立被师父【李化元】委派去京城保护秦府。任务期间，韩立发现京城出现许多散修失踪的怪事。在和【蒙山五友】的联手追查之下，发现了黑煞教俘虏散修进行炼丹的恶行。韩立召集自己的师兄师姐一同铲除了黑煞教，同时也付出了惨痛的代价。",
                "vie": null,
                "rus": null
            },
