            "# Episodes": 24,
            "Episodes": {
                "1": {
                    "ID": "11026380",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11026380",
                    "Titles": {
                        "eng": "Meeting of the Braves",
                        "jpn": "勇者の出会い"
                    },
                    "Summaries": {
                        "eng": "In a world where crime has turned fantastical, Braves like Yashiro to take down the magical criminals.",
                        "jpn": "フリーランスの勇者《死神》ヤシロは、街のチンピラから勇者見習いの女子高生・城ヶ峰を助ける。行きつけのバーで飲んでいたヤシロのもとへ、先ほど助けた城ヶ峰とその同級生の印堂がやってくる。城ヶ峰の話を聞くと、魔王《琥珀の茨》卿に連れ去られた友人を助けて欲しいと懇願される。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "11495625",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495625",
                    "Titles": {
                        "eng": "A Brave's Magic",
                        "jpn": "勇者の魔法"
                    },
                    "Summaries": {
                        "eng": "Jogamine and Yashiro make a move on the Count of Amber Thorns' base.",
                        "jpn": "魔王の人質になったセーラを救出するため、渋谷にある《琥珀の茨》卿の根城に向かうヤシロと城ヶ峰。次々と現れる敵を前に、ヤシロの異能が明らかになる。最奥の間にたどり着いたヤシロたちは、ついに《琥珀の茨》卿と対峙。しかし、予想外の出来事が起こり、ヤシロは絶体絶命のピンチに立たされる。その時、城ヶ峰がとった行動はーー。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "11495626",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495626",
                    "Titles": {
                        "eng": "A Teacher for Braves",
                        "jpn": "勇者の教官"
                    },
                    "Summaries": {
                        "eng": "Yashiro is adamant about not teaching the girls, but Indo is determined to get stronger with his help.",
                        "jpn": "BARグーニーズでカードゲームに興じるヤシロのもとに、城ヶ峰・印堂・セーラが押しかけてくる。アカデミーで落第寸前の自分たちを「師匠」として指導してほしいというのだ。面倒なことに関わりたくないヤシロは3人を追い返すが、なおも諦めきれない印堂はヤシロを待ち伏せする。そんな時、ヤシロを付け狙う大魔王の眷属《諸手の楔》卿が襲いかかってきて……。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "11495627",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495627",
                    "Titles": {
                        "eng": "A Brave's Errands",
                        "jpn": "勇者のおつかい"
                    },
                    "Summaries": {
                        "eng": "Yashiro finds himself reluctantly paired with Jogamine on an errand for Ishino.",
                        "jpn": "イシノオの依頼で、いやいやながらも城ヶ峰の護衛を引き受けたヤシロ。彼女と新宿歌舞伎町のクラブに潜入して、《覗き屋》のマツギからE3を受け取り、「ある質問」をして帰るだけのはずだったが、E3を投与した男たちが少女2人を連れ込もうとしているところに遭遇し、またしても城ヶ峰の暴走が始まる！"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "11495628",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495628",
                    "Titles": {
                        "eng": "A Brave Sensei",
                        "jpn": "勇者の先生"
                    },
                    "Summaries": {
                        "eng": "Sara comes to Yashiro needing supervision for an assignment from the academy.",
                        "jpn": "ヤシロはセーラから、アカデミーの単位取得に必要な奉仕活動の監督役になってほしいと頼まれる。その奉仕活動とは、不審な集団に連れ去られた警察犬探し。行きがかり上、仕方なく捜索に付き合うことになったヤシロは、セーラと共に廃墟化したショッピングモールへ向かう。暗い建物内を進む2人を待ち受けていたのは、無数に光る目だった。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "11495629",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495629",
                    "Titles": {
                        "eng": "A Brave's Special Training",
                        "jpn": "勇者の特訓"
                    },
                    "Summaries": {
                        "eng": "Yashiro finds himself in need of quick cash, leading to some fighting lessons with the girls.",
                        "jpn": "城ヶ峰・印堂・セーラが通うアカデミーで、剣を使った実技試験が行われることになった。3人にとって実技試験は、進級か退学かを左右する重要なイベントである。ヤシロは自称「弟子」たちに稽古をつけるべく、夜のアカデミー校舎で特訓を開始する。激しい攻防を繰り広げながらも、的確に3人の欠点を指摘するヤシロ。ところが、そこで思わぬ敵と遭遇することになり……。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "11495630",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495630",
                    "Titles": {
                        "eng": "Death of a Brave",
                        "jpn": "勇者の死"
                    },
                    "Summaries": {
                        "eng": "Yashiro's training for the girls runs into trouble when mysterious assailants attack them.",
                        "jpn": "E3によって異様な力を発揮するイド。虎の子のバスタードソードを欠いた状態で応戦するヤシロは、訓練用の模造刀で必殺技を仕掛ける。気まぐれに城ヶ峰へ技の解説をしたことをきっかけに、彼女の父親とヤシロの意外な因縁が明らかになる。\r\n不愉快な思い出を振り払うように、ヤシロはBARグーニーズへ戻るが……。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "11495631",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/yuusha-no-kuzu/episodes/11495631",
                    "Titles": {
                        "eng": "A Brave's Sins",
                        "jpn": "勇者の罪"
                    },
                    "Summaries": {
                        "eng": "With one of his cohorts dead, Yashiro is out for revenge.",
                        "jpn": "イシノオの死に衝撃を受ける勇者たち。イドとレヴィがつけていた『割れた竜の顔』のバッジ、それは魔王同士の抗争を狙っている謎の組織《ハーフ・ドラゴン》のものだった。イシノオ殺害の黒幕の手がかりを求めて、文部科学省の魔王災害対策分室へ向かったヤシロは、とある政治家の息子に高額の賞金が懸けられていることを知る。その息子とは、数ヶ月前に戦った《諸手の楔》卿の部下で……。"
                    },
                    "Aliases": []
                },
