            "# Episodes": 2,
            "Episodes": {
                "1": {
                    "ID": "4094200",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4094200",
                    "Titles": {
                        "eng": "Southern Romance Story - Love, Festival and Confession",
                        "jpn": "らいむいろ戦奇譚　南国夢浪漫　前編 愛と祭りと告白と"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "らいむ隊をねぎらうため、天乃原の修理に立ち寄ったのは五行祭りまっただ中の南の島だった。お祭りを楽しむ一行だが、浴衣を着ても水着を着ても、頭の中は新太郎のことでいっぱい！ そんな折、五行神社にまつわる愛の伝説を聞いた乙女たちは…！"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "4094201",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4094201",
                    "Titles": {
                        "eng": "Southern Romance Story - Cold Song of Farewell - New Protectors",
                        "jpn": "らいむいろ戦奇譚　南国夢浪漫　後編 さらば凛歌 新たなる防人"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "南の島を存分に楽しむらいむ隊の五人。しかし、そんな乙女たちを見ても新太郎の気持ちは暗くなるばかり…。そんな中、捕虜であるラシャとサテンから情報を引き出すよう、新太郎に命令が下がる。二人を外に連れ出すが、話を切り出すことができない新太郎。その時、空に暗雲が立ち込め、天乃原から爆煙が立ち上がるが…。"
                    },
                    "Aliases": []
                }
            }
        },
        "1": {
            "ID": "17632",
            "URL": "https://thetvdb.com/series/lime-colored-history-of-war/seasons/official/1",
            "Titles": {
                "eng": null,
                "jpn": null
            },
            "Summaries": {
                "eng": null,
                "jpn": null
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "327852",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327852",
                    "Titles": {
                        "eng": "The Girl's School on a Battleship",
                        "jpn": "戦艦の中の女学校"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "時は明治。日露戦争の只中、馬飼新太郎は教師として「天乃原女学院」に赴任することになった。担当する生徒たちは、年齢や育った環境が異った五人の個性豊かな少女たち。校舎が地下にあったりと、変わった環境に戸惑いながらも、教師として頑張ろうと思う新太郎。そんな中、突如校舎内にサイレンが響き渡る…。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "327853",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327853",
                    "Titles": {
                        "eng": "Amanohara Takeoff",
                        "jpn": "天乃原発進"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "状況に戸惑いながらも、授業を始める新太郎。しかし教室にサイレンが鳴り響き、五人の少女たちはまた戦闘へ向かってしまう。呆然としているところへ、突然目の前に三つ子が現れた。助けを求める三人に導かれ、新太郎は神殿へ辿り着く。そこには「九鬼様」と呼ばれる、神秘的に眠る少女の姿があった…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "327854",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327854",
                    "Titles": {
                        "eng": "As a Soldier, As a Teacher",
                        "jpn": "軍人として、教師として"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "らいむ隊の隊長に就任した新太郎だが、上手く指揮することが出来なかった。そこで麻とこっそり剣の訓練をすることに。これが思わぬ誤解を生み、麻の親友である絹は新太郎を憎む始末。そして麻もまた新太郎と絹が一緒にいる姿を見て、二人の仲を誤解する。そんな中、再び襲ってきた敵に麻は一人で戦いに挑もうとするが…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "327855",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327855",
                    "Titles": {
                        "eng": "Great Detective Sarasa!?",
                        "jpn": "名探偵更紗!?"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "更紗ご自慢の懐中時計が盗まれた!? 更紗と木綿が一緒にお風呂に入っている間に盗まれたらしい。愛犬アンジーを従え、自ら探偵となり犯人探しにやっきになる更紗。らいむ隊のみんなに次々と疑いの目を向ける。そして綸子が何かを隠す姿を見た更紗は、彼女が犯人ではないかと思い込み…。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "327856",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327856",
                    "Titles": {
                        "eng": "Another Homeland",
                        "jpn": "もう一つの故郷"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ロシアとの戦いが激化する中、一人思い悩む木綿。彼女の礼武だけが足軽のまま、成長する気配がない。新太郎はその様子を見て、どうにかして自信を取り戻させたいと考えていた。その折、針路変更を余儀なくされてた戦艦天乃原は、偶然木綿の故郷に降り立つことに。そこで新太郎は、木綿を案内役に課外授業をするのだが…。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "327857",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327857",
                    "Titles": {
                        "eng": "The Peaceful Day Off",
                        "jpn": "静かなる休日"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "終わりの見えないこの戦いに、束の間の休息が訪れた。休日を楽しむ五人の少女たち。海では、お互いの水着姿を比べ合ってケンカになったり、旅館では麻と更紗が料理の取り合いを始めたりと大騒ぎ。そして夜も更けたころ、新太郎が星を見上げて思うこととは…。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "327858",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327858",
                    "Titles": {
                        "eng": "A Thousand Paper Cranes",
                        "jpn": "千羽鶴"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "戦艦天乃原が外国人漂流者を拾った。それは新太郎が外交官としてロシアに駐在していた頃に婚約していた女性、ソフィアだった。しかし漂流時のショックが原因なのか、彼女は記憶を失い別人のような姿に。新太郎を励ましたい少女たちは、ソフィアのために千羽鶴を折ることにした。一人だけうまく鶴が折れない更紗は…。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "327859",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327859",
                    "Titles": {
                        "eng": "I'm Not Afraid of Bad Luck!",
                        "jpn": "大凶なんか怖くない！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "以前にも増して霊感が強くなった絹。みんなの色々な秘密を見事に当ててしまう。麻はかばってくれるのだが、更紗たちは絹の“変な力”に迷惑な様子。一方、新太郎は絹ならソフィアの身に起こったことが分かるかもしれないと思い調べて欲しいと頼む。ソフィアの体に触れた絹は、そこに予想もしなかった光景を見てしまい…。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "327860",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327860",
                    "Titles": {
                        "eng": "Little Step",
                        "jpn": "リトル・ステップ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "九鬼様が行方不明に?! そこで止むを得ず天乃原を停留させることにする。どうすれば九鬼様を探し出せるのか？ 更紗が考えた方法は、舞踏会を開くこと。そうすれば九鬼様が珍しがって帰ってくるはず。少女たちは街に舞踏会用のドレスを探しに出掛ける。しかし麻だけは浮かない表情だった…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "327861",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327861",
                    "Titles": {
                        "eng": "A Closed Off Heart",
                        "jpn": "閉ざされた心"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "激しい戦いの最中、詰め所に爆弾が命中。燃えあがる炎を前に綸子は、ひどく脅え意識を失ってしまう。その原因は彼女自身の過去にあるようだが、自分からは話そうとはしない。ついには礼武を呼び出すこともできなくなり、らいむ隊から外れたいと新太郎に告げるのだが…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "327862",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327862",
                    "Titles": {
                        "eng": "Big Brother's Day",
                        "jpn": "おにいちゃんの日"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "決戦の日が迫るにつれ、戦場に教え子たちを送り出すことに悩む新太郎。そして原因不明の身体の不調によって、新太郎は心身ともに疲れていた。様子を見かねた木綿たちは、今までの感謝の気持ちから「おにいちゃんの日」を計画する。それぞれ、新太郎におもてなしをしようと張り切るのだが…。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "327863",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327863",
                    "Titles": {
                        "eng": "The Last Lesson",
                        "jpn": "最後の授業"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "最終目標である旅順を目前にした天乃原。最後の決戦を前に、らいむ隊は新太郎の元で最後の授業を受ける。しかし、その直後新太郎に突如異変が起こる。敵の罠にかかり、少女たちを襲い始めたのだ。狂気に満ちた新太郎に無慈悲にも射殺命令が下される。少女たちはとまどいながら、新太郎を正気に戻そうとするのだが…。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "327864",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/327864",
                    "Titles": {
                        "eng": "Victory Bell, Echo Towards the Future",
                        "jpn": "勝利の鐘よ、未来へ響け"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "最後の戦いがついに始まった。激戦の最中、新太郎とらいむ隊は天乃原を離れ、旅順要塞へ潜入する。戦いに身を投じる決意をする新太郎だが、突然麻にみぞおちを殴られ気を失う。少女たちは、最初から新太郎を危険にさらしたくなかったのだ。新太郎とまた会えることを信じて、少女たちは敵に立ち向かっていく…。"
                    },
                    "Aliases": []
                }
            }
        },
        "2": {
            "ID": "526494",
            "URL": "https://thetvdb.com/series/lime-colored-history-of-war/seasons/official/2",
            "Titles": {
                "eng": null,
                "jpn": null
            },
            "Summaries": {
                "eng": null,
                "jpn": null
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "4630199",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630199",
                    "Titles": {
                        "eng": "His Name is Kyoushirou!",
                        "jpn": "漢（おとこ）の名は強志朗！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「ファーデン騎士団」の本拠地エルミタージュに迫った今、「陸軍礼武隊」隊長の犬養強志朗は一人斥候として偵察に出ていた。その隙を突くかのように襲い掛かってくるカシミア、シフォン、リネンの猛攻に対して、強志朗抜きで対抗する礼武隊だが、徐々に押されていく。絶体絶命かという時、強志朗の声が響いた…。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "4630200",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630200",
                    "Titles": {
                        "eng": "Sweet Impact",
                        "jpn": "甘い衝撃"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "時は明治三十八年。愛国の志に燃える犬養強志朗に陸軍礼武隊隊長の辞令が降りた。喜ぶ強志朗の前に突然強志朗を慕う島つむぎが現れた。強志朗を追い、戦地まできたと言う。そんな二人を影から見つめる視線があった…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "4630201",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630201",
                    "Titles": {
                        "eng": "First Time Teacher",
                        "jpn": "はじめての先生"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "陸軍礼武隊隊長として戦艦天乃原に乗り込んだ強志朗。そんな彼が突然、天乃原女学院の先生となって授業をして欲しいと依頼されて…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "4630202",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630202",
                    "Titles": {
                        "eng": "Crybaby Ninja Scroll",
                        "jpn": "泣き虫忍法帖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ファーデン騎士団のリネンによる奇襲で、襲われる戦艦天乃原。「いつもと違う」と感じながらも、撃退すべく、強志朗を筆頭に出陣する陸軍礼武隊。突然、かすりの後ろから大きなハンマーを持った礼武が現れ、天乃原を襲う。その姿に怯えるかすり。彼女には「カナヅチ」に対するトラウマがあった…。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "4630203",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630203",
                    "Titles": {
                        "eng": "Pure Hearted Mischievous Girl",
                        "jpn": "いたずらっ娘純情"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "陸軍礼武隊の隊長であり、天乃原女学院の先生でもある強志朗は、あることを須美さんに相談した。それは「“保健体育”の授業を代わりにやってもらえないか」ということだった。にべなく断れた強志朗は、応急手当から始めようする。そこで女医を目指す綾のおかげでつむぎ、かすり、錦、シュロは振り回されることに…。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "4630204",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630204",
                    "Titles": {
                        "eng": "Like Me",
                        "jpn": "僕のまま"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「僕は男ですから」と、頑なに口にするシュロ。そんなシュロを見て強志朗は、特別授業と称して、我慢大会を敢行。男でも女でもない真剣勝負が行われる。そんな中、「ファーデン騎士団」が来襲し、シュロは敵に「自分が女である」ことを気づかされ、落胆する。しかし、その時強志朗が彼女に言った言葉が彼女を変える…!!"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "4630205",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630205",
                    "Titles": {
                        "eng": "Now, Man, Transform!",
                        "jpn": "今だ漢だ変身だ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「ファーデン騎士団」の本拠地であるエルミタージュ城へと迫った陸軍礼武隊と戦艦天乃原。隊長の犬養強志朗は襲いかかる敵に対し、陸軍礼武隊を指揮する。しかし、礼武の力を使えない彼は、彼女たちより役立てない自分に無力感を感じていた。その時、天乃原に敵の攻撃が命中し、強志朗の姿が煙の中に消えてしまい…。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "4630206",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630206",
                    "Titles": {
                        "eng": "We Depart",
                        "jpn": "俺たちの旅立ち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "真のエルミタージュを目指し、大陸を北へ進む強志朗ら陸軍礼部隊。やがてつむぎの中で大きくなる強志朗への独占欲と恋心…。誰にも邪魔されたくない、二人っきりのひと時を過ごすつむぎと強志朗。そしてつむぎの心にはまた一つ、大切な思い出が増えることに…。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "4630207",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/lime-colored-history-of-war/episodes/4630207",
                    "Titles": {
                        "eng": "More Than a Child, but Less Than an Adult",
                        "jpn": "子供以上、大人未満"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "旅を続ける陸軍礼部隊は荒れた謎の遺跡にたどり着く。綾とかすりの二人だけの探検の途中、かすりが「強志朗のことが好きだ！」と綾に打ち明ける。綾はその言葉に大きなショックを受ける…。嫉妬心を隠してかすりを応援しようとする綾。そして、最後は二人の友情が勝り、ともに敵を打ち砕く…！"
                    },
