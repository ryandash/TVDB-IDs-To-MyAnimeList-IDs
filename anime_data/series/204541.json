                    "ID": "3114021",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114021",
                    "Titles": {
                        "eng": "A Letter from London",
                        "jpn": "ロンドンからの手紙"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パリでの仕官先を探すことにしたダルタニャン。祖父からの言いつけに基づき。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "3114031",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114031",
                    "Titles": {
                        "eng": "The Three Musketeeers of Paris",
                        "jpn": "パリの三銃士"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ダルタニャンは、ミレディーの邪魔をした仕返しを受け、三人の銃士と決闘することになる。トレビル隊長の機転で危機を逃れた四人は、固い友情で結ばれる。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "3114041",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114041",
                    "Titles": {
                        "eng": "D'Artagnan Becomes a Bath Seller",
                        "jpn": "ダルタニャンのお風呂屋さん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "銃士になりそこなったダルタニャンは、ジャンと一緒にお風呂屋の出前の商売を始める。そこでジャンは、アラミスの大変な秘密を知ってしまう。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "3114051",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114051",
                    "Titles": {
                        "eng": "The Trap of the Love Letter",
                        "jpn": "ラブレターの罠"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "王妃に会うために人目を忍んでイギリスの総理大臣バッキンガム公がパリへやってきた。リシュリューの陰謀で危ういところをダルタニャンが助け出す。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "3114061",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114061",
                    "Titles": {
                        "eng": "Big Escape from Paris",
                        "jpn": "パリの大逃走"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "リシュリューが非常線を張り巡らせる中、バッキンガム公をパリから脱出させるため、ダルタニャンは大活躍。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "3114071",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114071",
                    "Titles": {
                        "eng": "D'Artagnan Moving Out",
                        "jpn": "ダルタニャンの引っ越し"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "バッキンガム公の一件を手助けしたアラミスがローシュフォールに捕らえられる。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "3114081",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114081",
                    "Titles": {
                        "eng": "Aramis' Rescue Operation",
                        "jpn": "アラミス救出作戦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今度はリシュリューによりアラミスが正式に逮捕されてしまう。アラミスの暗殺計画を知り、救出に向かうダルタニャンたち。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "3114091",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114091",
                    "Titles": {
                        "eng": "Barefoot Jean's Mother",
                        "jpn": "はだしのジャンのお母さん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "リシュリューは国王と王妃の仲を裂くために、国王にシャルロットという女性を接近させる。ジャンは彼女が自分の母親ではないかと疑う。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "3114101",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114101",
                    "Titles": {
                        "eng": "Hunting in Versailles",
                        "jpn": "狩りはベルサイユで"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ベルサイユの狩りで国王に紹介されたシャルロットは、国王に気に入られるが、彼女には新教徒として逮捕された過去があった。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "3114111",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114111",
                    "Titles": {
                        "eng": "The Broken Sword",
                        "jpn": "折れた剣"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ローシュフォールに狙われたアトスは、暴漢に襲われ、重傷を負ってしまう。ダルタニャンは復讐のため、ある作戦を思い付く。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "3114121",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114121",
                    "Titles": {
                        "eng": "An Admired Musketeer",
                        "jpn": "あこがれの銃士"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "晴れて銃士見習いとなったダルタニャンだったが、今度はバッキンガム公が正式な使者としてやってきた。ミレディの陰謀でまたもや危機に陥るバッキンガム公を助けるダルタニャン。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "3114131",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114131",
                    "Titles": {
                        "eng": "Who is the Spy?",
                        "jpn": "スパイは誰だ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "王妃がバッキンガム公にダイヤの首飾りを渡したことが、リシュリューに知られた。犯人をつきとめると、それはオウムのコピーだった。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "3114141",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114141",
                    "Titles": {
                        "eng": "Escape from Paris",
                        "jpn": "パリ脱出"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "舞踏会までにバッキンガム公からダイヤの首飾りを返してもらうため、ダルタニャン達はイギリスへ向かって旅立った。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "3114151",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114151",
                    "Titles": {
                        "eng": "Dangerous Journey",
                        "jpn": "危険な旅"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "旅篭屋で決闘することになったポルトスだが、それはリシュリューの罠だった。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "3114161",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114161",
                    "Titles": {
                        "eng": "Hurry Up! D'Artagnan",
                        "jpn": "急げ! ダルタニャン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "リシュリュー一味の襲撃でアラミスが負傷した。一方、コンスタンスはミレディの出港許可証を奪い取ることに成功する。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "3114171",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114171",
                    "Titles": {
                        "eng": "One For All",
                        "jpn": "一人はみんなのために"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "負傷したアラミスとダルタニャンは、宿屋で火攻めにされるが羊飼いたちに助けられる。"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "3114181",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114181",
                    "Titles": {
                        "eng": "D'Artagnan's Funeral",
                        "jpn": "ダルタニャンのお葬式"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "三銃士は追っての目をくらますためダルタニャンのニセの葬式を行う。しかし、ミレディだけはだまされなかった。"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "3114191",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114191",
                    "Titles": {
                        "eng": "Passing At The Harbour",
                        "jpn": "港のすれ違い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "カレーの港までたどり着いたダルタニャンだったが、港には出港禁止令が出ていた。そこで出港許可証を持つコンスタンスに再会する。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "3114201",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114201",
                    "Titles": {
                        "eng": "D'Artagnan Crossing The Sea",
                        "jpn": "ダルタニャン海を渡る"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "バッキンガム公のところまでたどり着いたダルタニャンだったが、ミレディーがダイヤを奪おうと立ちはだかる。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "3114211",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114211",
                    "Titles": {
                        "eng": "Queen's Diamond",
                        "jpn": "王妃のダイヤモンド"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ミレディーは舞踏会でアンヌ王妃に化け、ダイヤの一部を奪い取るのに成功した。バッキンガム公とダルタニャンは、港を封鎖してミレディーの出国を食い止める。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "3114221",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114221",
                    "Titles": {
                        "eng": "Crow of the London Tower",
                        "jpn": "ロンドン塔の大烏"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ミレディーは逮捕され、ロンドン塔に送られた。奪われたダイヤの一つを取り返したダルタニャンだったが、もう一粒は大烏に奪い取られてしまう。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "3114231",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114231",
                    "Titles": {
                        "eng": "Escape from London Tower",
                        "jpn": "ロンドン塔脱獄"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ミレディーはロンドン塔の脱獄に成功。首飾りも奪い取る。"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "3114241",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114241",
                    "Titles": {
                        "eng": "Milady's Counterattack",
                        "jpn": "ミレディーの逆襲"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ダルタニャンは再び首飾りを取り返し、フランスへ向かう。"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "3114251",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114251",
                    "Titles": {
                        "eng": "Storm at Dover",
                        "jpn": "ドーバーの嵐"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "イギリスから届いた一粒のダイヤはリシュリューの手に渡り、国王は王妃を疑い始める。一方、ダルタニャンの乗った船は嵐に襲われるが、その船には密航したミレディが乗っていた。"
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "3114261",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114261",
                    "Titles": {
                        "eng": "Grand Ball at Louvre",
                        "jpn": "ルーブルの大舞踏会"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "フランスに戻ったダルタニャンを阻止しようと護衛隊が待ち受けていた。しかし、間一髪で王妃に首飾りを届けることができた。"
                    },
                    "Aliases": []
                },
                "27": {
                    "ID": "3114291",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114291",
                    "Titles": {
                        "eng": "First Date",
                        "jpn": "はじめてのデート"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "銃士に任命されることになったダルタニャン。コンスタンスからはデートの約束をもらい大喜び。しかし、コンスタンスは復讐心に燃えるミレディーに誘拐されてしまう。"
                    },
                    "Aliases": []
                },
                "28": {
                    "ID": "3114321",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114321",
                    "Titles": {
                        "eng": "Milady's Revenge",
                        "jpn": "ミレディーの復讐"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "水攻めに失敗したミレディーは、次の罠を用意する。ダルタニャンとコンスタンスは、崩れた家の下敷きになってしまう。"
                    },
                    "Aliases": []
                },
                "29": {
                    "ID": "3114351",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114351",
                    "Titles": {
                        "eng": "Great Mirror at Notre-Dame",
                        "jpn": "ノートルダムの大鐘"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "コンスタンスは重傷を負ったがダルタニャンは無事だった。今度はノートルダム寺院でミレディーの罠にはまったダルタニャンだったが、遂に彼女を逮捕することができた。"
                    },
                    "Aliases": []
                },
                "30": {
                    "ID": "3114381",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114381",
                    "Titles": {
                        "eng": "Assassination of Buckingham",
                        "jpn": "バッキンガム暗殺"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "すぐに無罪放免されたミレディーは、イギリスへ渡り、バッキンガム公を暗殺する。ダルタニャンは修道院でミレディーと対決。"
                    },
                    "Aliases": []
                },
                "31": {
                    "ID": "3114391",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114391",
                    "Titles": {
                        "eng": "Execution of Milady",
                        "jpn": "ミレディーの処刑"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ミレディーは捕らえられ、処刑されることになった。彼女の過去を知ったダルタニャンは、処刑したことにして逃がす。"
                    },
                    "Aliases": []
                },
                "32": {
                    "ID": "3114401",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114401",
                    "Titles": {
                        "eng": "Mysterious Iron Mask",
                        "jpn": "謎の鉄仮面"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "コンスタンスは半年を経ても記憶が戻らなかった。その頃パリに鉄仮面の男が現れ、盗みを働いていた。"
                    },
                    "Aliases": []
                },
                "33": {
                    "ID": "3114411",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114411",
                    "Titles": {
                        "eng": "Jewel of Actress Nana",
                        "jpn": "女優ナナの宝石"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "人気女優ナナ・ベルナールの宝石をドレスに縫い付けるよう依頼されたボナシューだったが、そこにも鉄仮面が現れ、ドレスは奪われてしまった。"
                    },
                    "Aliases": []
                },
                "34": {
                    "ID": "3114421",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114421",
                    "Titles": {
                        "eng": "Arrest Iron Mask",
                        "jpn": "鉄仮面を逮捕せよ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "鉄仮面に屋根から落とされたコンスタンスは記憶を取り戻した。ボナシューは宝石を弁償するために家を売り、引越しすることに。"
                    },
                    "Aliases": []
                },
                "35": {
                    "ID": "3114431",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114431",
