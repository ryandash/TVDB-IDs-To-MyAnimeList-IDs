                    "Titles": {
                        "eng": "An Elephant in Paris",
                        "jpn": "象のいるパリ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "舞台は１７世紀のフランス。ガスコーニュに住む下級貴族の息子・ダルタニャンは、領主の…"
                    },
                    "Aliases": []
                },
