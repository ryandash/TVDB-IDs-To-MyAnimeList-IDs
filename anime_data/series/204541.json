                    "Summaries": {
                        "eng": "",
                        "jpn": "鉄仮面らは、ニセの鉄仮面として牢の中にいる国王を早く処刑しようと画策していた。ダルタニャン達は、ニセ鉄仮面の正体を知る。"
                    },
                    "Aliases": []
                },
                "45": {
                    "ID": "3114541",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114541",
                    "Titles": {
                        "eng": "Aramis' Secret",
                        "jpn": "アラミスの秘密"
                    },
                    "Summaries": {
