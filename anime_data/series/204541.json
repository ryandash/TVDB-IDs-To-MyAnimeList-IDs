                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/anime-sanjushi/episodes/3114451",
                    "Titles": {
                        "eng": "Famous Detective D'Artagnan",
                        "jpn": "名探偵ダルタニャン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "マンソンは園遊会で国王が着る服のデザインを盗み、何かたくらんでいる様子。ボナシューは、マンソンの肩のこぶが盗賊ラクダに似ていることを発見。"
                    },
                    "Aliases": []
                },
                "38": {
                    "ID": "3114461",
