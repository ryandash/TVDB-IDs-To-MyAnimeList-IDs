                    "Titles": {
                        "eng": "Give Up!",
                        "jpn": "ギブアップ！"
                    },
                    "Summaries": {
                        "eng": "While Sakura's inability to escape the Boston Crab causes her to rack up a record-breaking streak of losses, Sweet Diva is at the top of the charts. Feeling as though she can no longer meet her fans expectations in either realm, Sakura is about to quit Berserk and go back to being a normal girl when fellow wrestler Misaki shows up to give her some special training.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
