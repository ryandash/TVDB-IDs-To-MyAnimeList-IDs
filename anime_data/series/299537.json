                    "Titles": {
                        "eng": "Summer Is for Having Fun!",
                        "jpn": "夏はやっぱり遊びたい！"
                    },
                    "Summaries": {
                        "eng": "Summer is here, and as a break from studying, the three girls go to the beach. The next thing they know Megumi isn't with them...",
                        "jpn": "夏本番。受験勉強の息抜きに3人で海にやってきたしゅりたち。いつも通りはしゃいでいためぐみだが、ふと気がつくと姿がみえなくて。"
                    },
                    "Aliases": []
                },
