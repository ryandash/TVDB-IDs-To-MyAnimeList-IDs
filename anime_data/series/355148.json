            "# Episodes": 50,
            "Episodes": {
                "1": {
                    "ID": "6895092",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/6895092",
                    "Titles": {
                        "eng": "Episode 1",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Sixteen years after his death, Wei Wuxian returns to life in Mo Xuanyu's body and is immediately faced with a group of young disciples from the Gusu Lan Sect and an evil spirit haunting his summoner's abusive family.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "6895093",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/6895093",
                    "Titles": {
                        "eng": "Episode 2",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "After leaving Mo Village, Wei Wuxian runs afoul of Jiang Cheng and Jin Ling, and summons Wen Ning during his investigation of the soul-stealing Goddess Statue. As the suspicious Jiang Cheng attempts to apprehend Wei Wuxian, Lan Wangji steps in to announce that he will bring \"Mo Xuanyu\" back to the Cloud Recesses with him.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "6905089",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/6905089",
                    "Titles": {
                        "eng": "Episode 3",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Wei Wuxian recalls the past, when he, Jiang Cheng, and Jiang Yanli attended training at the Cloud Recesses together, and he first encountered Lan Wangji. Meanwhile, the Qishan Wen Sect continues to explore Demonic Cultivation.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "7254015",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254015",
                    "Titles": {
                        "eng": "Episode 4",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Sect Leader Lan Xichen and Meng Yao become fast friends at the opening ceremony, although things nearly turn violent when two Qishan Wen disciples, Wen Ning and Wen Qing, also arrive to attend the training. During their studies, Wei Wuxian's curiosity and mischievous antics earn him the ire of the strict Lan Qiren.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "7254016",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254016",
                    "Titles": {
                        "eng": "Episode 5",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Wei Wuxian and Jiang Cheng become fast friends with Nie Huaisang, and Wei Wuxian continues to tease the taciturn Lan Wangji, who watches over his punishments. Later, a hunt for water ghouls reveals a waterborne abyss driven towards Gusu from Qishan.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "7254021",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254021",
                    "Titles": {
                        "eng": "Episode 6",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Lan Wangji catches Wei Wuxian sneaking alcohol with Nie Huaisang and Jiang Cheng. Although Wei Wuxian uses cultivation to force Lan Wangji to drink with him, Lan Wangji submits himself to punishment along with the rest. When the two use the cold springs to heal, they discover an underground cavern and meet the spirit of Lan Yi.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "7254022",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254022",
                    "Titles": {
                        "eng": "Episode 7",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Lan Yi explains the importance of finding and sealing all pieces of the Yin Metal again before her spirit departs. As their time in the Cloud Recesses draws to an end, Wei Wuxian fights Jin Zixuan after the latter insults his fiancee Jiang Yanli. Their fathers are summoned and decide to end the engagement between the two.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "7254023",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254023",
                    "Titles": {
                        "eng": "Episode 8",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Wei Wuxian decides to accompany Lan Wangji to track down the fragments of Yin Metal. Nie Huaisang joins them along the way, but Wen Chao informs Wen Qing that he plans to use the Goddess Statue to hinder their search. At night, Wei Wuxian, Lan Wangji, and Nie Huaisang find themselves trapped in the temple of the Goddess Statue while soulless villagers attempt to break down the temple door.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "7254024",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254024",
                    "Titles": {
                        "eng": "Episode 9",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Wei Wuxian, Lan Wangji, and Nie Huaisang are saved by Wen Qing, who uses music to draw the villagers – her family – away from the temple. Jiang Cheng arrives to help his brother, and Lan Wangji and Wei Wuxian hunt the Qishan Wen Sect's Dire Owl to restore the souls of Wen Qing's family.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "7254026",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/7254026",
                    "Titles": {
                        "eng": "Episode 10",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Nie Huaisang departs to fetch help from Qinghe, and Lan Wangji, Wei Wuxian, and Jiang Cheng find the Yueyang Chang Sect massacred. Xiao Xingchen and Song Lan arrive to apprehend the culprit, Xue Yang, though they fail to find the Yin Metal he used. Meng Yao and Nie Huaisang escort Xue Yang to Qinghe, but Wen Chao attacks the next day. During the fight, Xue Yang escapes, and Nie Mingjue is horrified to see Meng Yao murder his top general. At the last moment, however, Meng Yao uses his own body to shield Nie Mingjue from a killing blow, and Wen Chao agrees to depart if Nie Huaisang is sent to the Qishan Wen Sect's indoctrination.",
                        "jpn": null
                    },
                    "Aliases": []
                },
