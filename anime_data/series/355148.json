                "22": {
                    "ID": "8392591",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-untamed/episodes/8392591",
                    "Titles": {
                        "eng": "Fatal Journey",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "When the Nie Clan of Qinghe faces the danger of the Blades Shrine, the elder brother Nie Mingjue leads his younger brother Nie Huaisang to fight for repairing the shrine, and finally protects the family. In the story, the two brothers joins hands to resist difficulties. During the adventure, there are contradictions between them. Nie Mingjue dislikes his younger brother’s timidity, and Nie Huaisang accuses Nie Mingjue’s arbitrariness. Although there are contradictions, in the face of danger, Nie Mingjue tries to sacrifice himself to save Nie Huaisang, and Nie Huaisang never abandons his brother. All these help two brothers step towards reconciliation.",
                        "jpn": null
                    },
                    "Aliases": [
                        "The Untamed: Fatal Journey"
                    ]
                }
            }
        },
