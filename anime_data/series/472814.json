    "Titles": {
        "eng": "Eat Around the Mortal World",
        "jpn": null
    },
    "Summaries": {
        "eng": "Eat Around the Mortal World (神在囧途) follows a divine master who accidentally falls into the mortal realm and loses all his magical powers. After spending millennia trying to regain ascension, he discovers the first step is starting over on earth. While attempting traditional cultivation, an unexpected encounter with a chef leads him to a new path: gaining strength through the pleasures of food. As he travels the world tasting delicacies and growing stronger with every meal, he realizes that eating itself has become his way to power and invincibility.",
        "jpn": null
    },
    "Aliases": [
        "Shen Zai Jiong Tu",
        "You are just a mortal, call me God! Lord! Master!"
    ],
