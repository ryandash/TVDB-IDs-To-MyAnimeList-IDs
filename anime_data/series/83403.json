            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "396779",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396779",
                    "Titles": {
                        "eng": "Departure of Fate",
                        "jpn": "“運命”の旅立ち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "『メーテルレジェンド』から数年後。メーテルの母親である「ラー・アンドロメダ・プロメシューム」は機械化帝国の女王として君臨している。若きメーテルは999号に乗り、生れ故郷ラーメタルを目指す。ラーメタルに向かう途中、999号は何者かに攻撃され、その車中、メーテルは整備士の少年ナスカに出会う・・・"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "396780",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396780",
                    "Titles": {
                        "eng": "Nazca's Passion",
                        "jpn": "ナスカの“熱情”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "数年ぶりに故郷ラーメタルに還ったメーテル。機械化されてしまったはずの母親・プロメシュームは人間の温もりを取り戻していた。しかし・・・"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "396781",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396781",
                    "Titles": {
                        "eng": "The Night Before the Revolution",
                        "jpn": "“革命”前夜"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "惑星ラーメタルの女王としての記憶を受け継いだメーテル。「果てしなき時の流れを生きてきた一族の記憶を受け継ぎ、わたしはこの星の女王となりましょう」。ナスカはプロメシュームの秘密を見てしまった。「メーテル！そこにいるのはきみの母親じゃない。オレは見たんだ！」"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "396782",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396782",
                    "Titles": {
                        "eng": "Rhapsody in Gold",
                        "jpn": "黄金色の“ラプソディ”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "プロメシュームの命令によりレオパルドの艦隊がデスシャドウ号に攻撃、逃げてゆくデスシャドウ号。傷ついたデスシャドウ号に対してレオパルドの艦は全くの無傷。トチローがハーロックにかわり操舵を握り、無事、レオパルドの艦隊から逃げ切るのだが・・"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "396783",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396783",
                    "Titles": {
                        "eng": "Promethium's Magic Flute",
                        "jpn": "プロメシュームの“魔笛”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "機械化が進むラーメタルの状況を悲しむメーテルは、黒猫に導かれ地下の最下層部に導かれる。そこにいたのは、かつてのラーメタル支配者ラーレラであった。その頃、地上ではプロメシュームの命令により、残った人々が強制的に機械化されようとしていた。それを阻止すべく先頭に立って戦うナスカ、その状況を見たレオパルドはついに行動を起こす。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "396784",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396784",
                    "Titles": {
                        "eng": "Laurela's requiem",
                        "jpn": "ラーレラの“レクイエム”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "全ての人間を機械化しようとするプロメシュームに対して、空間機甲団を率いるレオパルドが反旗を翻した。機械化人に対する反乱が始まった。彼はメーテルを捕らえ、その命と引き替えにプロメシュームをおびき出そうとする。突きつけた銃を発砲しようとした瞬間、プロメシューム自らがその姿を現した。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "396785",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396785",
                    "Titles": {
                        "eng": "The Way to My Homeland",
                        "jpn": "“わが祖国”への道"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "生身の人々を救うため、ラーレラは惑星ラーメタルのコアの分離をメーテルに指示した。メーテルがレバーを入れれば惑星ラーメタルは崩壊。だがその前にプロメシュームが立ちふさがる。エメラルダスは、母星に急行し、ハーロックとトチローもデスシャドウ号の舳先を向ける。そして遂に、メーテルは剣の切先をプロメシュームに向ける・・・"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "396786",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396786",
                    "Titles": {
                        "eng": "A Funeral March for Mother",
                        "jpn": "母への“葬送行進曲”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "プロメシュームに寄り添い逃亡を計るメーテル。エメラルダスからまさかの裏切りを告げられ、ハーロックやナスカも動揺を隠せない。トチローの制止も聞かずに、一人母を追うエメラルダスにメーテルが対峙する。崩壊した母星の一隅で激しくサーベルを交える姉妹をプロメシュームが妖しく見つめる・・・"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "396787",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396787",
                    "Titles": {
                        "eng": "La-Metal's Spring",
                        "jpn": "ラーメタルの“春”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "本体から分離したコア・新星ラーメタルは、生体エネルギーとなったラーレラの力で、恒星ユーフラテスの惑星ヘビーメルダーの重力圏に向かっていた。永遠に続くと思われた冬が終わる。訪れる春を思い人々が胸を躍らせる中、メーテルとエメラルダスは、自分たちの手で倒したプロメシュームの影を感じていた。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "396788",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396788",
                    "Titles": {
                        "eng": "Lightning Strikes the Titan",
                        "jpn": "電光の“巨人”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "プロメシュームの気配を感じて宇宙を行くエメラルダスが、停止した999号を発見する。呼びかけに一切反応しない999号に彼女が乗り込むと、窓のシャッターが一斉に閉まった。次の瞬間、爆走を始める999号。捕らわれたエメラルダスを追って、メーテル、ハーロック、トチローを乗せたデスシャドウ号が急ぐ。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "396789",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396789",
                    "Titles": {
                        "eng": "Eroica Leopard",
                        "jpn": "“英雄”レオパルド"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "空間機甲団を率いるレオパルドは、ハーロック、エメラルダス、ナスカそしてメーテルと共に、プロメシュームの艦隊を撃破した。歓喜するラーメタルの人々に迎えられた彼を生き残った機械化兵の銃が撃ち抜く。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "396790",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396790",
                    "Titles": {
                        "eng": "Song of Wayfarer for the Heroes",
                        "jpn": "勇士たちの“別れの曲”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "トチローが突き止めたプロメシュームの拠点・惑星プロメシュームは、自己再生する機械細胞に覆われた機械化惑星だった。そこには完全なる復活を遂げた女王とメーテルと呼ばれる機械化人の姿があった。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "396791",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/space-symphony-maetel/episodes/396791",
                    "Titles": {
                        "eng": "The Far Away New World",
                        "jpn": "遥かなる“新世界”"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メーテルは、惑星プロメシュームの中枢を構成するネジになり、内側から惑星を破壊しようと決意する。ナスカの艦は1本のネジを乗せ、ハーロック、トチロー、エメラルダスが見守る中、惑星へ乗り込んでいく。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}