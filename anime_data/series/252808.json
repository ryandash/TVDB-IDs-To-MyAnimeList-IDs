            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "4188286",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4188286",
                    "Titles": {
                        "eng": "Sleep",
                        "jpn": "睡眠／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「睡眠」\r\n8時間寝たのに眠くなっちゃうピクピク。\r\n「どうしたら眠くなくなるんだろうね？」\r\nピクピクの疑問にシルシルとコロコロが答えていくのだが・・・？\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n「メンタルとタイムのルーム」で魔法を使った遊びを始めると・・・？\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこには『超兄貴』の姿が・・・！"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "4190940",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4190940",
                    "Titles": {
                        "eng": "Little Happiness",
                        "jpn": "小さな幸せ／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「小さな幸せ」\r\n四つ葉のクローバーを見つけて、上機嫌のピクちゃん！\r\n「小さな幸せ」を3人で話しているうちに話はどんどん深くなり・・・\r\n3人にとって、妖精にとって、「小さな幸せ」とは何なのか？\r\nそして、最後にはピクちゃんの涙が・・・\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n「メンタルとタイムのルーム」で『カラダ動かす系のこと』を考えてみた！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこには巨大な鶏が・・・！\r\nまさかの『滲み出るエロス』！？"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "4194664",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4194664",
                    "Titles": {
                        "eng": "Rumours",
                        "jpn": "ウワサ／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「ウワサ」\r\nくしゃみが止まらないピクちゃん。\r\nくしゃみをすると誰かがウワサをしているというウワサが・・・\r\n実しやかに流れるピクちゃんのウワサとは！？\r\nその真実がここに！！\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n前回の反省を生かし、今度こそ『新しい競技』を考えてみる！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこには奴が・・・！\r\nこのテンションは如何に！？"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "4417945",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417945",
                    "Titles": {
                        "eng": "Tears",
                        "jpn": "ナミダ／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「ナミダ」\r\n昨日の夜に泣いて、目が腫れちゃったピクちゃん。\r\nナミダって、悲しい時も、嬉しい時も流れる不思議なもの。\r\nそんなナミダの話から…\r\nある壮大な陰謀が発覚する！！\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は3人で『RPG』の世界へ！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこには激しいバトルを繰り広げる男が二人！"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "4417946",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417946",
                    "Titles": {
                        "eng": "Waiting Time",
                        "jpn": "待ち時間／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「待ち時間」\r\n集合に10分遅れてきたシルちゃん。\r\nいつも遅刻しちゃうのには驚愕の深い理由が…\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は？\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこには…！"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "4417947",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417947",
                    "Titles": {
                        "eng": "Previously on Gudaguda Fairies",
                        "jpn": "前回までのgdgd妖精s／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「前回までの・・・」\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回はパーティーゲームで楽しもう！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこにはあの…！\r\nコロコロ怒り心頭！？"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "4417948",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417948",
                    "Titles": {
                        "eng": "Everyday Good Deed",
                        "jpn": "一日一善／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「一日一善」\r\n道に落ちていた空き缶を拾って、ゴミ箱に捨ててきたシルシル。\r\n「一日一善」に目覚めたシルシルはピクピクとコロコロに相談するのだが…\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は巨大装置で遊んでみよう！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、そこには？"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "4417949",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417949",
                    "Titles": {
                        "eng": "Sayings",
                        "jpn": "ことわざ／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「ことわざ」\r\nピクピクがお姉ちゃんとレストランに行った話をしていると、\r\n突然シルシルが叫ぶ…「待ってました、ピクちゃん！」\r\nシルシルが待っていたものは？\r\n「ことわざ」を題材とした、コロコロとシルシルのユニゾンを見逃すな！\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は「グダグダ生放送」にチャレンジ！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」？"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "4417950",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417950",
                    "Titles": {
                        "eng": "Hobby",
                        "jpn": "趣味／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「趣味」\r\n『趣味』がないピクちゃんとシルちゃんは\r\nコロちゃんに相談しながら、新しい『趣味』を探すことに。\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は魔法で憧れのおうちを建ててみよう！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと…？\r\nコロちゃんに最大の危機が！"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "4417951",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417951",
                    "Titles": {
                        "eng": "Last Three Days",
                        "jpn": "最後の3日／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「最後の一日」\r\nもしこの世が明々後日に滅びるとしたら…妖精たちは最後に何をするのか？\r\nそんなお話。\r\n\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は魔法で「ドッキリ」を仕掛ける事に！\r\n\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと…？\r\n今回はみんなハイテンション♪"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "4417953",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/gdgd-fairies/episodes/4417953",
                    "Titles": {
                        "eng": "Previously on Unreleased Fairies",
                        "jpn": "前回までの未公開gdgd妖精s／メンタルとタイムのルーム／アフレ湖"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「前回までの未公開gdgd妖精s」\r\nまさかの未公開動画。\r\n「メンタルとタイムのルーム」\r\n魔力の弱い３人でも、自由に魔法を使える特殊な部屋\r\n今回は猛獣に襲われた時の危機回避マニュアルを作成！\r\n「アフレ湖」\r\n違う世界が見える「アフレ湖」を覗くと、また…？\r\nあの女性が再登場！？"
                    },
                    "Aliases": []
                },
