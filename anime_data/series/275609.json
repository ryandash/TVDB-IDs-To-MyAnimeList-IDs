            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "4720046",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4720046",
                    "Titles": {
                        "eng": "A Quiet Beginning",
                        "jpn": "静かなる始動"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "2013年のクリスマス、仙台市内の小さな野外ステージでデビューを飾った、７人組の新人アイドルユニット”WakeUp,Girls！”。ところが事務所の社長、丹下は会社の金を持ち逃げして行方不明中。残されたマネージャーの松田は途方に暮れ、WUGのメンバーもこのままアイドルを続けられるのか不安のままに過ごしていた。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "4720048",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4720048",
                    "Titles": {
                        "eng": "Girls Standing Onstage",
                        "jpn": "ステージを踏む少女たち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "松田が連れてきたプロデューサーの須藤によって、なんとか芸能活動を続けられることになったWUG。ところがその仕事内容は、きわどい水着を着させられての健康ランドでの営業というもの。明らかな胡散臭さに不信感を抱きつつ、それでも覚悟を決めステージに上がるのだが、ついには宴会の接客から王様ゲームまで強要される。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "4755220",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755220",
                    "Titles": {
                        "eng": "Kindest",
                        "jpn": "一番優しく"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "行方不明だった丹下社長がグリーンリーヴズに戻り、ようやくWUGは本格的に活動を再開。早速社長が持ってきた仕事は、バラエティ番組の天気予報とグルメ情報のミニコーナーだった。二組に分かれてそれぞれのコーナーを担当することになったのだが、中でもグルメチームの実波がその食べっぷりを発揮して絶賛される。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "4755221",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755221",
                    "Titles": {
                        "eng": "Scandal",
                        "jpn": "スキャンダル"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "テレビに続いて短い放送時間ながらもラジオの冠番組も決定。更には２曲目の制作にも取り掛かることになり、一歩ずつ順調にアイドルとしての道を歩み始めたWUG。だが、その活動の様子が徐々に世間に広まっていくにつれ、アイドルとして復帰した真夢に対する、決して好意的ではない話題も人々の間にあがり始めていた。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "4755222",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755222",
                    "Titles": {
                        "eng": "Heaven or Hell",
                        "jpn": "天国か地獄か"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "いよいよ2曲目が完成して再びライブを行うことになったWUG!だったが、\r\nなんとその日はI-1club仙台シアターのこけら落とし公演当日でもあった。\r\n街中がI-1club一色に染まり、圧倒的な力の差を見せつけられる中、\r\nそれでも真夢たちは精一杯自分たちなりのレッスンに励み、地道にライブの宣伝をしていくのだった。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "4755223",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755223",
                    "Titles": {
                        "eng": "Not Yet",
                        "jpn": "まだまだだよ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "突然グリーンリーヴズに接触してきた音楽プロデューサーの早坂。\r\n彼はI-1clubをスターダムに押し上げた立役者の１人であり、現在もその活動に関わりながら、\r\nなんとWUG!をプロデュースしたいと申し入れてきた。\r\nその条件としてWUG!に関する全権が早坂に委ねられ、真夢たちにこれまでになく厳しいレッスンが課せられる。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "4755224",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755224",
                    "Titles": {
                        "eng": "Wonderful Friends!",
                        "jpn": "素晴らしき仲間たち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "早坂は藍里にWUG!を辞めさせると宣言し、それを承諾できなければ全員をクビにすると、\r\n真夢たちに選択を迫る。その場で早急な結論を求められ、焦る心から言い争いとなってしまうメンバー。\r\n仲間を切り捨ててまでWUG!の活動を続けるべきなのか、アイドルとしての厳しさを突きつけられた６人が\r\n出した答えとは……？"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "4755225",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755225",
                    "Titles": {
                        "eng": "Commotion",
                        "jpn": "波乱"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "全国のご当地アイドルがナンバーワンを競い合う、年に一度の大イベント『アイドルの祭典』に、\r\nWUG!もエントリーすることになった。優勝チームは大手レコード会社とメジャー契約を結べるとあって、\r\nメンバーのやる気も高まる。ところが盛り上がる一同を横目に、菜々美は一人浮かない表情を見せていた。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "4755226",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755226",
                    "Titles": {
                        "eng": "Living Here",
                        "jpn": "ここで生きる"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "I-1club時代の過去を語ろうとしない真夢に対する佳乃のわだかまりがついに噴き出し、\r\nチームに暗雲が立ち込める中、夏夜の提案により合宿を行うことになったWUG!。\r\n宿泊先は彼女の親戚が経営する、気仙沼漁港の程近くに建つ旅館。\r\n仲間と共に久しぶりの港町に向かう夏夜は、その胸に誰にも明かさぬある想いを秘めていた。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "4755227",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755227",
                    "Titles": {
                        "eng": "Gateway to Success",
                        "jpn": "登竜門"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "いよいよ迫る『アイドルの祭典』東北ブロック予選大会。\r\n正統派から個性派まで様々なご当地アイドルユニットがエントリーされる中、\r\n自分たちを印象付ける「WUG!らしさ」とは何かと丹下社長に問われる真夢たち。\r\nそれぞれが頭を悩ませ、周囲の人々にも意見を求めるのだが、その答えはなかなか見つからない。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "4755228",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755228",
                    "Titles": {
                        "eng": "Idol Rhapsody",
                        "jpn": "アイドル狂詩曲（ラプソディー）"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "予想外の事態により、時間の無い中で急遽新曲を覚えなければいけなくなったWUG！。\r\nしかもそれは、歌もダンスも今までの曲とは比べ物にならないほどハイレベルなものだった。\r\nそれでも初のセンターを務めることになった佳乃を中心として、7人は心を1つにレッスンに励むのだった。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "4755229",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/wake-up-girls/episodes/4755229",
                    "Titles": {
                        "eng": "No Regrets in This Moment",
                        "jpn": "この一瞬に悔いなし"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ステージ開始の時間が近づく中、リハーサルで佳乃の様子がおかしいことに気づく真夢たち。\r\n本番直前でのまさかのトラブル発生に、焦りを隠せないWUG！メンバー。\r\nデビューから1年、共に励ましあい時にぶつかりながら、幾つもの壁を乗り越えてきた7人。\r\nアイドルとして、仲間として、大きな決断を迫られる。"
                    },
                    "Aliases": []
                }
            }
        },
