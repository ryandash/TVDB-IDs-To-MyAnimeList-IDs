        "2": {
            "ID": "821156",
            "URL": "https://thetvdb.com/series/bananya/seasons/official/2",
            "Titles": {
                "eng": "Bananya and the Curious Bunch",
                "jpn": "ばなにゃ ふしぎななかまたち",
                "deu": "Bananya and the Curious Bunch",
                "pt": "Bananya and the Curious Bunch"
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "deu": "Noch gibt es viele mysteriöse Wesen in unserem Universum, die von uns noch nicht entdeckt worden sind. Auf einem weit entfernten Planeten existiert eine besondere Spezies, genannt Bananyas. Von was für einer Art von Planet kommen sie und was für ein Leben führen sie? Und was wäre, wenn sie eines Tages ihren Traum verwirklichen zur Erde aufzubrechen?",
                "pt": null
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "7312624",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7312624",
                    "Titles": {
                        "eng": "Bananya and His Friends, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Another day has begun. At the foot of a cat-shaped mountain sits a field of banana trees. As the bananas grow, out of them pop mysterious creatures that look a bit like cats and a bit like bananas... the bananyas! This is the rather bizarre story of a curious bunch of friends... nya!",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "7394702",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7394702",
                    "Titles": {
                        "eng": "Bananya and the Meowteors, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Meowteors rain down from the big round thing in the sky, and the bananyas collect them. They then carry all the meowteors to the elder's house. The elder grants permission, and the bananyas begin to... nya?!",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "7394708",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7394708",
                    "Titles": {
                        "eng": "Bananya and Droopy-eared Bananya, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "A meowteor twinkles as it falls to the ground. It bumps into a small banana... and out of the banana pops the adorable Droopy-eared Bananya! All of the bananyas fall in love with her cuteness, nya...",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "7394710",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7394710",
                    "Titles": {
                        "eng": "Bananya and Ninja Training, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Bananya is in the mood to do ninja things after reading a ninja manga, so he and Droopy-eared Bananya become Ninja Bananya's disciples. The run through fields, dive underwater, fly through the sky... but then all the other bananyas suddenly show up. Nyan-nyan!",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "7394714",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7394714",
                    "Titles": {
                        "eng": "Bananya and the Mysterious Mansion, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Bananya and Droopy-eared Bananya are walking in the mountains when it starts to rain, so they take shelter in a mysterious mansion. Inside, they encounter the ominous figure of Scientist Bananya. They run away in shock, but something even more frightening awaits... Nyaaaa!",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "7429121",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429121",
                    "Titles": {
                        "eng": "Bananya and the Robot Cat, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Bananya and Droopy-eared Bananya are enjoying some fishing when, to their surprise, they fish up a robot cat! They're both thrilled to have a new friend. They play hide-and seek, take catnaps, and even run through a field of flowers together! But then the robot cat stops moving... Nya, nya...",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "7429125",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429125",
                    "Titles": {
                        "eng": "Bananya and Music, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "The whole village has turned out for a music festival. Appearing on stage is... On guitar, Emo Bananya! On drums, Metal Bananya! And on vocals, Vampire Bananya! The festival reaches its climax as everyone gets into their hardcore rhythms, but then it suddenly starts to rain... Nya♪ Nya♪ Nya♪ Nya♪",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "7429127",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429127",
                    "Titles": {
                        "eng": "Bananya and Chatting, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "The cat-shaped mountain blows its top again, signaling the arrival of another meowteor. It turns out to be... a device that translates the bananyas' language??? Just what do the bananyas talk about every day, anyway? Fantastic!",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "7429129",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429129",
                    "Titles": {
                        "eng": "Bananya and the Festival, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Today is the annual festival. Many stalls have been set up, and everyone's having a great time! Then comes the long-awaited Bon dance, and finally, an extravagant fireworks show! But the ones launching the fireworks are... the Zombie Bananyas?! Nyaaa nya-nyaaa!",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "7429130",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429130",
                    "Titles": {
                        "eng": "Bananya and the Round Thing of Dreams, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Another meowteor falls from the sky. As he approaches it, Bananya realizes that it looks just like the round thing in the sky. He immediately takes it to the elder, who shows him many pictures of the round thing in the sky, much to Bananya's delight. But before he realizes it... nyaaa... zzz",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "7429132",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429132",
                    "Titles": {
                        "eng": "Bananya and the Lost Item, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "As Bananya and Droopy-eared Bananya are walking alongside the river, a strange wand floats their way. They ask the elder about it, and he says it belongs to the legendary Rainbow Bananya. So they set out to return the wand to its owner, but... nyanya?",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "7429133",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7429133",
                    "Titles": {
                        "eng": "Bananya and the Legendary Bananya, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Bananya and Droopy-eared Bananya meet the legendary Rainbow Bananya... along with her sister, Night Rainbow Bananya! To thank them for returning her wand, Rainbow Bananya says she'll grant any wish for them... What will Bananya wish for?! Nyaaaaaa☆彡",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "7508141",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/bananya/episodes/7508141",
                    "Titles": {
                        "eng": "Bananya and the Big Round World, Nya",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "Bananya looks around. What is this place??? It looks like the legendary Rainbow Bananya has used her powers to send him to the big round thing in the sky, just like he always dreamed of! And there he meets... Oh my nya!",
                        "jpn": null
                    },
                    "Aliases": []
                }
            }
        },
        "3": {
            "ID": "2147375",
            "URL": "https://thetvdb.com/series/bananya/seasons/official/3",
            "Titles": {
                "eng": "Bananya Around the World",
                "jpn": "ばなにゃ あらうんど ざ わーるど",
                "pt": "Bananya Around the World"
            },
            "Summaries": {
                "eng": "Bananya returns! The mysterious cat who lives inside a banana is back for a new adventure when a ball of light appears. After the ball flashes, a new cat named Baby Sweet emerges. The two quickly become friends and set off on a grand adventure to discover new and exciting places around the world. Join the new friends on their journey!",
                "jpn": null,
                "pt": "Os gatinhos que vivem em bananas estão de volta para viajar ao mundo nesta nova temporada!"
            },
