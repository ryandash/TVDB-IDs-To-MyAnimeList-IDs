        "2": {
            "ID": "2223166",
            "URL": "https://thetvdb.com/series/tea-dogs/seasons/official/2",
            "Titles": {
                "eng": null,
                "jpn": "お茶犬〜「ほっ」とものがたり〜"
            },
            "Summaries": {
                "eng": null,
                "jpn": "今回の「お茶犬」はお茶犬たちが、街角や公園、ベランダ、リビングに現れて、町の人たちと交流する姿を描く、心和むアニメーション。忙しい毎日に紛れて忘れていた、大切なことを思い出させてくれる、そんな”ちょっと良いお話”。"
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "11524586",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524586",
                    "Titles": {
                        "eng": null,
                        "jpn": "あなたの町にお茶犬はいますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "「今日はマナの誕生日なのに、何でパパは帰ってこないの！」ママと喧嘩して家を飛び出したマナは、可愛いけどちょっと不思議な子犬、緑茶犬リョクと出会います。一緒にいるだけで、マナの心を“ほっと”させたリョクは、茶野家の家族みんなを幸せにする不思議な力を持っていました"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "11524587",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524587",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、空を見上げてますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "どんより曇る空と同じく、今日のママはお疲れ気味。ため息ばかりのママを、心配するリョク・・・。すると「ピン!」とリョクの尻尾が立ちました。何かひらめいたようですよ。スルスルとリョクが、ベランダの戸を開くと、気持ちのいい風が吹き込んで・・・"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "11524588",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524588",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、手紙を書いてますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "喫茶店「カサブランカ」のマスターは10年間出すあてのない手紙を書いています。 どんどんコーヒー缶の棚に手紙が溜まっていくの見たコーヒー犬・カフェは、ある夜、その手紙をどこかへくわえて、トコトコ歩いていきます。その数日後、『カサブランカ』に、やってきたのは・・・。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "11524589",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524589",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、意地張りすぎていませんか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "河川敷でサッカーをするいつも仲良しのソラと林君。でも、シュートしたボールが、草むらに紛れて行方不明になっちゃった!『パパからもらった大事なボールなのに・・・』ボールを捜すソラを置いて、悪いと思いつつも面倒臭くなって帰ってしまう林君でしたが・・・。 紅茶犬アールが気づかせてくれる、なかなか言えない\"あの言葉\"の力。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "11524590",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524590",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、感動してますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "烏龍茶犬・ロンが住む『ロンロン軒』は、いつも大忙しの中華屋さんで、ご主人夫婦は、ラーメンやチャーハンを作り続ける毎日。可愛い赤ちゃんはいつも、ロンと一緒に遊んでいます。でも、ある日、ロンが赤ちゃんと一緒に遊んでいると、ビックリすることが起こります。いつも同じに見える毎日も、少しづつ何かが変わっていっている。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "11524591",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524591",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、田舎に帰ってますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "明日から春休み!・・・なのに、通知表をママに見せたら怒られて、落ち込んでしまったソラ。 帰ってきたパパも通知表を見て「う~ん」と厳しい顔。すると突然、リョクが「クシュン!」とくしゃみをひとつしました。いい香りのするくしゃみの中に、パパが見たのは、優しくて懐かしいあの場所の風景でした。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "11524592",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524592",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、雨宿りしたことあります?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "おつかい帰りのチャイの鼻先にポタッと水滴。みるみるうちに大雨です。チャイが駄菓子屋の店先で雨宿りしていると、そこに女子高生も飛び込んできました。佇む女子高生と犬一匹。すると「お前、帰るとこあるの？」と、チャイに話しかける彼女。なんだか、わけあり、のようです。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "11524593",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524593",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、冒険していますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ママにお使いを頼まれたマナと緑茶犬リョクは、いつもとは違う道を通って帰ろうとするのですが、そこには、どかっと道の真ん中で眠る怖そうなブルドッグ\"かおる\"がいるではないですか! 足がすくむマナを見たリョクは、お手本を示そうと、かおるの脇を通ろうとするのですが・・・"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "11524594",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524594",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、頑張りすぎてませんか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "路地裏の広場の土管の中で暮らす、お気楽な麦茶犬・ムハ。 毎朝、元気な新聞配達の少年の音で目覚めます。あれ、でも今日は、ちょっと違う。フラフラしながら自転車をこいで・・・危ないっ! あ~あ電柱に激突して気を失っちゃった。このままだと、夜明けまでに新聞が配れなくて怒られちゃう・・・ムハ、どうする?"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "11524595",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524595",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、素敵な思い出つくってますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "マナの大好きな健ちゃんが、引っ越してしまいました。悲しくて悲しくて、泣いてばかりいるマナのところへ、健ちゃんの家に住むハーブ茶犬・ハナがやってきます。 リョクと一緒にスコップをくわえて、路地裏の公園にある大木の根元にマナを連れていくハナ。そう、そこには、マナと健ちゃんの大切な\"ある物\"が埋まっていたのです"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "11524596",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524596",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、忙しいって言い過ぎてませんか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "いつも“忙しい”が口癖のパパ。今夜も一人、テーブルで遅い夕飯を食べていると、まだ起きていたマナがダダをこねます。「パパ、次の日曜日、遊園地に連れてって」「日曜も、忙しくてダメなんだ」「いつもパパ、そればっかり」、泣いてベッドに潜りこむマナを見て、ため息をつくパパに、リョクが思い出させてくれたのは・・・"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "11524597",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524597",
                    "Titles": {
                        "eng": null,
                        "jpn": "最近、素敵な夢見てますか?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "駄菓子屋のおばあちゃんは、縁側で、いつも一人ぼっち。どことなく寂しそうなおばあちゃんを、のんびり屋のお茶猫サクラ・ラン・ミンは心配して、ちょっと不思議な夢をおばあちゃんに見せてあげることにしました。庭にある柿の木につまっている、おばあちゃんの大切な大切な思い出って？"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "11524598",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524598",
                    "Titles": {
                        "eng": null,
                        "jpn": "あなたの側にお茶犬はいますか？"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "出会いがあれば、別れもあります。ある決心をしたお父さんは、とうとう街を離れることに。いよいよ引越しという日、ベランダから街を見ているリョクはなんとなく寂しそう。もう出発なのに、なかなか動こうとしません。“リョク行きたくないの？” マナとリョクは離ればれになってしまうんでしょうか？"
                    },
                    "Aliases": []
                }
            }
        },
        "3": {
            "ID": "2223167",
            "URL": "https://thetvdb.com/series/tea-dogs/seasons/official/3",
            "Titles": {
                "eng": null,
                "jpn": "お茶犬～緑（リョク）っとものがたり～"
            },
            "Summaries": {
                "eng": null,
                "jpn": "みんなの関心のある「エコ」について、一緒に　考えたり、学んだり、行動したりします。「地球に優しいまめ知識」コーナーもあって、みんなでエコについて考えよう！"
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "11524599",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524599",
                    "Titles": {
                        "eng": null,
                        "jpn": "地球にホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "お茶犬リョクは今日も今日とてのんびり縁側でお昼寝。しかし、寝そべりながらリョクが最近、気になっているのは、地球の環境破壊。これじゃあ、ゆっくりお茶も楽しんでいられなくなってしまう。だからリョクたちお茶犬達も何かしなくちゃって、立ち上がったんだ。「地球が悲鳴を上げているんだ！地球をホッとさせよう！おいしいお茶を飲むために・・・」"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "11524600",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524600",
                    "Titles": {
                        "eng": null,
                        "jpn": "お庭でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハナはお庭の草花を楽しむのが大好き。草花はハナと同じで、とてもデリケート。ハナは天気をいつも気にしてる。最近は、地球が温暖化しているので、大きな台風が起こりやすくなったり、雨がずっと降らなくなったりすることが各地で起こっているんだって。いつかお花が楽しめなくなっちゃうかも？悲しくなってしまうハナ。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "11524601",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524601",
                    "Titles": {
                        "eng": null,
                        "jpn": "おうちでホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "チャイはインド生まれで実は計算が得意！。そんな得意分野をおうちの省エネにもいかしているんだ。他のお茶犬達がエネルギーをムダにしていると、すぐに注意しているんだよ。そして省エネできたと思ったお金を貯めて、そのお金で大好きなスイーツを。でも、省エネもそうだけど、甘いものも節約しないと太っちゃうぞ。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "11524602",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524602",
                    "Titles": {
                        "eng": null,
                        "jpn": "森でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "アールはカフェとヒーローごっこ。アールは環境を守るヒーロー。カフェは環境を壊す悪者の役なんだって。そんな2人が森に入ると、森の木が倒れてて、鳥の巣が木から落ちてる。巣の中にはかわいいひな鳥がいて、何とかしなきゃ。ここでアールはヒーローよろしく木を上っていって、鳥の巣を上に運ぶ。ちゃんと安心な場所まで鳥のひなを運んだアールだが・・・。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "11524603",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524603",
                    "Titles": {
                        "eng": null,
                        "jpn": "おしゃれにホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "おしゃれなロンのトレードマークは首に巻いているバンダナ。でも色々と役に立つアイテムなんだよ。怪我したアールの傷に巻く包帯になったり、川に流されたお茶猫ランを助けるためのロープになったり。そして、エコを気にするロンが、レジ袋代わりに使うのもバンダナ。バンダナに品物をくるんで、それを首に巻くのが新しいスタイルなんだってさ・・・。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "11524604",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524604",
                    "Titles": {
                        "eng": null,
                        "jpn": "海でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "夏はムハの季節。そして、ムハは夏の海で遊ぶのが大好き！サーフボードに乗って現れたかと思うと、海の中に潜って、海の中に住んでいる色々な生き物を見て、楽しんだりしている。そして、たくさん海で遊んだ後は、水平線に沈む夕日をムハはぼんやり眺めている。きっとムハは、夕日を眺めながら、海の自然がいつまでもこのままだといいな、と思っているのかもね・・・。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "11524605",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524605",
                    "Titles": {
                        "eng": null,
                        "jpn": "道でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "カフェは早起きしてのお散歩が大好き。そしてカフェは季節によってお散歩する道を変えている。春には桜、夏には小川、秋には落ち葉、冬には雪、季節で違う自然の姿をカフェは楽しんでるんだよ。クルマも人もいない朝の散歩は自然を楽しむのに最適なんだって。でも、あんまり早起きして、カフェはまた寝てしまうこともあるんだけどね。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "11524606",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524606",
                    "Titles": {
                        "eng": null,
                        "jpn": "遊びでホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "夏の昼間、お茶猫たちが家の周りでかくれんぼう。鬼になったサクラが、家の中や、家の周りをさがすと、どこからかハーブの香りが・・・。この香りは、ミン！。この香りはラン！と、ミントランはサクラに簡単に見つけられてしまう。だけどソーだけは、なかなか見つからない。ソーがどこにいたのかといえば・・・。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "11524607",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524607",
                    "Titles": {
                        "eng": null,
                        "jpn": "宝さがしでホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "カフェが書いた落書きをアールが宝の地図と思ったから、さぁ、大変！みんな＝お茶犬のアール、チャイ、ロン、ムハは、その落書きをもって宝探しに出発する。丘を越え、森の中を過ぎ、けわしい山を上っていく一行。途中にはつり橋や急ながけがあって、スリル満点！そして、みんなが、へとへとになってたどり着いた場所には・・・。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "11524608",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524608",
                    "Titles": {
                        "eng": null,
                        "jpn": "スポーツでホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "芝生の広場で遊ぶアールとチャイ。ハナが持っている風船に僕にちょーだい、僕にちょーだいとおねだり。でもあげられる風船は一個だから、アールとチャイでかけっこ競争！勝った方が風船をもらえるんだと、アールとチャイはがんばって丘を駆けていく。アールを抜こうとするチャイは下り坂で転んでコロコロ、丘を転がっていく。その先には・・・。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "11524609",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524609",
                    "Titles": {
                        "eng": null,
                        "jpn": "星空でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "星空を眺めるロンとカフェ。町の灯りでよく見えないからと、もっと星が見えるところに行こうと、ロンとカフェは丘へ行く。でも、もっと高いところに行けば、もっときれいかもと、２人は高い山へ。山から見る星の景色は最高！！だけど、疲れて寝てしまったロンとカフェは、山の上で朝を迎える。そして朝の光の中で、ロンとカフェが見たのは・・・。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "11524610",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524610",
                    "Titles": {
                        "eng": null,
                        "jpn": "公園でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "お茶犬達が公園でピクニック。ハナは、花壇のハナを観察し、アールとチャイ、ロンとムハは、公園にいる昆虫をつかまえようとしている。リョクはあいかわらず寝そべりながらも地面のアリの行進を観察。お茶犬達みんながそれぞれに公園の自然を楽しむ。そして、その後は、みんなで食事。公園でピクニックは楽しいな・・・。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "11524611",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/tea-dogs/episodes/11524611",
                    "Titles": {
                        "eng": null,
                        "jpn": "新茶でホッと！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "いつも寝そべっているリョク。でも、春から夏にかけてのこの時期はなんだか気持ちがそわそわ。この時期は新茶の季節なんだって。お茶畑をたずねたリョクは、そこで新茶のようなちいちゃなお茶犬に出会う。お茶犬の新種？それとも・・・。"
                    },
                    "Aliases": []
                }
            }
        }
    }
