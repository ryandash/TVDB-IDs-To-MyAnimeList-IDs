            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "3599551",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599551",
                    "Titles": {
                        "eng": "My name is Goa",
                        "jpn": "我が名はゴア"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "新聞記者・村上厚は、友人の飛鳥文明から奇妙な呼び出しを受ける。だが彼が駆けつけると、文明は娘・未来の眼前で化け物に消されていた。失神した未来を保護する村上。だが彼女を見守る村上の息子マモルは「鬼」を目撃・・・。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "3599561",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599561",
                    "Titles": {
                        "eng": "The Giant Golden God",
                        "jpn": "黄金の巨神"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "無数の光が集結し黄金（きん）の巨神＝マグマが降臨、ゴアの円盤を退却させた。それでもマグマを認めないと罵倒・号泣するマモル。そんな彼に地球の守護神アースは『命の記憶』を見せ、マグマと共にゴアに立ち向かえと諭すのだった。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "3599571",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599571",
                    "Titles": {
                        "eng": "A Silent Invasion",
                        "jpn": "静かなる侵略"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "事件の翌朝、村上は怪円盤の記事を編集部に送る。だがそれは黙殺された。憤る村上はマモルから聞いたゴアの存在を掴む為、後輩関田と共に現場へ。しかし二人を謎の大男が尾行する。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "3599581",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599581",
                    "Titles": {
                        "eng": "The Two Mamorus",
                        "jpn": "二人のマモル"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ゴアはマモルを拉致し、地球を傷つけた人類を滅ぼす手始めに、彼の住む町もろとも人間モドキにすり替えたと嘯く。だがその眼前でマモルが変身。アースがマモルの身代わりとして作った少年ロケット人間・ガムだったのだ。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "3599591",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599591",
                    "Titles": {
                        "eng": "Speculation of the State",
                        "jpn": "国家の思惑"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "村上一家を保護したのは、防衛庁情報局の面々だった。ゴアやマグマの秘密を知る為、マモルの記事を調べ始める情報局。一方、国東次長はゴアの使徒らしき紅いコートの女と接触。マグマこそ地球を滅ぼす魔人である、という彼女の忠告に半信半疑となるが・・・。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "3599601",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599601",
                    "Titles": {
                        "eng": "Suspicious Warrior Magma",
                        "jpn": "疑惑の戦士マグマ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "村上はペンダントからある神社のネガ写真を見つけ、ゴアの手がかりと考えた。が、友子もなぜか眼を怪しく光らせる。マモルを問いただす国東次長。と、破壊され調査されていた筈のゴアのロボットが再起動し暴れだす。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "3599611",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599611",
                    "Titles": {
                        "eng": "The Grand Mission",
                        "jpn": "大いなる使命"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "大津波から一ヶ月後、謎の失踪事件が連続発生。その頃村上らは、例のネガに写る「鬼虎神社」の祠（ほこら）を探していた。そこには遠い昔、人を喰う鬼が封印されたという伝説があった。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "3599621",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599621",
                    "Titles": {
                        "eng": "The Whistle in Danger",
                        "jpn": "狙われた笛"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "久々に街へ買い物に出たマモルと友子は、再び人間モドキに襲われ、危ういところを通りすがりの男・今井に匿われる。今井の娘みどりの明るさに心和むマモルだが、友子だけは彼女に漂う「影」を感じていた。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "3599631",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599631",
                    "Titles": {
                        "eng": "Resurrection of Udo",
                        "jpn": "ウドー復活"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "いよいよ完全復活を遂げたゴアは、右腕・ウドーの覚醒を目論む。一方、国とゴアとの関係を疑う村上らは、再び「鬼虎神社」へ。その夜、母の様子に不審を抱いたマモルはその後を追いゴアの手下に狙われるが、ひそかに動き出した国東・桑原らに救われる。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "3599641",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599641",
                    "Titles": {
                        "eng": "Mother's Love",
                        "jpn": "母、その愛"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ウドーは人類に宣戦布告したゴアの元に参じ、マグマ打倒の許可を得る。国東らもマグマを味方と認識。そこへ防衛庁の幹部大石が現れ、マモルの懐柔を図る。ゴアの本性を知り方針を変えたのだ。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "3599651",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599651",
                    "Titles": {
                        "eng": "Wrath of Earth",
                        "jpn": "大地の怒り"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "再度激突するマグマとウドー。だが突如時空に歪みが生じ、2大巨神及びマモル一行、ゴアまでも飲み込んだ・・・。超古代の鬼虎山に迷い込んだマモルらは恐竜に襲われた。やむなく撃つ国東たち。そこへアースの声が響く。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "3599661",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599661",
                    "Titles": {
                        "eng": "Magma Dies!",
                        "jpn": "マグマ死す!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "遂にゴアは人類への総攻撃を開始。果敢に立ち向かうマグマ。マモルたちも人々を守る為動き出す。そこへウドーが戻るがマグマとの小競り合いの後、ジャコブの残留意識によりゴアに牙を剥く。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "3599671",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/magma-taishi/episodes/3599671",
                    "Titles": {
                        "eng": "Planet of Love",
                        "jpn": "愛がある星"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "地球の為に命を懸け、玉砕したマグマを前に呆然となるマモル・・・。「君こそ本当の地球人だ」と詫びつつ泣き崩れる。哄笑するゴアは地球の輝きを取り戻す為、無数の怪獣を放ち人類を蹂躙。人類滅亡が地球の意思なのか・・・と失望にかられるマモル。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}