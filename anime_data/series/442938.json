                        "jpn": "わんだふるぷりきゅあ！ざ・むーびー！ドキドキ♡ゲームの世界で大冒険"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "TBA"
                    },
                    "Aliases": []
                }
            }
        },
