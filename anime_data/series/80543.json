            "# Episodes": 25,
            "Episodes": {
                "1": {
                    "ID": "335653",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335653",
                    "Titles": {
                        "eng": "A Boy by the Name of Agate",
                        "jpn": "アゲートという名の少年"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ハンドメイドの飛行機と一緒に汽車に乗って、名門校「クラスターＥ.Ａ.」に向かう転入生の少年アゲートは、同じ汽車に偶然乗り合わせていた学園の優等生で名門ジャスパー家の子息ベリルと出会う。そんな中、人造兵擁護派の青年カールスが乗る飛行機とグリアン共和国軍との交戦が起こり、汽車は足止めをくうが……。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "335654",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335654",
                    "Titles": {
                        "eng": "Beryl's Sword",
                        "jpn": "ベリルの剣"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "撃墜されたハンドメイドの飛行機の残骸からエンジンを回収したアゲートは、愛車で軍学校の生徒たちを出迎えに行くフォンと出会う。そのフォンの愛車がクラスター学園への対抗心をむき出しにする軍学校の生徒たちによって壊されてしまう。傷心のフォンを慰め、一緒に修理を始めたアゲートに困惑するフォンだが……。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "335655",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335655",
                    "Titles": {
                        "eng": "Cold Bullet",
                        "jpn": "冷たい銃弾"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "学園生活を満喫するアゲートは、授業よりも飛行機作りに熱中してしまう。その姿に、教師エマは、学生時代、同じように飛行機が好きだった親友カールスを思い返す。そんなエマの元に、かつての級友で今は軍の諜報部員となっているベスビアが訪れる。ベスビアに、ある事実を告げられたエマはショックを受けて……。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "335656",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335656",
                    "Titles": {
                        "eng": "Jet Black Chrome Team Appearance!!",
                        "jpn": "漆黒のクロム団登場!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "アゲートの奇蹟の発動を目撃したエマは、気持ちの整理をつけるため休暇を取り、兵器製造会社を営む実家に帰省する。封鎖されたはずの人造兵製造工場が稼動していることを知り工場に向かうエマ。そこで秘密裏に訪れていた聖職者ルドウィヒと出会う。一方、クロムたちもその工場に向かい……。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "335657",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335657",
                    "Titles": {
                        "eng": "Miracle Race",
                        "jpn": "奇蹟のレース"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "街の工業区に辿りついたアゲートは、ある労働者の老人の家に世話になる。貧しい生活を送る老人は、金貸しから膨大な借金を負っていた。アゲートは、老人を助けるために、なんとかお金を工面しようとする。そして、アゲートの勘の良さに気づいたガードマンの青年に、ボートレースへと誘われるアゲートだったが……。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "335658",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335658",
                    "Titles": {
                        "eng": "Professor and Fon",
                        "jpn": "教授とフォン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "行方不明のアゲートに代わり、飛行機の組み立てに取り組むフォン。入手が困難な部品を何とか手に入れようとしたフォンは、車のディーラーから得た情報で閉鎖された博物館に向い、そこで思いがけない人物と出会う。一方、街にはレグラントの叛乱兵が潜伏し、同じレグラント国出身のベリルが軍の監視下に置かれてしまう。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "335659",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335659",
                    "Titles": {
                        "eng": "Trip into the Past",
                        "jpn": "過去への旅"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "休暇先の実家で、思わぬ邂逅と秘密を知ったエマ。人間の記憶を与えられた人造兵の少年クロムとの出会い、兵器製造会社を営む父が加担した計画、アゲートの出生の秘密……。それら総てが、エマには親友だったカールスに繋がるように思えてならない。旅の途中の汽車に揺られながら、エマは過去の記憶へと思いを馳せる。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "335660",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335660",
                    "Titles": {
                        "eng": "Student Council Election",
                        "jpn": "生徒会選挙"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "クラスターE.A.では、生徒会選挙が始まる。就職や進学を目前にした最上級生たちが立候補するのが常だった生徒会長だが、今回は1年生のベリルが上級生に混ざって立候補する。ベリルの突然の行動に驚きながらも、全面的に協力しようとはりきるフォン。その頃アゲートは、工業区で労働者たちと一緒に働いていたが……。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "335661",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335661",
                    "Titles": {
                        "eng": "Ghost of the House",
                        "jpn": "館の亡霊"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "軍に撃墜されそうになったフォンをベリルと一緒に助けたアゲートは、そのままベリルたちの前から姿をくらましてしまう。アゲートはカールスの実家に辿り着き、目の不自由なカールスの祖母にカールスと間違われてしまう。優しい祖母の労わりに、アゲートは心を癒していく。だが、そこにベスビアが乗り込もうとしていた。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "335662",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335662",
                    "Titles": {
                        "eng": "Paths of Destiny",
                        "jpn": "運命の道"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "カールスの制服をまとい、ビンテージ機に乗って再び飛び立ったアゲート。彼はまるで風のように、運命に導かれるまま吹き抜けていく。そして行く先々で出会う人々の心を揺さぶり、未来に向かって動かしていく。そんなアゲートの軌跡と、彼と出会った人々の進む道が幾重にも重なって紡がれた運命の道程を振り返っていく。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "335663",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335663",
                    "Titles": {
                        "eng": "Their Respective Thoughts",
                        "jpn": "それぞれの想い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "クラスターE.A.の生徒会長として、ベリルは人造兵製造の是非などを会議の議題に上げる。しかし他の生徒たちは、それらの議題に関心を持とうとしない。そこに、母の容態が急変したとの知らせが入り、ベリルは急遽病院へと向かう。一方、アゲートはクロム率いるクロム団と遭遇し、彼らから銃撃をうけてしまう。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "335664",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335664",
                    "Titles": {
                        "eng": "Agate's Call",
                        "jpn": "アゲートの叫び"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "学園に復帰したエマを待っていたのは、アゲートの去就を巡る職員会議だった。アゲートの私物を片付けることになったエマは、部屋の片隅にカールスとの思い出の証を見つける。その頃、乗っていた飛行機が不調を起して、とある村に不時着したアゲートとクロム。そこでクロムは昔世話になった修道女、リナと再会して……。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "335665",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335665",
                    "Titles": {
                        "eng": "Thing Chalce Left Behind",
                        "jpn": "カールスの遺したもの"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "グリアン軍との戦闘で傷ついたアゲートは、修道院の近くの小屋に匿われていた。その間、クロムは村のために働きながら、カールスとの出会いを思い返す。リナもまた、傷が癒えないアゲートの看病をしながら、幼馴染カールスとの思い出を振り返る。そしてリナは、幼いカールスの身に起きたある事件を思い出す。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "335666",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335666",
                    "Titles": {
                        "eng": "Wind to Tomorrow",
                        "jpn": "明日への風"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "教団の大僧正ロベルトは、ルドウィヒに命じたある大儀の結果について探りを入れようと、彼のいる教会を極秘に訪れていた。そこに、クロムと別行動中のクロム団が、偶然手に入れた教団の書物を届けに現れる。一方、クラスターE.A.では、生徒たちの中からも人造兵の排斥を唱える声が上がり始めていた。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "335667",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335667",
                    "Titles": {
                        "eng": "Letter to Hema",
                        "jpn": "エマへの手紙"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "グリアン軍に売り渡されてしまったアゲートは、ベスビアの激しい尋問を受けていた。肉体は傷つきながらも心は純粋なままのアゲートに、ベスビアは憎悪を募らせていく。一方、アゲートの作業小屋で、学園を去ったアゲートの出生の秘密について考えを巡らせていたエマは、カールスが遺したエマ宛の手紙を発見して……。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "335668",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335668",
                    "Titles": {
                        "eng": "Chrome and Agate",
                        "jpn": "クロムとアゲート"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ベスビアによって連行されたアゲートを救出する為、軍施設に単身忍び込んだクロム。無事脱出はしたものの、2人に行く当てはない。ならばとアゲートはクロムを誘い歩き出す。2人が向かったのは、カールスの実家だった。そこに、養老院に入れられたはずのカールスの祖母が現れ、2人の「孫」を優しく迎えるのだった。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "335669",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335669",
                    "Titles": {
                        "eng": "Eyes Of Fear",
                        "jpn": "怯えた瞳"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ベスビアから逃れたアゲートとクロムは、以前ボートレースをした工業区に辿り着く。アゲートを知る労働者たちに歓迎された2人だったが、グリアン軍の進軍を契機に、街は火に包まれてしまう。その頃、クラスターE.A.では、アゲート機のテスト飛行をしようとしたフォンが、軍人たちから取調べを受けてしまう。"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "335670",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335670",
                    "Titles": {
                        "eng": "Under The Wings",
                        "jpn": "翼のもとに"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "グリアン軍によって監視が続くクラスターE.A.は、その不穏な空気から、生徒たちの間にも動揺が広がっていた。そんな学園にアゲートとクロムが姿を現す。久しぶりの再会を喜ぶフォン。だが学園には、退学処分を受けたアゲートと人造兵であるクロムの居場所はない。ベリルは行き場のない二人を保護しようとするが……。"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "335671",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335671",
                    "Titles": {
                        "eng": "Bond With The Skies",
                        "jpn": "大空への絆"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "クロムの手がかりを探して移動中のクロム団は、その途中でロードと対峙する。自由を語るクロム団が気に入らないロードは、配下の人造兵に攻撃命令を下す。一方、転入生として慣れない学園生活を過ごしていたクロムは、生徒たちから叫ばれる人造兵排斥の声に内心の怒りを抑えきれず、アゲートと喧嘩をしてしまう。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "335672",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335672",
                    "Titles": {
                        "eng": "Wandering Artificial Soldiers",
                        "jpn": "さまよえる人造兵"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "身を潜める場所を捜していたクロム団は、かつて人造兵に助けられたという老人に出会う。老人の家に招かれ、親切にしてもらうクロム団だが、人造兵を疎ましく思う村人たちにそのことを知られ、村を去ることを余儀なくされる。その頃、街まで出かけていたフォンは、その帰り道でロードの破壊工作に巻き込まれてしまう。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "335673",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335673",
                    "Titles": {
                        "eng": "The Moment of Resolution",
                        "jpn": "決意の時"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ベスビアのもとに、敵であるはずの反政府組織のリーダー・ロードが来訪してきた。警戒するベスビアに、ロードは何故かアゲートの居場所を教える。その頃、クラスターE.A.では、飛行機レースの開催が目前に迫っていた。アゲート機のパイロットにフォンを指名するアゲート。自信がないと戸惑うフォンだったが……。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "335674",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335674",
                    "Titles": {
                        "eng": "Sorrowful Fury",
                        "jpn": "悲しき怒り"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ベスビアが指揮するグリアンの部隊はクラスターE.A.に砲撃を始め、アゲートを差し出さねば更なる砲撃で学園を破壊すると脅しをかける。学園内では、逃げ遅れた生徒の救出にあたっていたクロムの目の前で、瓦礫が崩れ生徒が下敷きになってしまう。クロムは、人造兵の力を使わないというベリルとの約束を思い出すが……。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "335675",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cluster-edge/episodes/335675",
                    "Titles": {
                        "eng": "The Will",
                        "jpn": "遺言"
                    },
                    "Summaries": {
                        "eng": "",
