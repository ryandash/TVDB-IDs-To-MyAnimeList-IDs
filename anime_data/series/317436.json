            "Episodes": {
                "1": {
                    "ID": "5763226",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5763226",
                    "Titles": {
                        "eng": "The New Face That Plays Our Bonds!",
                        "jpn": "絆を奏でるニューフェイス！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "普通の高校生だった天宮奏は、ある日突然、レジェンドアイドルの三神遙人にスカウトされる。 断るつもりが、ついついルーキークラスのアイドル、佐々木純哉と張り合ってしまい…。奏VS純哉！ 2人のアツいアイドル特訓の行方は!?"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "5763227",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5763227",
                    "Titles": {
                        "eng": "Shin Oikawa Is an Amazing Guy!!",
                        "jpn": "及川慎はスゴいヤツ!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "晴れてD-Fourプロダクションのルーキークラスに所属することになった天宮奏。そんな折、奏は及川慎の仕事現場を見学させてもらうことに。寡黙で人を寄せ付けない慎に、なんとか会話の糸口を探ろうとする奏だったが…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "5763228",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5763228",
                    "Titles": {
                        "eng": "2032",
                        "jpn": "2032"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "天宮奏と同じルーキークラスのアイドル、及川慎にスキャンダルが発覚！　慎が作詞した歌はかつての恋人へ向けたものだった!? アイドル活動が危ぶまれる慎を放ってはおけない奏は、慎が歌詞に込めた真意を探ろうとするが…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "5763229",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5763229",
                    "Titles": {
                        "eng": "A Unit of 3 Is Born!!!",
                        "jpn": "３人ユニット結成!!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "社長の発案で、奏は慎、純哉とユニットを組むことに。3人での初ライブに向けて特訓を始めるが、純哉の過酷すぎる特訓に、奏は思わず反発してしまう。誰よりもストイックな純哉を突き動かす、幼き日の思い出とは…？"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "5802370",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5802370",
                    "Titles": {
                        "eng": "First Variety Show!!!",
                        "jpn": "はじめてのバラエティ!!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "無事初ステージを終えたトラフィックシグナルの3人。しかし、今度はリーダーの座をめぐって一触即発！　慎の提案で、リーダーは次の仕事で決めることに。そんな中、オファーがきたのはムネキュンなアイドルバラエティ番組で…。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "5802371",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5802371",
                    "Titles": {
                        "eng": "Chizuru and Yuzuru?!",
                        "jpn": "千弦と唯弦!?"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "レッスンに励む奏に、すでにデビューしている人気アイドルユニット「印SHOW派」のメンバーの一人、沢村唯弦が急接近！　唯弦は千弦の双子の兄で、しかも奏をいたく気に入って、一緒に共演したいと言いだし始めるのだが…⁉"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "5802372",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5802372",
                    "Titles": {
                        "eng": "Kurofune Is Here!!",
                        "jpn": "KUROFUNE襲来!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "トラフィックシグナルの活動も軌道に乗った奏たちは、ドリフェスの前哨戦とも言われるルーキークラスのバトルライブの優勝候補として注目され始める。そんな折、事務所にある男が乗り込んで来たとの噂が…⁉"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "5802373",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5802373",
                    "Titles": {
                        "eng": "Itsuki`s Chosen Path",
                        "jpn": "いつきの選ぶ道"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "バトルライブの結果に意気消沈の奏たちだったが、心機一転、千弦といつきも加えて５人でユニットを組む案が浮上する。しかし、何故かいつきは新ユニットの加入に消極的な態度を示す。柔和な笑みに隠された、いつきの悩みとは…？"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "5833391",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5833391",
                    "Titles": {
                        "eng": "DearDream`s Nationwide Tour!!!!!!",
                        "jpn": "DearDream全国行脚!!!!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "5人組ユニット「DearDream」を結成し、新たなアイドル活動をスタートさせた奏たち。しかし、事務所主催のライブの新人枠は人気急上昇中の「KUROFUNE」で埋まってしまい、ステージに立てずいきなりの大ピンチ！　そんな中、純哉が考えた秘策とは…!?"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "5833392",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5833392",
                    "Titles": {
                        "eng": "A Journey of Dreams: Junya`s Decision",
                        "jpn": "夢の旅へ 純哉の決意"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "自分たちなりのやり方でライブを成功させたDearDream。そんな中、純哉にニューヨークで世界的エンターテイナーに師事できる大チャンスが巡ってくる。だが、渡米すれば「ドリフェス！」には出場できない。純哉の決断に、奏の心は大きく揺らぎ…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "5833393",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5833393",
                    "Titles": {
                        "eng": "The Feeling We Want to Hold High!!!!!",
                        "jpn": "かかげたい想い!!!!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "いよいよ迫るドリフェス！に、DearDreamは敢えてオリジナル曲で勝負をかけることにする。なんとか曲は作ってもらうも、作詞を担当することになった慎が行き詰ってしまう。DearDreamは新曲を完成できるのか…⁉"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "5833394",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/dream-festival/episodes/5833394",
                    "Titles": {
                        "eng": "The Door to Becoming Idols!!!!!",
                        "jpn": "アイドルへの扉!!!!!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついにD-Fourプロダクション開催の一大イベント、ドリフェス!が幕を開ける！　だが当日、本番間近で奏がいなくなってしまう。慌てて奏を探すメンバーたち。\r\n果たしてDearDreamは無事に出場できるのか!?"
                    },
                    "Aliases": []
                }
            }
        },
