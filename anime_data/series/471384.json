            "Episodes": {
                "1": {
                    "ID": "11498798",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498798",
                    "Titles": {
                        "eng": null,
                        "jpn": "登場!!ヘンな忍者/まん丸アイドル化計画!?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "動物達が忍者として暮らす念雅（ねんが）山。ある日、三流派の一つである念雅流のもとに、じいやさんがおかしなペンギンを連れてきた。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "11498799",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498799",
                    "Titles": {
                        "eng": null,
                        "jpn": "への一!?乱子参上/ミスターボロット大暴走！"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "さすらいの一匹狼、紫狼沙（しろうさ）が念雅山に戻ってきた。その紫狼沙に惚れるうさぎ忍者の乱子（らんこ）は、一方的に追いかけて山についてきたのだった。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "11498800",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498800",
                    "Titles": {
                        "eng": null,
                        "jpn": "初めてのおつかい大騒動/変身粘土!?ネンネン"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ネンガから白ヤギ仙人に手紙を届けるよう、おつかいを頼まれたまん丸。ところが渡された地図をなくしてしまい道に迷ってしまう。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "11498801",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498801",
                    "Titles": {
                        "eng": null,
                        "jpn": "恐怖の電話魔は誰だ？/スーパーヒーロー乱入!!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "じいやさんがまん丸に携帯電話を持たせたのだが、それがネンガに見つかり電話を遠くに投げ捨てられてしまった。すると、真美子ちゃんの家にいたずら電話が何度もかかってくるようになった。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "11498802",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498802",
                    "Titles": {
                        "eng": null,
                        "jpn": "めざせ！エステで弟子入/り大怪獣くじ引き作戦"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "への一乱子はどうしても紫狼沙の弟子になりたいが、なかなか認めてもらう事ができない。そこで、大人っぽくきれいになって弟子入りする作戦を考えついた乱子は…。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "11498803",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498803",
                    "Titles": {
                        "eng": null,
                        "jpn": "怒りの折り紙禁止令!!/オホホホ…逃走する少女!!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "秘められた力を持ちながらも、それをなかなか発揮出来ないまん丸に苛立ちをつのらせるネンガ。とうとうまん丸の大好きな折り紙を禁止することにした。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "11498804",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498804",
                    "Titles": {
                        "eng": null,
                        "jpn": "嵐の予感！謎の天容の笛　前編・後篇"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "その笛を吹くとすべての忍者の頂点に立つと言われる「天容の笛」。念雅流に代々伝わるこの笛を奪い合うおかげで、各流派同士の争いが絶えなくなるため、ネンガが封印し休戦協定を結んでいた。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "11498805",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498805",
                    "Titles": {
                        "eng": null,
                        "jpn": "私をドベと呼ばないで!!/玉に願いを…"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "森にキノコ狩りに出掛けたまん丸達。すると、森には念雅流の予備忍ドベ軍団が勢ぞろい。ドベを返上したいとり郎は、はりきって幻のキノコ「踊りマツタケ」の元にまん丸達を案内するのだが…。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "11498806",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498806",
                    "Titles": {
                        "eng": null,
                        "jpn": "まん丸の新たなる力!!/ボロット2号はダンスがお好き"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "雷が落ちた山にまん丸達が向かうと、抜いた者に大いなる力が与えられるという「天容の刀」が頂上に刺さっていた。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "11498807",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498807",
                    "Titles": {
                        "eng": null,
                        "jpn": "笛はどこに？ド派手な強敵登場!!　前編・後篇"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "海外で修行していた伊賀の黒龍斎の息子、桃助（ももすけ）が帰ってきた。桃助は黒龍斎が天容の笛を狙っていることを知ると、まん丸を人質にして天容の笛を奪おうとするが…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "11498808",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498808",
                    "Titles": {
                        "eng": null,
                        "jpn": "昇忍試験だョ！全員集合/来たぞ！恐怖の笑いバチ"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "今日は年に一度の念雅流昇忍試験の日。ドベ軍団から正式な忍者に昇格するための大事な試験だが、ネンガは試練を与えるためにまん丸にも試験を受けさせることとした。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "11498809",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498809",
                    "Titles": {
                        "eng": null,
                        "jpn": "天の怒り！謎の笛ついに登場!!　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "伊賀と甲賀は懲りずに天容の笛を奪おうとしていた。いつまでも続く争いにあきれたネンガは、とうとう天容の笛を登場させて、なんと伊賀の黒龍斎に吹かせてしまうのだった。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "11498810",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498810",
                    "Titles": {
                        "eng": null,
                        "jpn": "はりがねランドへの招待状/迷い込んだ精霊の森"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ある日、まん丸達に針金山遊園地の招待状が届いた。喜んだまん丸は乱子達と一緒に遊びに行くことにした。そこは乗り物や射撃など、アトラクション全てにたくさんの1円玉を払う不思議な遊園地。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "11498811",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498811",
                    "Titles": {
                        "eng": null,
                        "jpn": "お父さんと南極大冒険！/指名手配！まん丸は1億円？"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ある日、自分の故郷について語り出したまん丸。生まれ故郷は南極に近いシシカト島で、お父さんは色々なことに挑戦する風変りな冒険家であることを打ち明ける。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "11498812",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498812",
                    "Titles": {
                        "eng": null,
                        "jpn": "最強の敵!!ギオ現る！　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "羅門衆の頭領ギオがよみがえった。ギオは、なんとネンガの弟。邪悪な力を操るギオは念雅流の天容の笛を奪おうと、手下のピエーロを暗黒意念で巨大化させ、第一の刺客として送り込む。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "11498813",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498813",
                    "Titles": {
                        "eng": null,
                        "jpn": "恐怖…文字もじの術!!/燃えろ！おにぎり兄弟"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "天容の笛を狙う羅門衆のギオが、次なる刺客モジモジ人形の使い手・モジーを送りこんできた。人形に書いた文字どおりの災難を起こすことが出来るモジー。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "11498814",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498814",
                    "Titles": {
                        "eng": null,
                        "jpn": "初恋南極メモリー/ペットはコマルっち!?"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "まん丸のシシカト島時代の淡い恋のお話。毎日見かけるピピンちゃんという女の子に恋をしたまん丸。ある日、思いきって声をかけると2人は意気投合して恋人同士に。"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "11498815",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498815",
                    "Titles": {
                        "eng": null,
                        "jpn": "フロコプター大空中戦!!/激闘！ネンガ対紫狼沙"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "羅門衆の刺客、ハトのポン太郎があらわれた。当たったすべての者がしもべになってしまうポン太郎の豆鉄砲攻撃で、まん丸達は大ピンチに！"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "11498816",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498816",
                    "Titles": {
                        "eng": null,
                        "jpn": "闇の罠！ネンネンの秘密　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ネンネンに乗り移って、念雅の屋敷に乗り込む事に成功した羅門衆参謀の粘心。なんと、かつて紫狼沙と戦った際に切り落とされた体の一部がネンネンだったのだ。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "11498817",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498817",
                    "Titles": {
                        "eng": null,
                        "jpn": "誕生！パオパオランド　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "争いを止めさせようと、念雅・伊賀・甲賀の三流派合同の修練場「パオパオランド」を作ろうと提案したまん丸。賛成したネンガからリーダーに指名されるのだが…。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "11498818",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498818",
                    "Titles": {
                        "eng": null,
                        "jpn": "決定！あんたがリーダー/さあ、私を食べて…"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "パオパオランドで修練に励むまん丸達。ところが相変わらず仲はわるく、ケンカばかりしていた。そこで、真美子ちゃんの提案で、みんなをまとめるリーダーを決める選挙を行うことにしたのだった。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "11498821",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498821",
                    "Titles": {
                        "eng": null,
                        "jpn": "帰って来たライバル!!/電撃!?タヌ太郎の婚約発表"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "海外留学から久しぶりに帰った伊賀の桃助。パオパオランドができた事を知ると、それを念雅の策略と思い込み乗り込んでくるのだった。桃助は勝手にライバル視するまん丸と対決しようとするが…。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "11498822",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498822",
                    "Titles": {
                        "eng": null,
                        "jpn": "レベルアップ!!ドベ軍団/入れ替え魔・せんたく丸"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ドベ軍団は、羅門衆の襲撃に備えて修練に励むようネンガから言い渡される。ところが、相変わらずの間抜けぶりでタヌ太郎からバカにされっぱなし。"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "11498824",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498824",
                    "Titles": {
                        "eng": null,
                        "jpn": "逆襲！ギオの巨大戦艦!!　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "暗黒意念に手を出した報いで老化が始まった羅門衆のギオ。一刻も早く天容の笛を手に入れようと、自ら念雅の山に乗り込んで来た。"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "11498826",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498826",
                    "Titles": {
                        "eng": null,
                        "jpn": "スクープ！ネンガ様開眼!!/巨大怪魚タロジを追え!!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "念雅流の頭領ネンガは普段から常に目を閉じて生活している。どうしてもネンガが目を開いたところが見たいまん丸達は、本気になった時だけ目を開ける事を知り、あらゆる手を尽くすが…。"
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "11498828",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498828",
                    "Titles": {
                        "eng": null,
                        "jpn": "乱子のムフフ大作戦/喜怒哀楽がとまらない!!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "家に閉じこもっていた乱子は、その玉から出る煙を吸うとラブラブになるというムフフ玉を作っていた。ムフフ玉を完成させた乱子は、とうとう告白をするため、紫狼沙のもとへ向かう。"
                    },
                    "Aliases": []
                },
                "27": {
                    "ID": "11498829",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498829",
                    "Titles": {
                        "eng": null,
                        "jpn": "まん丸のまる秘探偵日記/戦慄!!ネンガ様暗殺計画"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "念雅流の忍者の証である、大事な印堂帯を無くしてしまったタヌ太郎。昨晩、寝るときにはあったため、誰かに盗まれたと言いだし大騒ぎ。"
                    },
                    "Aliases": []
                },
                "28": {
                    "ID": "11498830",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498830",
                    "Titles": {
                        "eng": null,
                        "jpn": "運命の決着!!ネンガ対ギオ/旅立ち！笛を取り戻せ!!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "早朝、眠りにつくまん丸達に別れを告げてネンガはギオの羅門城へ向かった。これ以上、兄弟の争いに周囲を巻き込むことが出来ないと考えたネンガは…。"
                    },
                    "Aliases": []
                },
                "29": {
                    "ID": "11498831",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498831",
                    "Titles": {
                        "eng": null,
                        "jpn": "突入！あれが羅門城だ!!　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ネンガと天容の笛を取り戻すべく、羅門城へ向かい旅に出たまん丸達。その行く手を阻む羅門衆の敵を何とか倒し、やっとの思いでたどり着いた羅門城へ突入を試みるが…。"
                    },
                    "Aliases": []
                },
                "30": {
                    "ID": "11498832",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/ren-penmanwan/episodes/11498832",
                    "Titles": {
                        "eng": null,
                        "jpn": "輝ける未来、輝ける星　前編・後編"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "天容の笛を手にして最強忍者となったギオ。捕らわれの身となったまん丸は絶体絶命の大ピンチ！！するとそこへ、伊賀と甲賀の軍団、さらにはドベ軍団達が助けに来たのだった。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}