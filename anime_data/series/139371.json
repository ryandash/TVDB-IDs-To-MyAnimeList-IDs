                    "Titles": {
                        "eng": "Kin Jin Kitto",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "This is the preview footage for the first original work by Tatsuyuki Tanaka, who has been involved in original drawing, continuity, story boards, and character design for a number of animated films. The unique world portrayed in the comic book version of this story comes to life in animated form.",
                        "jpn": null
                    },
                    "Aliases": []
                },
                "4": {
