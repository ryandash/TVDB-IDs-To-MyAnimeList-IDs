                    "Titles": {
                        "eng": "Chicken's Insurance",
                        "jpn": null
                    },
                    "Summaries": {
                        "eng": "This original work by Hiroaki Ando, a major production of Studio 4℃, makes use of CGI direction. This conﾞdent use of computer graphics breaks through existing frameworks of animation in a variety of ways, and presents animation supposedly produced by chickens.",
                        "jpn": null
                    },
                    "Aliases": []
