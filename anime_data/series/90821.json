        "1": {
            "ID": "56031",
            "URL": "https://thetvdb.com/series/the-wonderful-adventures-of-nils/seasons/official/1",
            "Titles": {
                "eng": null,
                "jpn": null,
                "nld": "De kabouter",
                "afr": "Die Kaboutertjie"
            },
            "Summaries": {
                "eng": null,
                "jpn": null,
                "nld": "Nils Holgersson vertikt het om samen met zijn ouders naar de kerk te gaan. Hij trekt er op uit en vangt een op het eerste zicht onschuldige kabouter. Die blijkt echter op magisch vlak een maatje te groot voor hem te zijn.",
                "afr": "Nils Holgerson het glad nie lus om saam met sy ouers kerk toe te gaan nie. In plaas daarvan loop hy rond en vang — sonder om te weet — ’n kabouter. Maar dié kabouter is nie so onskuldig soos hy lyk nie… en gou beland Nils in ’n magiese avontuur wat sy hele wêreld op sy kop keer."
            },
