            "Episodes": {
                "1": {
                    "ID": "1286361",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1286361",
                    "Titles": {
                        "eng": "No Kiss, You See",
                        "jpn": "kissはダメよ、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "昔の風情を残した城下町。主婦の浅羽嬉子（うれしこ）には“魔法少女アニエス”という別の姿がある。ある日、魔法世界リルムからクルージェという少女がやって来た。その目的は、嬉子の母がつくった世界を引き継ぐことであった…。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "1287081",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287081",
                    "Titles": {
                        "eng": "Stew is Okay, You See",
                        "jpn": "シチューはOKよ、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "母の世界を守ろうとする人妻アニエス＝嬉子と、自分の世界に町を改造しようとする魔法少女クルージェ＝さやか。対立のさなか、嬉子はさやかを夕食に招いた。さまざまな具材が溶けあったシチューにこめられた想いとは…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "1287091",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287091",
                    "Titles": {
                        "eng": "Adults Are Children, You See",
                        "jpn": "大人ってコドモ、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法世界リルムからパラソルを使う魔法少女ブルガがやって来た。かつてクルージェと管理者の座を争って敗れたブルガは、引き継ぎの混乱に乗じて指輪を強奪しようと嬉子に魔法の戦いを挑む。大人と子どもの戦いが始まった…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "1287101",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287101",
                    "Titles": {
                        "eng": "An Evening Shower is Dangerous, You See",
                        "jpn": "夕立は危険よ、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "夫である保と嬉子との間は断絶したままだった。だが、嬉子の不調を巽から聞いたさやかは、チャンスとばかりに魔法を使って城址公園を遊園地に改造し始める。それを察知した嬉子は豪雨の中でさやかと対決するのだが…。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "1287111",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287111",
                    "Titles": {
                        "eng": "Adults Are Okay, You See",
                        "jpn": "大人ならOKよ、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "編集者として未熟な巽は、嬉子の夫の保から萩の偉人、吉田松陰について調べるようお題を出される。嬉子のヒントで松下村塾を訪れる巽。そこに一人の女子大生が近づいて来たが、それは大人の姿に変身したさやかであった…。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "1287121",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287121",
                    "Titles": {
                        "eng": "The Charms of Adults Are, You See",
                        "jpn": "大人の魅力って・・・、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "舞子おばあちゃんの代わりに、いっしょに時代劇の芝居へ行くことになった嬉子と巽。一方、貧乳をバカにされたさやかは、大人に変身して本命の巽へ接近しようとする。だが、巽の取材に割りこんださやかは、突然苦しみ始めた…。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "1287131",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287131",
                    "Titles": {
                        "eng": "The Kiss Right in Front of Me, You See",
                        "jpn": "すぐそこにあるキス、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "キスを拒絶したことで、夫の保との仲がますますこじれてしまう嬉子。巽への想いを抱いたさやかは、大人に変身して海へデートに誘う。二人の間が気になる嬉子は、水着に着替えて、海水浴場へと出かけていくのだった…。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "1287141",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287141",
                    "Titles": {
                        "eng": "The Existence of a Dear Person, You See",
                        "jpn": "想う人がいる、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "管理者の引き継ぎが進まず、クルージェ＝さやかは魔法世界リルムの評議会に呼び出され、叱られてしまった。困ったさやかは、保健室のヴァレンタイン＝由貴に相談する。由貴は新たな世代交代のため、サポートを決意する。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "1287151",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287151",
                    "Titles": {
                        "eng": "So I Have No Regrets, You See",
                        "jpn": "思い残すことはないように、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "夫の保に対して、ついに別れの言葉を発した嬉子。そんな彼女に前の管理者フレイヤが訪ねてきた。リルムの評議会は、これ以上の遅れを許さないという。このまま引き継ぎがされないと、世界は強制的に消去されてしまうのだ…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "1287161",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287161",
                    "Titles": {
                        "eng": "To Open My Mind, You See",
                        "jpn": "心を開く、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "クルージェ(さやか)を止めようとするアニエス（嬉子）の前に、数十名の魔法少女たちが立ちはだかる。攻撃から嬉子を守ったのは、さやかであった。身を挺して嬉子を守った巽に、嬉子はついにすべての真相を打ち明けるのだった…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "1287171",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287171",
                    "Titles": {
                        "eng": "The Autumn Wind is Blowing, You See",
                        "jpn": "秋の風が吹いた、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "嬉子は思い残すことがないように別居中の夫・保を訪ね、すべてを打ち明けた。魔法を自ら封じたさやかに業を煮やしたリルムの評議会は、ついに街の強制消去を決定する。不穏な風の中で、嬉子は最後の抵抗を試みていた…。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "1287181",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287181",
                    "Titles": {
                        "eng": "The Heart Is Alive, You See",
                        "jpn": "心に生きている、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "さやかを信じて指輪を託した嬉子は魔法世界リルムへと向かったが、長老の怒りを買って反乱分子として投獄されてしまう。指輪の力で世界が変わっても、裕貴の思いは同じだと確認したさやかは、ついに決意を固めて駆け出す。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "1287191",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/my-wife-is-a-magical-girl/episodes/1287191",
                    "Titles": {
                        "eng": "You Are Here With Me, You See",
                        "jpn": "あなたがそこにいる、ということ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "巽の声に応えてリルムから戻ってきた嬉子は、すべての力を使って最後まで戦い続ける。だが、クルージェ＝さやかの魔法で街は霧に包まれ始めた。はたしてこの街は、どんな世界に作り変えられてしまうのだろうか……。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}