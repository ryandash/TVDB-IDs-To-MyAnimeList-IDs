                "5": {
                    "ID": "5817888",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5817888",
                    "Titles": {
                        "eng": "Moving to Takros",
                        "jpn": "タクロスにお引越し"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "親友である山墨芳英(やまずみよしえ)が引越しをするというので、手伝いに来た解音。引越先は、立川駅前にそびえ立つ高級高層マンション。引っ越し作業中に、またまた次元空間クイズンに閉じ込められてしまった。とりあえず…解いてから考える!"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "5817889",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5817889",
                    "Titles": {
                        "eng": "Quizun Is Suddenly...",
                        "jpn": "クイズンは突然に…"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "高級高層マンションの友達の部屋で閉じ込められた解音。今回は引越会社のスタッフも一緒に閉じ込められてしまった。前回と同じように、様子が変。彼らを無事に助け、引越を終わらせるためにも、謎を解くしかない!"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "5817890",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5817890",
                    "Titles": {
                        "eng": "An Exciting, Fantastic Company Trip",
                        "jpn": "ハラハラわくわく社員旅行"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": ""
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "5817891",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5817891",
                    "Titles": {
                        "eng": "What's Sengokushi?",
                        "jpn": "泉極志って何ですか？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みなかみ温泉郷でクイズンに閉じ込められてしまった解音。大切な友達が巻き込まれたことで、今回の解音は、全力モード。楽しい社員旅行を続けるためにも、謎を解くしかない。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "5862206",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5862206",
                    "Titles": {
                        "eng": "Earth-Shattering Sound",
                        "jpn": "体が震える「極爆」"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "話題の大人気怪獣映画を見るために、立川シネマシティに向かう解音。特撮好きの解音は、テンションが上がり過ぎて映画館でクイズンに閉じ込められてしまう。とりあえず、解いてから考える！"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "5871804",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5871804",
                    "Titles": {
                        "eng": "The Q Stone Starts to Grow?!",
                        "jpn": "育ち始めた？！Ｑストーン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "映画館で閉じ込められてしまった解音。大切な友達を再び巻き込んでしまい、解音の中で何かが変わる。いつも無表情のハッチンも、どことなく様子がおかしい…？楽しみにしていた特撮映画を見るために、とりあえず、解いてから考える！"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "5871987",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5871987",
                    "Titles": {
                        "eng": "The Amazing Final Problem!",
                        "jpn": "カンドウの最終問題！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "昭和記念公園にクリスマスイルミネーションを見に来た解音。代名詞の「シャンパングラスタワー」や冬の花火で、ムードは最高。テンションが上ってしまって…クイズンに閉じ込められてしまう。こうなったら、解いてから考える!"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "5871988",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/nazotokine/episodes/5871988",
                    "Titles": {
                        "eng": "Hmm?! What Happens in the Last Episode?",
                        "jpn": "ん？！どうなる最終回！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "怒涛の最終回。とりあえず、解いてから考える!ファイナル!?"
                    },
                    "Aliases": []
                }
            }
