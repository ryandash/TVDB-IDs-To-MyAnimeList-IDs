                        "jpn": "ねらわれたQストーン"
                    },
                    "Summaries": {
                        "eng": "Trapped in the Quizun dimension, Tokine has only five minutes to solve a riddle... and she's already wasted two! Will she have her eureka moment?",
                        "jpn": ""
                    },
                    "Aliases": []
                },
