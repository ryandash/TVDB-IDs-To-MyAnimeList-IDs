            },
            "# Episodes": 25,
            "Episodes": {
                "1": {
                    "ID": "298178",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/298178",
                    "Titles": {
                        "eng": "Love Hurricane",
                        "jpn": "ラブ・ハリケーン！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "一見、色黒コギャル風な女子高生、もも（安達もも）。その外見のせいで周りからは「遊んでそう」と誤解されやすいが、実は中学からの同級生、とーじ(東寺ヶ森一矢)にひとすじ。プール焼けの肌を、とーじ好みの白い肌に戻すため、一途に涙ぐましい努力を続けていた。そんなももになにかとちょっかいを出すさえ（柏木さえ）は、他人の持ち物をすぐ欲しくなってしまう小悪魔的少女。さえに振り回されるももの前に現れる学年イチのモテ男、カイリ(岡安浬)。カイリはももとキスをしたことがある、と告白する。まったく記憶のないももは、自分にはとーじという好きな人がいるとカイリに伝える。そんなももとカイリのやりとりをさえととーじが目撃してしまう！"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "298179",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/298179",
                    "Titles": {
                        "eng": "The Trap Kiss!",
                        "jpn": "トラップ・キス！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "とーじに「好きだ！」と告白されたもも。そして、二人は晴れて付き合うことになった。そのハッピーぶりが我慢ならないさえは、ももに“自分はとーじと付き合っている”とウソをつく。ももは、とーじのサイフの中にさえの髪止めを見つけ、動揺する！一方、とーじは様子のおかしいももを心配していたが・・・"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "298180",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/298180",
                    "Titles": {
                        "eng": "How Far Will You Go, Super Sae?",
                        "jpn": "ここまでやる！？スーパーさえ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ももは、キスしようとしたとーじを思いっきり突き放す。同じ場所で、とーじとさえがキスしていたのを目撃していたからだ。とーじに“軽い女だと思われているのかも!?”と、ショックを受けるもも。しかし、そんなももを励ましたのはカイリの一言だった。とーじも家まで訪ねて来てくれて、これでももの気持ちも晴れた……と思ったら、翌朝またまたさえがやってくれた！"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "298181",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/298181",
                    "Titles": {
                        "eng": "The Catastrophe",
                        "jpn": "清く正しい破局宣言"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "とーじが入院していたことを、カイリから聞いて初めて知ったもも。クラス中を味方につけるさえのやり方に怒り心頭のももは、カイリを連れて病院へと急行する。その頃さえはとーじのお見舞い中。ももが二股をかけていると、とーじにせっせと吹き込んでいる。そこへ駆け込んでくるもも＆カイリ。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "298182",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/298182",
                    "Titles": {
                        "eng": "The Swim Meet From Hell",
                        "jpn": "灼熱怒涛の水泳大会"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついにやってしまった、ももととーじの破局宣言。自分のせいだと落ち込むカイリの前で、ももは意外にもあっさりと元気そう。だが、例によってさえが悪い噂を撒き散らし、クラスで完全に孤立してしまったもも。しかもさえの余計な一言で、水泳大会に10レースも出場することになってしまい・・・"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "378236",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378236",
                    "Titles": {
                        "eng": "Sudden Death at Love",
                        "jpn": "激突！恋のサドンデス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "水着の紐を切られたせいで、ももは100％の力が出せない。クラスの順位も上がらず、ももはクラスメイトから容赦のない罵声を浴びせられる。そんな状況を利用して、どんどんももを追い込もうとするさえ。しかもカイリまでさえにゴマをすり始めて・・・！？"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "378237",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378237",
                    "Titles": {
                        "eng": "A Brief Love Sign",
                        "jpn": "つかのまのLOVEサイン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "すべての誤解が解けて、晴れて元サヤに収まったももととーじ。しかし新学期になってクラス公認のカップルになっても、特に進展のない2人。それでも遠回りした分、2人の時間を大切にしようと、幸せいっぱいのもも。そんなある日の放課後、教室でとーじと2人っきりのいい雰囲気なり・・・"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "378238",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378238",
                    "Titles": {
                        "eng": "Fame Isn't Enough",
                        "jpn": "ブラックガール"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "超人気モデルのジゴローから告白されたさえ。しかもモデルデビューまでしてしまい、あっという間に学校はさえブームになっていた。すっかり自信を取り戻したさえは、毎日のようにジゴローと豪遊している。しかし、ももに自慢げに話しても、ももは全く興味を示さない。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "378239",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378239",
                    "Titles": {
                        "eng": "The Destruction of Pure Love",
                        "jpn": "純愛破壊工作"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「あたしの頼み、聞いてくれる？」さえはジゴローに、ももと一晩付き合ってほしいと切り出した。さえがももにいじめられていると信じているジゴローは、OKする。そんなことは露知らず、幸せ全開のももは、とーじと２人きりで自分の誕生日パーティーを過ごす約束をしていた。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "378241",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378241",
                    "Titles": {
                        "eng": "Peach Crisis",
                        "jpn": "ピーチクライシス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "さえの計画にまんまと騙された、ももととーじ。一方、さえへのリベンジに燃えていたのはカイリだった。さえを騙して、ちょっと怖い目に遭わせてやること。カイリは、ももにその状況を得意げに話しをするが、さすがにももはさえが心配になり、助けに走り出す！"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "298245",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/298245",
                    "Titles": {
                        "eng": "The Unbearable Breakup",
                        "jpn": "切なすぎる別れ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "さえの脅しからももを守るため、とーじは突然ももに別れを告げ、さえと付き合い始めた。真実を話せないとーじは、完全にももを無視する。しかし、別れの理由が思い当たらないももは、とーじを信じて、雪の降る中とーじを待ち続ける。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "378240",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378240",
                    "Titles": {
                        "eng": "The Peach Flower, Blossomed?",
                        "jpn": "ももの花、咲いた？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "季節は流れ、新しい春が来た。運命のいたずらか、もも、さえ、とーじ、カイリの４人は同じクラスになってしまった。ところ構わずベタベタするさえととーじを目の当たりにし、ももは少々ゲンナリ気味。そんな中、カイリといる時だけが、ももにとってホッとできるひと時になっていた。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "378242",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378242",
                    "Titles": {
                        "eng": "Shock! An Ex-Girlfriend Barges In!",
                        "jpn": "衝撃！元カノ乱入!?"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "急接近したももとカイリは、学校内でもすっかり噂になっていた。おもしろくないのはカイリの取り巻きたち。ある日、ももは彼女たちに絡まれてしまう。しかし、その場をカイリ本人が救ってくれたのだった。ささやかなお礼に、ももはカイリのために徹夜で手編みの携帯ケースを作ることにする。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "378243",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378243",
                    "Titles": {
                        "eng": "The Man Who Creates a Storm",
                        "jpn": "嵐を呼ぶ男"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "カイリと元カノの森香がシティホテルで会う約束をしているのを目撃したもも。当然ももは怒りまくり。次の日、カイリは学校を休んだが、ももに連絡一つよこさない。ついに我慢の限界を超えたももは、シティホテルに乗り込んでいく！"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "378244",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378244",
                    "Titles": {
                        "eng": "Who Will It Be?",
                        "jpn": "本命は誰？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "突然、涼に抱きつかれて唇を奪われてしまったもも。何とか自力で逃げ出し、助けにきたカイリにしがみつき泣きじゃくる。そしてカイリの話で、ようやくももは涼の正体を知るのだった。イヤなことを忘れさせるかのように、カイリはももに優しくキスをする。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "378245",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378245",
                    "Titles": {
                        "eng": "When Love Hits Rock Bottom",
                        "jpn": "どん底の恋の行方"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "カイリは今でも操が好きだと、あっさりと認めた。それって、今までももをダマしていたってこと？　「もう何も信じられない！」――ももはどうしても、カイリのことが許せなかった。そんな時、たまたまとーじに出会う。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "378246",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378246",
                    "Titles": {
                        "eng": "Direct Line to Pure Love",
                        "jpn": "純愛一直線"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "今は2番目でも、いつかきっと岡安の1番になるんだ…、ももは心に誓い、改めて2人の付き合いが始まった。どうやってカイリを振り向かせようかとももが考えていると、教室ではちょっとした騒ぎが起きていた。男子たちが見ている雑誌に、さえそっくりの女の子がキワドイ水着姿で出ていたのだ！"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "378247",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378247",
                    "Titles": {
                        "eng": "A Summer Seduction",
                        "jpn": "真夏の誘惑"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "コンビニの休憩室で、ももはカイリが操にキスしようとしているのを見てしまった！　カイリの気持ちはわかっていたけど、やっぱりショックを隠しきれない…。落ち込んだまま家に帰ると、なぜかさえが部屋でくつろいでいた。すっかり親友モードのさえに、ももは思い切ってすべてを打ち明ける！"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "378248",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378248",
                    "Titles": {
                        "eng": "The Emotional Puzzle",
                        "jpn": "キモチのパズル"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "バイト先のコンビニからはカイリの姿が消え、入れ違いでとーじがバイトを始めることになった！ももの気持ちは正直フクザツ…。カイリはといえば、操に告白したけど結局思いは届かず、自分の気持ちにけじめをつけるために旅に出た。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "378249",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378249",
                    "Titles": {
                        "eng": "One Stormy Night",
                        "jpn": "嵐の一夜"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついにももとカイリが旅行に行く日がやって来た！　待ち合わせは12時。でもカイリの気持ちが決まっているのかどうか、ももは不安になる。約束したときに5分待って来なかったら諦めると、カイリにも伝えておいたももだったが・・・"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "378250",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378250",
                    "Titles": {
                        "eng": "Continuous Love Storm Warnings!",
                        "jpn": "恋の再燃注意報"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ももと一緒に旅行に行ったのは、カイリではなくとーじだった。ももはカイリのことは諦めて、とーじと幸せになることを願うようになっていた。そして夏休みが終わり、2学期が始まると、ももはとーじと一緒に登校するようになっていた。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "378251",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378251",
                    "Titles": {
                        "eng": "Love in Her Head Only",
                        "jpn": "脳内恋愛"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "もものことはすっかり吹っ切れたかのように、女の子に声をかけまくるカイリ。ある日、ももは教室でカイリの生徒手帳を拾う。そこに挟まっていたのは、何とももの写真！。「なんで？」と気になるももだったが・・・"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "378252",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378252",
                    "Titles": {
                        "eng": "Forced Choice",
                        "jpn": "突きつけられた選択"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "妊娠したさえに、父親であるはずの涼はお金を渡すだけの冷たい仕打ち。一方ももは、カイリの生徒手帳を拾って持っていたところを本人に見つかってしまい、お互いの想いが爆発！ ももが一番だと言うカイリ。そこにとーじも現れ、ももはどちらを選ぶか選択を迫られる。"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "378253",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378253",
                    "Titles": {
                        "eng": "The Truth of Goodbye",
                        "jpn": "サヨナラの真実"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "結局ももはとーじを選んだ。カイリが必死にももを繋ぎ止めようとしても、ももの気持ちは動かない。数日後、ももととーじは連休のプチ旅行計画をたてていた。しかし出発日、ももの家にやってきたさえから思わぬことを聞き、ももは激しいショックを受ける!!"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "378254",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/peach-girl/episodes/378254",
                    "Titles": {
                        "eng": "The Last Hurricane",
                        "jpn": "ラスト・ハリケーン！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "旅行に出発したももととーじ。しかし、ももの心は曇っていた。自分だけ幸せになっていいのか分からなくなっていたのだ。そんな時カイリから衝撃のメールが入る！ 一方とーじはももを引き止めようとして･･･。とーじとカイリ、どちらの元に行くのか？ ももの最後の決断は!?"
                    },
                    "Aliases": []
                }
            }
        }
    }
}