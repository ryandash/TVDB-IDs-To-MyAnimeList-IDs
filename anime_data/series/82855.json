                        "jpn": "PUNK.1 / PUNK.2"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "あちこちにライバルバンドが現れ、DMCの新星を台無しにしようとしている。壮一は、あるバンドにバトルを挑むのを止めようとするが、その代わりにボーカルを奮い立たせる。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "384151",
                    "TYPE": null,
