                "3": {
                    "ID": "384147",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/detroit-metal-city/episodes/384147",
                    "Titles": {
                        "eng": "Pig / Drug",
                        "jpn": "PIG / DRUG"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "百合は雑誌社からDMCのインタビューを任されるが、聡一によって知らず知らずのうちに恥をかかされる。ひどいインタビューを掲載した後、社長はDMCの本当の生き方を教えるために壮一を訪ねる。"
                    },
                    "Aliases": []
                },
                "4": {
