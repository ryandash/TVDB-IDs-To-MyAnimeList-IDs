                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/detroit-metal-city/episodes/384148",
                    "Titles": {
                        "eng": "Frustration / Good Song",
                        "jpn": "FRUSTRATION / GOOD SONG"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "聡一は、友里の友人に店で遊ばせてもらい、一息つく。しかし彼は屈辱を味わい、酒に酔ってクラウザー2世として戻ることを決意する。クラウザー2世として戻ってくることにした。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "384149",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/detroit-metal-city/episodes/384149",
                    "Titles": {
                        "eng": "Masochist / Family",
                        "jpn": "MASOCHIST / FAMILY"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "DMCのショーに好きな女の子を誘うよう壮一に促されたとき、「資本家の豚」は栄光の瞬間を迎える。とても悪い考えだ！"
                    },
                    "Aliases": []
                },
                "6": {
