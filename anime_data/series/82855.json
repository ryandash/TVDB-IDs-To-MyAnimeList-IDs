                    "Titles": {
                        "eng": "Tower / Confession",
                        "jpn": "TOWER / CONFESSION"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "誤解からDMCのファンが東京タワーに集まることになり、聡一は彼らがトラブルに巻き込まれる前に追い払わなければならない。ユリは安里氏とデート中で、総一は2人をスパイしに行くが、悲惨な結果に終わる。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "384152",
                    "TYPE": null,
