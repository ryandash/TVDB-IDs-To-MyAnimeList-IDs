            },
            "# Episodes": 72,
            "Episodes": {
                "1": {
                    "ID": "4151954",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151954",
                    "Titles": {
                        "eng": "Here Comes the Pretty Witch",
                        "jpn": "すてきな魔女がやってきた"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔界の女王になるために人間界へと修行にやってきたメグは、魔法で先輩魔女マミの家庭・神崎家の娘となった。優しいパパ、いたずら好きの弟妹に囲まれ、人間界で暮らし始めるメグ。だが、弟ラビの度重なるいたずらに思わず手を上げてしまう。そのことをパパに怒られ…。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "4151955",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151955",
                    "Titles": {
                        "eng": "That Girl's a Rival",
                        "jpn": "あの娘はライバル"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "人間の生活を学ぶため、小百合学園へ転入することになったメグ。同じ女王候補のノンと母親がわりの魔女キーランも神崎家を訪れるが、ライバル・ノンに対抗心を燃やすメグ。学園でクラスメート達と仲良くなるメグに対し、ノンは人間と深く関わると修行のマイナスになると…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "4151956",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151956",
                    "Titles": {
                        "eng": "Lots of Witches",
                        "jpn": "魔女がいっぱい"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "神崎家のパパの「予想した体重よりも軽かったなら、その者は魔女である」という魔女裁判の話を本気にしたアポ。体重計を見て「自分も魔女の子かもしれない」と思ってしまう。それを試すため、ラビとアポはホウキ一本を持って高いところからダイビングを試みてしまい…！！"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "4151957",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151957",
                    "Titles": {
                        "eng": "The Light of Home",
                        "jpn": "わが家の灯"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "神崎家ではパパの誕生日。メグもすっかり家族の一員として準備に大忙し。そこへ、ノンからの挑戦状が届く。ノンに負けたくないメグはマミの言いつけを守らず約束の場所へと向かう。だがそれに怒ったマミは、神崎家のみんなからメグに関する記憶を消してしまい…！"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "4151958",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151958",
                    "Titles": {
                        "eng": "Witch of Love",
                        "jpn": "愛の魔法使い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ミスター天空という奇術師と知り合ったメグ。天空はパパの会社が興行する大魔術ショーに出演し、その売り上げで恵まれない子供たちの施設に図書室を作ろうとしていた。メグは感動し、学校でショーの宣伝をする。しかしそれを快く思わないノンは、天空に恥をかかせようと…。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "4151959",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151959",
                    "Titles": {
                        "eng": "Papa can't afford to Laugh",
                        "jpn": "パパは笑っちゃいられない"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "疲れた顔で朝早く家に帰ってきたパパ。実は公演のために招いた世界的なピアニスト、リヒアルト・アイゼンの世話に振り回され、ダウン寸前だった。パパの体調を心配するメグはホテルまで追いかけ、魔法でピンチを救おうとするものの、アイゼンは契約書をたてにわがまま三昧。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "4151960",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151960",
                    "Titles": {
                        "eng": "My Longing for Megu",
                        "jpn": "わがあこがれのメグ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "テニスの練習をしていたメグは、ダニーというハンサムな男の子と仲良くなり、一緒にテニスをすることになる。次第にダニーの優しさに惹かれていくメグ。そして２人でデートするのだが、メグはダニーが突然メグの手を握ってきたのに驚き、思わずその場を逃げ出してしまう。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "4151961",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151961",
                    "Titles": {
                        "eng": "A Genius at Venting his Anger",
                        "jpn": "やつあたりの天才"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "見知らぬ男の子がいじめている子犬の名前がなんと「アポ」。自分と同じ名前の子犬がいじめられるのが耐えられず、アポは止めようとするが男の子はやめようとしない。メグは何とかしようと男の子と話しをするが、今度は「神崎メグ」という名前の猫がいじめられるという始末で…"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "4151962",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151962",
                    "Titles": {
                        "eng": "True Heart's Song",
                        "jpn": "まごころの歌"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグは、木から落ちる少年タカシを魔法で助けた。彼は仕事で帰らない父を思って、遠くを見渡せるよう木に登っていた。タカシの父は有名な空中ブランコ乗りだったが、パートナーだった妻を失いサーカスから離れていた。タカシの父は帰ってくるというメグに対し、反発するノン。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "4151963",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151963",
                    "Titles": {
                        "eng": "Marvelous Balloon Trip",
                        "jpn": "すばらしい気球旅行"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "アルプスの分教場の子供たちが風船につけた手紙と花の種がメグたちの町に届き、喜ぶメグたち。小百合学園の先輩である風巻の協力を受けて熱気球でアルプスを越え返事の手紙を運ぶことになった。直接子供たちに手紙を届けたいメグはこっそり気球に乗り込むが、そこには…。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "4151964",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151964",
                    "Titles": {
                        "eng": "Messenger from the Moon",
                        "jpn": "月よりの使者"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔界の司法長官パトラがメグたちの監視をしに魔界からやって来た。チョーサンは今までの仕返しを画策。メグが魔法で人間を助ける姿をパトラに見せてメグを人間界から追い出そうと、ラビの乗っていた人力飛行機を墜落させる。ラビを助けるには、連れ戻されることを覚悟が必要！"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "4151965",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151965",
                    "Titles": {
                        "eng": "Bow-Wow Riot",
                        "jpn": "わんわん騒動"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "人には見えないものを見抜く犬こそが、魔界の者にとって苦手なものだという。だが、アポとラビはパパを説得し、神崎家に迷い込んできた大きな犬ゴンベエを家で飼い始める。そんなある日、湖に落ちたアポを助けようとするメグに向かってゴンベエが突然うなり声をあげ牙を剥く！"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "4151966",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151966",
                    "Titles": {
                        "eng": "Duel! The Magical Mansion!",
                        "jpn": "決闘！魔法屋敷"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグはチョーサンが魔界の調査官だと知るが、なりゆきで、メグ、アポ、ノンの３人でチョーサンのアジトに忍び込むことに。アジトで待ち受けていたチョーサンの攻撃に、メグは思わずアポの前で魔法を使う。魔界の掟では魔法を見られた人間をそのままにはできないが…！？"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "4151967",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151967",
                    "Titles": {
                        "eng": "Vision of a Harp",
                        "jpn": "幻の竪琴"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "湖畔へキャンプに来たメグたちは、怪しげな老婆から「美しい娘の奏でる竪琴の音に導かれ館へ入った者は二度と帰ってはこられない」という伝説を聞く。メグとノンは、どちらが先に音の正体をつきとめるかを勝負する。はたして２人の前に現れた、竪琴の音の主とは！？"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "4151968",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151968",
                    "Titles": {
                        "eng": "Papa's Lover?!",
                        "jpn": "パパの恋人"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパとママの結婚記念日のプレゼントを買いにきたメグは、偶然パパが知らない女性と歩いているのを見かける。怒ったマミはメグたちを連れて家を出ていってしまうが、身に覚えのないパパには見当がつかない。これは全てチョーサンの仕掛けた罠だったのだ。そこでメグは…。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "4151969",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151969",
                    "Titles": {
                        "eng": "From the Sky with Love",
                        "jpn": "大空より愛をこめて"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパの夢だった空中ショーが実現することに。ノンもそのポスターを描くノンのパパを魔法で助けていた。それを知ったチョーサンはショーを中止させて２人に恥をかかせようと、スカイダイビングに出演するマックスを誘拐。責任を感じたメグは、なんとマックスの替わりに…。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "4151970",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151970",
                    "Titles": {
                        "eng": "Two Megu Chan's",
                        "jpn": "二人のメグちゃん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグの後輩であるレオンは、退屈な魔界を脱走し強引に神崎家に居候する。レオンの脱走に怒った女王は、チョーサンに早く連れ戻すよう命令。メグはレオンに魔界へ帰るように説得するが、言うことを聞かない上にメグになりすまして町へ出かけ、大騒動を巻き起こしてしまう…！"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "4151971",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151971",
                    "Titles": {
                        "eng": "The Old Castle's Love Story",
                        "jpn": "古城の愛の物語"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグは、森の奥深い古城に住むグレート家の王子・ジョージと出会う。ジョージは厳格な祖父から厳しい教育を受けており、学校に行くことはおろか友達もいないという。メグは、一緒に遊びに行こうとデートの約束をするが、黙って古城から抜け出したジョージに祖父が激怒し…！"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "4151972",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151972",
                    "Titles": {
                        "eng": "Good-bye, Mr. Ghost",
                        "jpn": "さようなら幽霊さん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "神崎家にパパのお客として不思議現象を研究する佐竹氏が訪れたため、ラビとアポは家を幽霊屋敷として有名にしようと幽霊に変装。そこへ、壁をすり抜けることができる魔法薬を作り幽霊に化けてメグたちに復讐しようとするチョーサンが現われ、神崎家は大騒ぎに！"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "4151973",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151973",
                    "Titles": {
                        "eng": "Walk, Miru-chan!",
                        "jpn": "歩くのよ！ミルちゃん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ボスは人力飛行機を飛ばそうと悪戦苦闘中。足の悪い少女ミルは、魔法でもなければ空も飛べないし自分も歩けるようにならないと、歩く努力を止めてしまう。足は完治しているはず…。一方、修業の成果を試すノンとの魔法対決で、友達と争いたくないとメグはわざと負けてしまう。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "4151974",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151974",
                    "Titles": {
                        "eng": "Ex-Witch Granny Chuck",
                        "jpn": "元魔女チャックバアさん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "公園でアイスを売るチャック婆さんはなんとメグが魔女であることを見抜き、家までついてきた。実は彼女は元魔女で、メグたちに魔界に送り返す協力をしてくれと頼む。しかし魔界の掟では人間界で十年暮らした者は戻れない。神崎家にいすわるチャックにメグは大弱り。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "4151975",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151975",
                    "Titles": {
                        "eng": "When do the Stars fall into the Sea?",
                        "jpn": "星はいつ海に降るか"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグはクラスメートのシンスケが恐喝している現場に出くわし、魔法で彼が奪った財布を取り返す。だが実は、シンスケの父が会社の倒産を苦に自殺したらしい。シンスケは絶望のあまり再三自殺を試みるが、そのたびメグの魔法によって救われる。だがシンスケがそれに味をしめ…。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "4151976",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151976",
                    "Titles": {
                        "eng": "Great Operation: Tearful Humiliation",
                        "jpn": "恥かきべそかき大作戦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグにやられたチョーサンは、振り子を見た者が裸になる催眠時計を使ってメグへの復讐を企む。時計は神崎家の玄関に置かれたのだが、ロコによって学校へ寄付され、大松先生が学園中を裸で走り回る騒ぎに！あきらめがつかないチョーサンは次にメグの家のバスタブに仕掛けを…！"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "4151977",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151977",
                    "Titles": {
                        "eng": "The Stolen Dress",
                        "jpn": "盗まれたドレス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "学園祭で行われる女王コンテストに出場することになったメグとノン。メグたちのコンテスト参加が気に入らないチョーサンは、仕上がったノンのドレスを盗む。盗まれたノンとキーランは激怒、メグが疑われてしまう。メグはようやくチョーサンが犯人だという証拠をつかむが…！"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "4151978",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151978",
                    "Titles": {
                        "eng": "The Vision of a Boy",
                        "jpn": "幻の少年"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "霧がたち込めたある日やってきた転校生：真岡ジュン。ジュンを意識して恥をかいたノンは魔法で仕返ししようとするが、なぜかジュンには魔法がかからない。遠足で危機におちいった所をジュンに助けてもらい、素直な気持ちを告白するノン。だがジュンには信じられない秘密が…。"
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "4151979",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151979",
                    "Titles": {
                        "eng": "Terricfic Magical Battle",
                        "jpn": "魔法大合戦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグが女王にふさわしく思え、やる気をなくしたノン。あわてたチョーサンは、ノンのメグへの対抗心を燃やすべく作戦をたてるが失敗、すぐ魔界へ帰ると言われてしまう。修業の途中で帰ればノンもただではすまない。なんとかノンを引き止めようと、メグはわざとノンを怒らせ…。"
                    },
                    "Aliases": []
                },
                "27": {
                    "ID": "4151980",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151980",
                    "Titles": {
                        "eng": "The Scorpion's Curse",
                        "jpn": "さそり座の呪い"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "突如原因不明の病気で倒れるマミ。その腕にはあやしいサソリのアザがあった。メグはチョーサンから星占いの老婆を訪ねろと言われる。老婆の話では、マミを救うには星座の国へ行き、射手座の矢を蠍座に射るしかないと教えられるが、なんとすべて老婆に化けたサターンの罠で…！"
                    },
                    "Aliases": []
                },
                "28": {
                    "ID": "4151981",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151981",
                    "Titles": {
                        "eng": "A Baby's Fuss",
                        "jpn": "赤ちゃん騒動"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "マミに赤ちゃんができたかもしれないと聞いて大喜びの神崎家。しかし勘違いだった。妹が欲しかったアポはあきらめられない。その夜、神崎家の前になんと赤ん坊が！母親が迎えにくるまで家で預ることになる。エミちゃんと名づけられた赤ちゃんの世話を熱心に焼くアポだが…。"
                    },
                    "Aliases": []
                },
                "29": {
                    "ID": "4151982",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151982",
                    "Titles": {
                        "eng": "The Angel's Tear",
                        "jpn": "天使の涙"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "怪我をしたラビの手当てをしてくれた優しく美しいシスター、アリサ。彼女には辛い過去があった。火事でメグそっくりな妹のエリカを死なせてしまい、その罪をつぐなうために修道院に入ったというのだ。メグとシスターの仲を裂きたいチョーサンにそのことを告げられたメグは…。"
                    },
                    "Aliases": []
                },
                "30": {
                    "ID": "4151983",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151983",
                    "Titles": {
                        "eng": "The Mystery of The Abused Girl",
                        "jpn": "ふしぎないじめられっ子"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "エミという子がメグたちのクラスに転入してきた。彼女を見た瞬間に殴りかかってしまうボス。オランダの合唱団を招くことになったパパも、記者会見中に会場に居合わせたエミを殴ってしまう。あまりに奇妙な現象に、原因を探ろうとするメグ。天性のいじめられっ子の正体とは？"
                    },
                    "Aliases": []
                },
                "31": {
                    "ID": "4151984",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151984",
                    "Titles": {
                        "eng": "Echo of Love",
                        "jpn": "愛の山彦"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "エミの別荘に遊びに来たメグたち。ノンもいとこの北川と一緒に登山に行くという。だが、現地ではエミの幼なじみであるススムが、酒に溺れる父親に心を痛めていた。かつては名ガイドだったが、酒で遭難者救助に失敗し、登山をやめたという。そんな折、北川が遭難したと連絡が！"
                    },
                    "Aliases": []
                },
                "32": {
                    "ID": "4151985",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151985",
                    "Titles": {
                        "eng": "Shadow of a Witch Fluttering her Wings",
                        "jpn": "はばたく魔女の影"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔界からやって来たジョーカーは、メグとノンに白雪姫の継母が２人の美貌に嫉妬し、命を狙っていると告げる。継母は人やあらゆる動物にとりつく。最初は冷静な２人だったが、姿の見えぬ敵に対し徐々に不安にかられ始める。ジョーカーは試験官で、実は２人のテストなのだが…。"
                    },
                    "Aliases": []
                },
                "33": {
                    "ID": "4151986",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151986",
                    "Titles": {
                        "eng": "Saturn's Messenger",
                        "jpn": "サターンの使者"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔界を手に入れようと企むサターンは、ローザに女王候補であるメグを殺すよう命じる。メグは何度も狙われるが、ノンの助けによりローザを撃退、身柄を確保することができた。ノンもマミも女王の下へ連行し、処刑するようすすめるが、メグはなんと自分の家で看病を始め…。"
                    },
                    "Aliases": []
                },
                "34": {
                    "ID": "4151987",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151987",
                    "Titles": {
                        "eng": "Uninvited Guests",
                        "jpn": "招かれざる客"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "マミの魔法大学の同級生だったペニー。魔界でも有名な厚顔ぶりを発揮。自分はおろか他の同級生を呼んで、すっかり神崎家に居座る。家にある物を我が物のように使い、パパの客人にいたずらをして激怒させる等やりたい放題。メグは、５人と魔法で対決するが、負けてしまい…。"
                    },
                    "Aliases": []
                },
                "35": {
                    "ID": "4151988",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151988",
                    "Titles": {
                        "eng": "The White Horse, Upstairs in our House",
                        "jpn": "うちの２階の白い馬"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ある夜メグの部屋に舞い降りた白い馬は、見込まれた者を必ず魔界へ連れ戻してしまうキュービー。そのキュービーが、アポたちに見つかって、アポはキュービーの世話をし、ラビは乗りこなそうとする。だがもし人間である２人が見込まれて魔界に連れて行かれたら必ず死ぬ…。"
                    },
                    "Aliases": []
                },
                "36": {
                    "ID": "4151989",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151989",
                    "Titles": {
                        "eng": "The Dolls that Left",
                        "jpn": "かえらない人形たち"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ラビはアポが使っていた人形のマリーを、マンホールの中へ落としてしまった。下水道のネズミが怖くてメグも手が出ない。マリーはマミの大切な人形で、ラビは責任を感じて家出をしようとする始末。メグはマリーと対の兵隊人形のジョンに魔法をかけ、マリーを探してもらうが…。"
                    },
                    "Aliases": []
                },
                "37": {
                    "ID": "4151990",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151990",
                    "Titles": {
                        "eng": "Strange Transfer Student",
                        "jpn": "おかしな転校生"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "謎に満ちた転校生が来た日から、ボスの宿題がメグの机から出てきたり、渡したチョークが爆発したりと奇妙なことが起き続け、メグはみんなから疑われる。濡れ衣だととうとう泣き出してしまうメグ。だがそれは、双子の魔女トットとチッチを使ったチョーサンの仕業だったのだ。"
                    },
                    "Aliases": []
                },
                "38": {
                    "ID": "4151991",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151991",
                    "Titles": {
                        "eng": "Paper Planes Bound Far Away",
                        "jpn": "遠い国行き　紙ヒコーキ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ラビ達は家中の紙を紙ヒコーキにして飛ばしてしまう。ラビの友達で紙ヒコーキ名人：勇太の紙ヒコーキに魅せられたからだ。だが、たまたまラビの捕まえた金色の紙ヒコーキが魔界の重要書類で、魔力のおかげで鳥のように空を舞うので、勇太はすっかり自信を失ってしまうが……。"
                    },
                    "Aliases": []
                },
                "39": {
                    "ID": "4151992",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151992",
                    "Titles": {
                        "eng": "Santa's Name: Apo",
                        "jpn": "サンタの名はアポ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ボールを捜しに入った庭先で、アポは遊園地のような遊び場を見つける。それは奈良沢老人が孫のただしのために作ったものだった。老人に冷たく追い出されたメグは憤慨するが、パパから老人が孫を失って以来孤独になっていることを聞かされたアポは、孫のかわりになろうと……。"
                    },
                    "Aliases": []
                },
                "40": {
                    "ID": "4151993",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151993",
                    "Titles": {
                        "eng": "Great Tomboy Race!",
                        "jpn": "おてんば大レース！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "お正月早々、町内対抗のオートレースに出ることになったメグ。チョーサンが罠をしかけ、メグたちに嫌がらせをする。怒ったメグは魔法でチョーサンをやっつけるが、それに巻き込まれた破傷風の血清を運ぶバイクが壊れてしまった！このまま血清が届かなければ子供の命が危ない！"
                    },
                    "Aliases": []
                },
                "41": {
                    "ID": "4151994",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151994",
                    "Titles": {
                        "eng": "The Lost Polar Bear",
                        "jpn": "迷子の白熊くん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパが呼んだ動物サーカス団から白熊のユキが逃げ出した。しかもスポンサーであるスペンサー夫人の大事な宝石を飲み込んだままだ。追いかけられたユキは神崎家の庭へ逃げ込むが、白熊のぬいぐるみが欲しかったアポは大喜び！一方スペンサー夫人がハンターまで呼んで……。"
                    },
                    "Aliases": []
                },
                "42": {
                    "ID": "4151995",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151995",
                    "Titles": {
                        "eng": "Friendship at the Snow Festival",
                        "jpn": "友情の雪まつり"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグたちは友人に誘われ、山村の雪祭りに行くことになった。しかし車の道中はトラブル続き、あやうく崖から転落しそうになるが魔法で切り抜ける。ラビはこんな事ができるのは雪女だけだと言う。ようやく村に着くと、今度は早苗から雪の彫刻群が一晩で消えてしまう怪事件が……。"
                    },
                    "Aliases": []
                },
                "43": {
                    "ID": "4151996",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151996",
                    "Titles": {
                        "eng": "The Snow Bird's Secret",
                        "jpn": "ひみつの雪見鳥"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "早朝、マミに起こされたメグは窓の外をみてびっくり。神崎家の周りにだけ雪が積もっていた。実は魔界からやってきた雪見鳥が巣を作ったからだった。絶滅寸前の雪見鳥の卵にもしものことがあればメグも牢に入れられてしまう。だが、神崎家が映画の撮影現場になってしまい……！"
                    },
                    "Aliases": []
                },
                "44": {
                    "ID": "4151997",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151997",
                    "Titles": {
                        "eng": "The Age of Rebellion is Here",
                        "jpn": "やってきました反抗期"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "チョーサンは、ラビに反抗期促進剤を飲ませようと、ラビをアジトに連れ去ってしまった。薬を飲んで凶暴になったラビは、チョーサンのアジトで大暴れ！挙句の果てに秘密のドアを開け、魔界へ続く階段を上っていってしまった。人間が勝手に魔界へ入れば、ただではすまない……！"
                    },
                    "Aliases": []
                },
                "45": {
                    "ID": "4151998",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151998",
                    "Titles": {
                        "eng": "Red Shoes of Friendship",
                        "jpn": "友情の赤い靴"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "スケートが苦手なメグは、氷の妖精から特訓を受けた。ある日赤いスケート靴を目にとめ、同じ靴を買おうとしていたアケミと友達になる。一方、チョーサンはスケート大会のノンのライバルがアケミだと知り、ノンを勝たせるため練習を妨害、アケミに怪我をさせてしまう……。"
                    },
                    "Aliases": []
                },
                "46": {
                    "ID": "4151999",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4151999",
                    "Titles": {
                        "eng": "Tale of North Spring Winds",
                        "jpn": "北風・春風物語"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグの前に現れた春の妖精：ルウ。冬の妖精：サムサがいるために力が出ず、メグの買った植木鉢の中に隠れていたというのだ。サムサが居る限り春が来ないことを知り、ルウに協力するメグ。一方それを知ったサムサは、ノンを使ってルウを追いだそうと企むが……。"
                    },
                    "Aliases": []
                },
                "47": {
                    "ID": "4152000",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152000",
                    "Titles": {
                        "eng": "Spring in a Yacht",
                        "jpn": "春はヨットに乗って"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "湖でノンのヨットとメグたちのボートが衝突。メグはノンの無礼に怒り、ヨットを傷つけられたノンは、ヨットで勝てば謝るという。怒ったメグは早速ヨット部を作るが、ノンからヨットを借りる条件は湖を３０分で一周すること。湖に出たメグ達に不思議な霧や竜巻が襲いかかって！"
                    },
                    "Aliases": []
                },
                "48": {
                    "ID": "4152001",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152001",
                    "Titles": {
                        "eng": "A Doll's Poem",
                        "jpn": "にんぎょうの詩"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパの知人のヒムラー女史が、古い日本人形の修理できる人を探していた。そこでメグとアポは人形作家の川島ミツを訪ねる。だが人形を見るなり「修理はできない」と断わるミツ。なんとその人形はスイスに留学したミツが、友情の証にヒムラーと交換したものなのだが……。"
                    },
                    "Aliases": []
                },
                "49": {
                    "ID": "4152002",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152002",
                    "Titles": {
                        "eng": "Pinwheel's Song",
                        "jpn": "風車のうた"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "地上へ追放された母に会うため、魔界を脱走した女の子ミミ。事情を知ったメグは、ミミの母のベルをつきとめ、二人を再会させようとする。しかし魔力のないベルは、魔界へいくことができない。メグが禁を破ってベルに水の魔法を教えたため、魔界の検察官に捕えられてしまった！"
                    },
                    "Aliases": []
                },
                "50": {
                    "ID": "4152003",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152003",
                    "Titles": {
                        "eng": "The Flying Bag",
                        "jpn": "空飛ぶカバン"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "進級祝いに新しくカバンを買ってもらったラビ。だがカバンはチョーサンたちに盗まれ、通りがかったノンが阻止。結果、教会に住むゴロー少年に拾われてしまう。「空を飛ぶカバン」を目撃したゴローは、カバンを使って病弱な友人ジュンの「空を飛ぶ夢」を叶えようとしていた。"
                    },
                    "Aliases": []
                },
                "51": {
                    "ID": "4152004",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152004",
                    "Titles": {
                        "eng": "Please Take Care of Tarou",
                        "jpn": "タローをよろしく"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "山へ写真を撮りに来たパパが車に戻ると、トランクの中になんと熊が入っていた！飼い主の少年が町へ出稼ぎに行くため仕方なく捨てたらしい。結局、この熊：タローはしばらく神崎家で飼われることになった。それを知ったチョーサンはタローを逃がし町で暴れさせようと企む！"
                    },
                    "Aliases": []
                },
                "52": {
                    "ID": "4152005",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152005",
                    "Titles": {
                        "eng": "Gonbee has Returned",
                        "jpn": "帰ってきたゴンベエ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "神崎家にあの大きな犬、ゴンベエが戻ってきた。飼い主が旅行する間だけ預かることになったのだが、以前ゴンベエに命を救われたアポは大喜び。すっかり神崎家になじむゴンベエ。一方チョーサンはメグが犬と仲良くすることが気に食わず、アポを幼稚園から連れ出してしまい……。"
                    },
                    "Aliases": []
                },
                "53": {
                    "ID": "4152006",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152006",
                    "Titles": {
                        "eng": "The Demon World's Failure",
                        "jpn": "魔界の落第生"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "突然魔界に呼び戻され、ノンと共に女王様の前に出たメグは、チョーサンがつけたオール×の成績を理由に女王候補失格を言い渡されてしまう。そればかりか二度と下界へ戻ることも許されないというのだ。諦められないメグは、もう一度だけやり直すチャンスが欲しいと懇願する……。"
                    },
                    "Aliases": []
                },
                "54": {
                    "ID": "4152007",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152007",
                    "Titles": {
                        "eng": "Missing Cat",
                        "jpn": "迷子の迷子の仔猫ちゃん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "仔猫をかばって怪我をした母猫ジュンを、ゴンベエが神崎家に運んできた。メグはジュンの傷が治るまでの間、マイクロバスに住むジュンの仔猫たちの世話をするが、チョーサンに知られ、バスを森の中に隠される。メグはチョーサンをやっつけるが、バスは誰かに持ち去られた後……。"
                    },
                    "Aliases": []
                },
                "55": {
                    "ID": "4152008",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152008",
                    "Titles": {
                        "eng": "Who's The Criminal?",
                        "jpn": "犯人は誰だ？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "深夜、謎の猛犬に襲われる事件が多発していた。現場にはセントバーナードの毛が残されており、疑われるゴンベエ。ゴンベエがいない夜に猛犬が町を荒らし回ったため、神崎家に抗議が殺到、ゴンベエを引き渡せという警察の要求に、無実を信じるアポはゴンベエを連れて逃げるが……。"
                    },
                    "Aliases": []
                },
                "56": {
                    "ID": "4152009",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152009",
                    "Titles": {
                        "eng": "Secret of The White Lily",
                        "jpn": "白百合の秘密"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグのクラスにユリという美少女が転校してきた。しおれた花を甦らせるユリを、魔女だと疑うノン。その後ユリはメグのパパからモデルを依頼される。チョーサンがそのショーで正体を確認。なんとユリは花の妖精で、魔界から指名手配中。そんな彼女をサタンが利用しようと……。"
                    },
                    "Aliases": []
                },
                "57": {
                    "ID": "4152010",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152010",
                    "Titles": {
                        "eng": "Carp Streamers High in the Sky",
                        "jpn": "大空高く鯉のぼり"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "女王様から子供の日のプレゼントに一つだけ願いを叶えてやると言われたメグ。ただし期限は５日の夕方まで。そんな折、チョーサンに、神崎家の鯉のぼりを盗まれ。メグは鯉のぼりを取り戻すが、途中で金魚売りの車を壊し、金魚売りの息子：さん太に怪我をさせてしまい……。"
                    },
                    "Aliases": []
                },
                "58": {
                    "ID": "4152011",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152011",
                    "Titles": {
                        "eng": "Where are you, Gonbee?",
                        "jpn": "どこへ行ったのゴンベエ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ある雨の日、ゴンベエは傘を持ってアポの帰りを待っていた。一方ラビは、ゴンベエが自分の命令を聞かないことに腹を立て、自分のいたずらをすべてゴンベエのせいにしてしまった。怒ったパパは罰としてゴンベエを鎖で繋ぐ。チョーサンがそのゴンベエを売り払ってしまい……！"
                    },
                    "Aliases": []
                },
                "59": {
                    "ID": "4152012",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152012",
                    "Titles": {
                        "eng": "The Girl in The Rain",
                        "jpn": "雨の中の少女"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "次に日曜が晴れたらピクニックに行けるため、ラビがお祈りをしに教会に立ち寄ると、そこには雨が降るようにと祈る少女がいた。雨がふれば１年ぶりに両親に会えるという。一方マミは、ラビが独り言をいいながら歩いていたと聞き、死霊に取り付かれているのではないかと疑う。"
                    },
                    "Aliases": []
                },
                "60": {
                    "ID": "4152013",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152013",
                    "Titles": {
                        "eng": "Young Master's Great Circus",
                        "jpn": "若さま大サーカス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパの会社が招いたアラスカ大サーカス。切符は完売したのになぜかお客が全然来ない。大富豪の息子たか丸が人間恐怖症だったため、切符を全部買い占めていたのだ。メグが魔法で呼んだ大勢の観客に気絶するたか丸。意識が戻ると、今度はメグをお嫁さんに欲しいと言い出し……。"
                    },
                    "Aliases": []
                },
                "61": {
                    "ID": "4152014",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152014",
                    "Titles": {
                        "eng": "Rainman",
                        "jpn": "雨ふりおじさん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "雨の中で遊んでいたラビとアポは傘職人：ツユスキーと友達になる。実はツユスキーは魔界一の怠け者で、女王の命令により町中の傘をすべて直しにきたのだ。彼自身が雨男のため、雨が降り続き、町にがけ崩れや洪水の危険が発生。ある日、川へ遊びに行ったラビとアポに危機が……！"
                    },
                    "Aliases": []
                },
                "62": {
                    "ID": "4152015",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152015",
                    "Titles": {
                        "eng": "Due by Midnight, Bound for The Witch Kindgom",
                        "jpn": "ま夜なか発、魔女の国ゆき"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "町中に現れた「魔女の国行き」のバス停。ラビ達からその話を聞いたメグは驚き、ノンと共に犯人を捕まえることにした。だが、バスが向かう先はなんと遊園地。実はパパが宣伝用に考えたアトラクション。このままでは魔女の国をお金もうけに利用したパパが呪われてしまう！"
                    },
                    "Aliases": []
                },
                "63": {
                    "ID": "4152016",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152016",
                    "Titles": {
                        "eng": "The Blue Star of Tanabata",
                        "jpn": "七夕の青い星"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔界からマミの元にブルーレターが届く。それは人間界にいる魔女のテストの通知。失格すればマミは魔界へ帰らなければならない。秘密の部屋でのマミの特訓を、ラビの友達：勇太に見られてしまう。死んだ母親が星になると信じる勇太は、神崎邸から母の星を捜していたのが……。"
                    },
                    "Aliases": []
                },
                "64": {
                    "ID": "4152017",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152017",
                    "Titles": {
                        "eng": "The Fuss of Not Swiming",
                        "jpn": "カナヅチ騒動"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "泳げないラビが、偶然川で溺れかけた少女を助けて新聞で取り上げられ、好きなあゆみにプールで模範演技をして欲しいと頼まれてしまった。ラビは泳げるように特訓するが失敗ばかり、見かねたメグは体が水に浮く魔法の水着をプレゼントするが、チョーサンのいたずらのせいで……。"
                    },
                    "Aliases": []
                },
                "65": {
                    "ID": "4152018",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152018",
                    "Titles": {
                        "eng": "The Dreamy Trolley Car",
                        "jpn": "夢のチンチン電車"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "アポの友達で電車マニアのテツオは、おじいさんがチンチン電車の運転手をしているのが自慢だった。興味を持ったメグは交通博物館へでかける。そこでお世話になった係員こそ、テツオのおじいさんだった。おじいさんは引越しを嫌がるテツオを喜ばそうとウソをついていたという。"
                    },
                    "Aliases": []
                },
                "66": {
                    "ID": "4152019",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152019",
                    "Titles": {
                        "eng": "Foggy Morning Paper, Tarou",
                        "jpn": "霧の中の朝刊太郎"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグは早朝みかけた新聞配達の少年が気になり、翌朝の配達を見張る。驚いたことに彼は新聞を抜き取っていた。問い詰めるメグに少年、太郎は「不幸な記事はみんなに見せたくない」という。チョーサンに追われ光を見たとたんに姿を消す太郎。メグは正体を探ろうとするが……？"
                    },
                    "Aliases": []
                },
                "67": {
                    "ID": "4152020",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152020",
                    "Titles": {
                        "eng": "The Guitar and the Boy",
                        "jpn": "ギターと少年"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "楽器店からギターを盗もうとした少年：マサオが逃亡していた。警察犬に捕まえられてしまうが、現場を通りかかったノンは彼を助け、自分の部屋に匿う。事情を調べたメグはマサオが心臓病の手術を怖がる妹にギターを弾く約束をしていたことを知り、力になりたいと思うのだが……。"
                    },
                    "Aliases": []
                },
                "68": {
                    "ID": "4152021",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152021",
                    "Titles": {
                        "eng": "Nya-Nya! Summer Vacation!",
                        "jpn": "夏休みのあかんべぇ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "高原へ旅行に出かけた神崎一家だが、その時撮った全ての写真にあかんべぇをする見知らぬ少年が写っていた。ノンも同様の被害に。メグは少年が魔界の人間ではないかと疑う。その時少年からメグに電話が！「早く自分を捜さないとメグとノンが魔女だとばらす」というのだが……！"
                    },
                    "Aliases": []
                },
                "69": {
                    "ID": "4152022",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152022",
                    "Titles": {
                        "eng": "Revenge Dog Sigma",
                        "jpn": "復讐犬シグマ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "大松先生の代わりの先生。その正体は魔界の凶悪脱獄犯の魔女：ジロン。女王候補であるメグとノンを狙っていた。一方メグは片目のグレートデンに襲われるが、その犬は魔界の警備犬：シグマで、脱走したジロンを追っていた。やがてジロンは正体を現しメグたちに襲い掛かるが……！"
                    },
                    "Aliases": []
                },
                "70": {
                    "ID": "4152023",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152023",
                    "Titles": {
                        "eng": "Great Kite, Fly me with the Sea Wind",
                        "jpn": "大凧よ海風に舞え"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "パパの会社で世界中の凧の空中展示会を催すことになった。凧が縁で知り合った吾助爺さんの家で大凧を見つけ、展示会であげようとするが、チョーサンに邪魔され、大凧はボロボロに……。倒れて気力を失った吾助爺さんを元気づけようと、メグは再び大凧をあげることに挑戦する。"
                    },
                    "Aliases": []
                },
                "71": {
                    "ID": "4152024",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152024",
                    "Titles": {
                        "eng": "Final Battle: The Greatest Magic!",
                        "jpn": "決戦・大魔法！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "メグとノンを殺そうとサターンが最後の攻撃をしかけてきた。サムサに命じて大雪を降らせ「すべて魔女のせいだ」と触れ回って人々に不安を植え付ける。マミがサムサを撃退するが、今度はジョーカーが人々に憑依し町は大混乱！アポの危機にメグが人前で魔法を使ってしまい……。"
                    },
                    "Aliases": []
                },
                "72": {
                    "ID": "4152025",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/little-meg-the-witch-girl/episodes/4152025",
                    "Titles": {
                        "eng": "Farewell, Megu-Chan",
                        "jpn": "さようならメグちゃん"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "女王の命令で修業を終え、魔界に帰ることになったメグとノン。メグは神崎家を離れたくはなかったが、マミは修業は終わったとメグを突き放し、荷物を片付け、パパたちからメグの記憶を消してしまう。しかしアポがメグの記憶を取り戻し、雨の中捜しに出て高熱を出してしまう……！"
                    },
                    "Aliases": []
                }
            }
        }
    }
}