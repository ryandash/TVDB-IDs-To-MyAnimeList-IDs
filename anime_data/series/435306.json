                    "URL": "https://www.thetvdb.com/series/odekake-kozame/episodes/9966773",
                    "Titles": {
                        "eng": "Shaved Ice",
                        "jpn": "かき氷"
                    },
                    "Summaries": {
                        "eng": "Episode 6",
                        "jpn": "セミの鳴き声が響きわたり、太陽がじりじりと照りつける暑い日におでかけしていた子ザメちゃんは、かき氷を売っているお店を見つけて注文するのだが……。"
                    },
                    "Aliases": []
                },
                "7": {
