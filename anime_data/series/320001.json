            "# Episodes": 12,
            "Episodes": {
                "1": {
                    "ID": "5845949",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5845949",
                    "Titles": {
                        "eng": "Iberico Ham, Roasted Poele-Style with Sage",
                        "jpn": "イベリコ豚のセージ風味ポワレ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "夏休み前の下校途中。七瀬 萌里菜は、バイト募集の看板を見つける。\r\n雑木林の先にあったトラットリア『フェスタ』は、イタリアンのお店。\r\nイタリアンを知らない萌里菜は、バイト出来るの？"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "5930151",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5930151",
                    "Titles": {
                        "eng": "Penne Arrabbiata",
                        "jpn": "アラビアータ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "無事フェスタでバイトすることになった萌里菜。\r\nまだまだ分からないことだらけでも、基本から頑張れば、きっと大丈夫。\r\nそんなとき、シェフの桐秀が作ったペンネ・アラビアータをこぼしてしまい、大変なことに！！\r\n萌里菜は無事乗り切れるのか！？"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "5930152",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5930152",
                    "Titles": {
                        "eng": "Tiramisu",
                        "jpn": "ティラミス"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "よく見かける男の人に、覚えたての情報と合わせて、\r\nほろ苦い甘さのティラミスをオススメする萌里菜。\r\nそしたら、まさかの苦さ無しの甘～い言葉の嵐が。\r\nあれ？その男の人って、まさか！？"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "5930154",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5930154",
                    "Titles": {
                        "eng": "Caponata",
                        "jpn": "カポナータ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「燃える炎の牛刀」突如、掛け声とともに変なポーズを決めるマロたち4人。\r\n乗り切れなかった萌里菜だけが置き去りにされるも、いつもと変わらないフェスタに「いつものアレ」を食べに謎の老人と孫娘の着物少女がやってきた。\r\n緊迫した空気の中、萌里菜は、ミスなくサーブ出来るのか！？"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "5962833",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962833",
                    "Titles": {
                        "eng": "Sangria",
                        "jpn": "サングリア"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "沙羅から衝撃の言葉を言われ、ショックをうけるマロたち。\r\nとくに、桐秀から食の在り方を教わっていた萌里菜にとっては、\r\nそれは悲しく、傷つくもので。つい、沙羅に対して怒ってしまう。\r\n萌里菜の言葉は、沙羅に届くのか？"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "5962893",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962893",
                    "Titles": {
                        "eng": "Chef",
                        "jpn": "シェフ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "怒りにまかせて、フェスタの壁を壊してしまった萌里菜は、フェスタを立ち去る決心をする。\r\n初めてのバイト、心地良かったフェスタ…辞めたくない思いと、いくつもの思い出を風呂敷に包んで持っていく、さらばフェスタ。\r\n萌里菜、本当にフェスタを辞めてしまうの？"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "5962894",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962894",
                    "Titles": {
                        "eng": "Peperoncino",
                        "jpn": "カプレーゼ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "沙羅に頼まれ、料理を作ることになった萌里菜。イタリアンのシェフを目指すことを宣言したけど、どうやって作ればいいの？何を作れば、沙羅は喜んでくれるの？まだまだ分からないことだらけ。\r\n萌里菜は、沙羅に料理を出せるのか！！"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "5962895",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962895",
                    "Titles": {
                        "eng": "Zuppa Inglese",
                        "jpn": "ズッパ・イングレーゼ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "「また来た」瑠梨の言葉で、フェスタ内に緊張が走る。おじじ様が沙羅と謎の男の人を連れて、フェスタに再来店。沙羅のリクエストで、また萌里菜が作ることになったけど、あの おじじ様に何を出せばいいの？悩める萌里菜に、沙羅から素敵な提案が！！\r\n果たして、おじじ様のお口に合うのか！？"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "5962896",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962896",
                    "Titles": {
                        "eng": "Fritters",
                        "jpn": "フリット"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "おじじ様の一言で、祭礼で働くことになった萌里菜。どっしりと構える祭礼の雰囲気に圧倒され、日本料理の美しさに感激する。祭礼にしかない上品さや香りにフェスタとの違いを感じたとき、萌里菜の前に横切ったのは、あの香り。\r\n萌里菜！このまま、祭礼で働くの？"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "5962897",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962897",
                    "Titles": {
                        "eng": "Panna Cotta",
                        "jpn": "パンナコッタ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "商店街のお祭りで、屋台を出すことになったフェスタ。普段と違う雰囲気に盛り上がるマロたちは、お祭り限定のお料理に腕を奮う。そこに、萌里菜と一緒に謎のイケメンが登場！？マロの心が震え上がる。\r\nせっかくのお祭りなのに、一波乱が起こる予感！！"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "5962898",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962898",
                    "Titles": {
                        "eng": "Beef Tagliata",
                        "jpn": "タリアータ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "フェスタをお休みして、皆でピクニック。どこに行くかは、まだ内緒。萌里菜の親友 李依も、途中で見かけた沙羅とおじじ様も乗せて、さあレッツ・ゴー！\r\nいったい、どこに行くの？"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "5962899",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/piacevole-my-italian-cooking-1/episodes/5962899",
                    "Titles": {
                        "eng": "Insalata",
                        "jpn": "インサラータ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "イタリア帰りの衛が、トラットリア『フェスタ』で出会ったのは、マロと桐秀と瑠梨。店内は、お料理の美味しい香りがするのに、どこか寂しい香りも交じっていて…\r\nこれは今と同じようで、でも、少しだけ彩りが、まだ足りないフェスタのお話。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}