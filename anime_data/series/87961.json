            "Episodes": {
                "1": {
                    "ID": "504281",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/zettai-shogeki-platonic-heart/episodes/504281",
                    "Titles": {
                        "eng": "Fate Begins to Take Its Course",
                        "jpn": "走り出す宿命"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "女子高生の伊勢島綾と本間棗は、往来のど真ん中で繰り広げる巫女とCAの戦いに遭遇する。友人の棗まで巻き込まれたことに憤った綾は、自らの拳に任せてCAを撃退する。その強さと行動力が、『プラトニックハート』と称される「望みを叶えるための究極の戦い」へと彼女をいざなう運命のパスポートだとも気づかずに……。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "504291",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/zettai-shogeki-platonic-heart/episodes/504291",
                    "Titles": {
                        "eng": "The Reason for Fighting",
                        "jpn": "戦う理由"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "友達になった美子を探すためにプラトニックハート争奪戦への参加を決めた綾。しかし、次の相手は綾が慕っている学校の化学教師、須磨先生だった。動揺して戦いに集中できない綾に対して、容赦ない強烈な攻撃を仕掛ける須磨。相手を打ち倒さずには決して勝ち取れない『願い』。その現実に直面した時、綾が出した結論とは？"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "504301",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/zettai-shogeki-platonic-heart/episodes/504301",
                    "Titles": {
                        "eng": "The Archenemies, The Three Sisters",
                        "jpn": "怨敵の三姉妹"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "争奪戦の過酷な現実に、すっかり疲れきってしまった綾を気遣って、棗は綾を気晴らしにプールへと誘う。だが、そこでも休息は許されなかった……。新たな敵は、芸者、ナース、婦警の三姉妹。プラトニックハートの秘密を知っているという三姉妹の誘いに乗り決戦場の港へ向かう綾。そして戦いの果てに綾が目にしたものとは？"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "504311",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/zettai-shogeki-platonic-heart/episodes/504311",
                    "Titles": {
                        "eng": "Quietly, Like the Sand at the Bottom of a Deep Sea",
                        "jpn": "静かに、澱のように"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "もう、何を信じれば良いのか分からない……。目の前の現実は綾を激しく動揺させた。だが、綾の苦悩を他所にプラトニックハート争奪戦は淡々と進行していく。次なる相手はメイド喫茶のアイドル。美子を見つけ、本当のことを知るには勝ち抜くしかない、そんな思いから再び前を見据えた綾の元に最終戦の告知が着信する……。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "504321",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/zettai-shogeki-platonic-heart/episodes/504321",
                    "Titles": {
                        "eng": "Torch",
                        "jpn": "焔"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "最後にして最強の敵。それは相手の心を読める占い師だった。全ての力を結集して臨む綾だが、敵の能力の前に全く歯が立たない。豪雨と雷鳴の中、綾は最後の力を振り絞って大地を蹴った……。プラトニックハート争奪戦の末、綾が手にしたものは？ 美子の行方は？ そして、プラトニックハートを取り巻く真実とは……。"
                    },
                    "Aliases": []
                }
            }
        }
    }
