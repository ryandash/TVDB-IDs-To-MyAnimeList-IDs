                    "Titles": {
                        "eng": "Donca☆Sis",
                        "jpn": "イモ☆ヨバ"
                    },
                    "Summaries": {
                        "eng": "Iyo Sakuragi and Hojo become step-siblings after their parents, portrayed by Popuko and Pipimi, get married. Other skits include a cooking show hosted by Popuko and Pipimi, Pipimi literally growing with affection for Popuko, and Popuko doing a poor impression of Mickey Mouse.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
