                    "Titles": {
                        "eng": "SWGP 2018",
                        "jpn": "SWGP2018"
                    },
                    "Summaries": {
                        "eng": "Popuko takes part in the Skeleton World Grand Prix, facing many tough opponents. Other skits include a parody of Earth, Wind & Fire's \"Let's Groove\", Popuko being forced to evict an extraterrestrial being from her house, and Popuko and Pipimi encountering a boss while exploring a dungeon.",
                        "jpn": ""
                    },
                    "Aliases": []
                },
