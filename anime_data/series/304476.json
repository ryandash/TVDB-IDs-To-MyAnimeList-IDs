            "# Episodes": 50,
            "Episodes": {
                "1": {
                    "ID": "5440090",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5440090",
                    "Titles": {
                        "eng": "A Miraculous and Magical Encounter! The Magical PreCures are Born!",
                        "jpn": "出会いはミラクルでマジカル！魔法のプリキュア誕生！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "大きな月が空に浮かんだ夜。もうすぐ中学2年生になる朝日奈みらいは、空から何かが落ちてくるのを見た。彼女は好奇心が旺盛。次の朝、みらいはぬいぐるみのモフルンを連れて、前日に見た何かを探しに行く。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "5510307",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5510307",
                    "Titles": {
                        "eng": "To the Exciting Magic School! Where's the Principal!?",
                        "jpn": "ワクワクの魔法学校へ！校長先生はどこ!?"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいとリコは、伝説の魔法つかい・プリキュアに変身した。みらいは、魔法学校に戻って校長先生に相談する、と言うリコに連れられて魔法界へ行くことになった。勝手に魔法界から出てきたリコは…。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "5510308",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5510308",
                    "Titles": {
                        "eng": "Shopping in the Magic Shopping Street! The Power of Ruby is Awakened!",
                        "jpn": "魔法商店街でショッピング！目覚めるルビーの力！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "春休み中、みらいはリコと一緒に魔法学校に通うことになった。早速、魔法商店街で、学校の制服や魔法のほうきを買う。これでみらいの気分はすっかり魔法使い。だが、すぐに魔法使いにはなれず…。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "5510309",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5510309",
                    "Titles": {
                        "eng": "Magic Class Starts! The Search for a Mysterious Butterfly!",
                        "jpn": "魔法の授業スタート！ふしぎなちょうちょを探せ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法学校の授業が始まった。みらいとリコと一緒に勉強するのは、ジュン、エミリー、ケイ。アイザック先生の下、計6回の授業を受けることになった。授業では紙でできた魔法の蝶々を捕まえたりする。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "5536280",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5536280",
                    "Titles": {
                        "eng": "Passing One Another on the Ice Island!? Friendship Connected by Magic!",
                        "jpn": "氷の島ですれ違い！？魔法がつなぐ友情！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいとリコは、図書室で魔法界の伝説の本「リンクルスマホン」を見つける。すると、リンクルスマホンから突然、妖精の赤ちゃんが生まれた。校長先生もそのことが理解できず、どうすることもできない。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "5536281",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5536281",
                    "Titles": {
                        "eng": "Special Training! Magic Wand! Liko's Sister is the Teacher!?",
                        "jpn": "特訓！魔法の杖！先生はリコのお姉ちゃん！？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "3回目の魔法の授業。リコは教室に入ってきた先生を見て驚く。先生は彼女の姉・リズだった。リズは魔法学校の生徒だが、魔法の杖を使うのがうまかった。体調不良のアイザック先生に代わって、リズが教えることに。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "5536282",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5536282",
                    "Titles": {
                        "eng": "Mermaid Village Magic! Feelings of Sapphire Revived!",
                        "jpn": "人魚の里の魔法！よみがえるサファイアの想い！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法の授業は、海の中で始まった。先生は人魚のロレッタ先生だ。マール貝に話し掛けて、口を開くことができれば、合格となる。マール貝は無理矢理開けようとしたり、大声で話し掛けても、全く口を開かない。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "5536283",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5536283",
                    "Titles": {
                        "eng": "GO with a Magic Broom! Save the Pegasus Family!",
                        "jpn": "魔法のほうきでGO！ペガサス親子を救え！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "5回目の魔法の授業は、空を飛ぶペガサスと一緒に魔法のはねペンで記念撮影をすることだ。そうするには、魔法のほうきでペガサスを追い掛ける必要がある。みらいは1人でほうきに乗るのは初めてだが…。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "5564564",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5564564",
                    "Titles": {
                        "eng": "Goodbye Magical World!? Mirai and Riko's Final Test!",
                        "jpn": "さよなら魔法界！？みらいとリコの最終テスト！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法の授業では、最後のテストが行われる。リコは合格すれば、2年生になれる。テストの内容は、つぼみに魔法をかけてビックリ花を咲かせること。みらいは、やる気があるが、リコは少し寂しそうだった。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "5564565",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5564565",
                    "Titles": {
                        "eng": "I'm Home! The Non-Magical Realm! ...Wait, Where's Liko?",
                        "jpn": "ただいま！ナシマホウ界！ってリコはどこ？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいは補習の授業も終わり、ナシマホウ界に帰ることになった。そんな時、リコがほうきでみらいが乗っているカタツムリニアを追い掛けてきた。リコもナシマホウ界へ行くことになったため、2人は大喜びする。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "5577964",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5577964",
                    "Titles": {
                        "eng": "Mofurun's First School Visit? Get the Exciting Topaz ~mofu!",
                        "jpn": "モフルンの初登校？ワクワクのトパーズをゲットモフ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいはリコと一緒に、久しぶりに家に帰ってきた。リコは、みらいと同じ中学校に通うことになった。また、みらいのお母さんから「うちから通えばいいじゃない」と言われ、リコはみらいと一緒に暮らすことになった。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "5577965",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5577965",
                    "Titles": {
                        "eng": "The Whole Starry Sky and Mirai's Memories",
                        "jpn": "満天の星空とみらいの思い出"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ナシマホウ界の学校の授業が始まる。リコは勉強に自信があり、張り切っていた。放課後、クラスメートにバレーボールに誘われても、みんなが遊ぶ様子をメモして、バレーボールの研究のために先に帰ってしまう。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "5577966",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5577966",
                    "Titles": {
                        "eng": "Fun BBQ! Finding So Much Happiness!",
                        "jpn": "たのしい BBQ！幸せたくさんみ～つけた！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みんなでバーベキューをすることになった。みらいとリコは、友達たちと一緒にみらいのお父さんの車で目的地に向かうことになった。また、魔法界からリコの姉・リズがやって来て、彼女も一緒にバーベキューをする。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "5577967",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5577967",
                    "Titles": {
                        "eng": "Flower Marks for Everyone! Test Mission!",
                        "jpn": "みんな花マル！テスト大作戦！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "リコは数学のテストで、クラスで1人だけ100点を取った。一方、みらいは赤点を取ってしまう。再度テストを受けることになったみらいだが、国語、英語、理科は気持ちが高ぶるのに、数学だけはそうならなかった。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "5611474",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5611474",
                    "Titles": {
                        "eng": "Very Chaotic! Ha-chan’s Seven Transformations!",
                        "jpn": "ハチャメチャ大混乱！はーちゃん七変化！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ある朝のこと。お腹がすいて目が覚めたはーちゃん。みらいやリコに朝ごはんを食べようと言いたいが、寝坊したみらいは準備に大忙し、リコは授業の予習をしていて、モフルンは寝ぼけて、起きようとしない。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "5611475",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5611475",
                    "Titles": {
                        "eng": "Long Time No See! Friends From Magic School Have Arrived!",
                        "jpn": "久しぶりっ！補修メイトがやってきた！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法界で一緒に授業を受けたジュン、ケイ、エミリーがナシマホウ界へやって来て、みらいとリコは大喜び。だが、魔法学校の2年生になったジュンたちは、魔法が上手に使えるようになっていてリコは焦る。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "5611476",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5611476",
                    "Titles": {
                        "eng": "Tell me Crystal Ball! Who is the Person in Grandma’s Memories…",
                        "jpn": "水晶さん教えて！おばあちゃんの思い出の人"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "家で掃除をするみらいたち。すると、古いアルバムが出てきた。ある公園で写っている15歳ぐらいの女の子は、みらいのおばあちゃんだった。この公園で出会った不思議な人のことを忘れられないとおばあちゃんは言う。"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "5611477",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5611477",
                    "Titles": {
                        "eng": "Back to the Magical World! Recover the Linkle Stone!",
                        "jpn": "魔法界再び！リンクルストーンを取り戻せ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "はーちゃんが持っていたリンクルストーン・ガーネットが、ガメッツに奪われてしまい、はーちゃんはショックで泣いてしまう。そんな時、みらいとリコ宛に手紙が届いた。それは、ガメッツからの挑戦状で…。"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "5638579",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5638579",
                    "Titles": {
                        "eng": "Exploration and Adventure! The Mysteries of Magic Door!",
                        "jpn": "探検＆冒険！魔法のとびらのナゾ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "はーちゃんの言葉に答えたリンクルスマホンの光が、ガメッツの闇のオーラを消した。みらいとリコは、このことを校長先生に聞いてみようと魔法学校へ向かう。ところが、校長先生は誰にも言わずにいなくなっていた。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "5638580",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5638580",
                    "Titles": {
                        "eng": "Super Terrible Fall! The Emerald That is Born Within the Magical Realm!",
                        "jpn": "ドタバタでヤバスギ！魔法界に生まれたエメラルド！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "リンクルスマホンの中で、熟睡してしまったはーちゃん。すると、スマホンが光り、開かずの扉が開いた。だが、扉の先に向かうと、そこはぶどうが並んだ魔法商店街。校長先生はどこを探しても見当たらない。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "5638581",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5638581",
                    "Titles": {
                        "eng": "Stop! Dark Magic! PreCure vs. Dokuroxy!",
                        "jpn": "STOP！闇の魔法！プリキュアVSドクロクシー！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "はーちゃんが眠っているリンクルスマホンをドクロクシーが飲み込み、完全体になった。魔法樹の葉がどんどん枯れて、魔法界もナシマホウ界も闇に包まれていった。だが、みらいはめげずに、リコとモフルンを励ます。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "5661928",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5661928",
                    "Titles": {
                        "eng": "A New Legend Has Sprouted! Cure Felice is Born!",
                        "jpn": "芽生える新たな伝説！キュアフェリーチェ誕生！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "消えてしまったはーちゃんは、どんなに探しても見つからなかった。みらいは、あきらめきれず「もう一度、はーちゃんを探しに行こう」と言う。だが、リコはもっと勉強をするために魔法界へ帰ることを決めていた。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "5661929",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5661929",
                    "Titles": {
                        "eng": "Together Forever! Welcome back, Ha-chan!",
                        "jpn": "これからもよろしく！おかえり、はーちゃん！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "はーちゃんが、みらいたちと同じぐらいの大きさの女の子になって帰ってきた。みらい、リコ、モフルンは抱き合って再開を喜ぶ。魔法のほうきで空を飛んでみたかったはーちゃんは、みらいの後ろに乗せてもらう。"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "5673908",
                    "TYPE": "OVA",
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5673908",
                    "Titles": {
                        "eng": "Exciting Renovations! Decorating Ha-chan's Room!",
                        "jpn": "ワクワクリフォーム！はーちゃんのお部屋づくり！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいの家で暮らすことになったはーちゃんは、よく寝て食べて、元気いっぱい。一方、みらいははーちゃんと同じベッドで寝ているため、寝不足気味だった。そこで、屋根裏部屋をはーちゃんの部屋にしようとする。"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "5673909",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5673909",
                    "Titles": {
                        "eng": "Summer! Beach! Having Fun! Let’s Eat Shaved Ice!",
                        "jpn": "夏だ！海だ！大はしゃぎ！かき氷が食べた～いっ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "夏休みとなり、みらい、リコ、はーちゃんは、みらいの家族やクラスメートのまゆみとかなも誘って海へ行くことになった。到着してすぐに、イチゴメロン味のかき氷がおいしい海の家へ向かってみると…。"
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "5673910",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5673910",
                    "Titles": {
                        "eng": "Everyone Has the Same Thoughts! Ha-chan's Cookies",
                        "jpn": "想いはみんな一緒！はーちゃんのクッキー"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "はーちゃんは、何度もヤモーに狙われる。自分のせいで、みらい、リコ、モフルンを\u000b危険な目に遭わせていると思ったはーちゃんは、家を出た。行く当てもないはーちゃんが歩いていると、背後に怪しい影が現れる。"
                    },
                    "Aliases": []
                },
                "27": {
                    "ID": "5696740",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5696740",
                    "Titles": {
                        "eng": "Let's Enjoy! Magic School's Summer Vacation!",
                        "jpn": "Ｌｅｔ'ｓエンジョイ！魔法学校の夏休み！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらい、はーちゃん、モフルンは、魔法学校の夏休みを体験しようと、リコと一緒に魔法界へ向かった。学校の中では、生徒たちが忙しそうにしている。それは魔法学校の夏祭りの準備をしているためだった。"
                    },
                    "Aliases": []
                },
                "28": {
                    "ID": "5696741",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5696741",
                    "Titles": {
                        "eng": "A Summer Festival in the Magical Realm! Fly High, Fireworks!",
                        "jpn": "魔法界の夏祭り！花火よ、たかくあがれ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法学校の夏祭りが開催される。魔法界では、あらゆるものがナシマホウ界で見るものとは違っていて、みらいは大はしゃぎする。クライマックスの打ち上げ花火に使うのは、人の背たけよりも大きなドンドン花だった。"
                    },
                    "Aliases": []
                },
                "29": {
                    "ID": "5696742",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5696742",
                    "Titles": {
                        "eng": "A Magical New Story! Mofuderella is the Star!?",
                        "jpn": "新たな魔法の物語！主役はモフデレラ！？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいたちは、魔法学校の図書館で絵本を見ていた。ナシマホウ界と同じように「シンデレラ」などの絵本が置いてあるが、ストーリーが少し違う。モフルンは、寮の部屋に戻ってからも「シンデレラ」に夢中になる。"
                    },
                    "Aliases": []
                },
                "30": {
                    "ID": "5696743",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5696743",
                    "Titles": {
                        "eng": "Magical Study Project! But it Won’t End!",
                        "jpn": "魔法の自由研究！が、終わらな～い！！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法界での夏休みも終わり、みらい、リコ、はーちゃん、モフルンはカタツムリニアに乗ってナシマホウ界へ帰ることになった。そんな中、ジュンたちから「自由研究を手伝ってほしい」とお願いされて…。"
                    },
                    "Aliases": []
                },
                "31": {
                    "ID": "5734489",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5734489",
                    "Titles": {
                        "eng": "Crystallized Feelings! Rainbow-Colored Alexandrite!",
                        "jpn": "結晶する想い！虹色のアレキサンドライト！！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいたちは、カタツムリニアに乗って魔法界からナシマホウ界へ帰る。だが、車両がカタツムリニアから外れてしまい、宙に投げ出されてしまった。車両から外に出てみたが、カタツムリニアはどこにもいない。"
                    },
                    "Aliases": []
                },
                "32": {
                    "ID": "5734490",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5734490",
                    "Titles": {
                        "eng": "Exciting! Ha-chan's School Life!",
                        "jpn": "ワクワクいっぱい！はーちゃんの学校生活！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "2学期が始まる。みらいとリコがいる中学校にはーちゃんが転校してくることになった。初登校日、みらいやリコと同じ制服を着たはーちゃんは、心が弾んでいた。そんな中、クラスメートの壮太は元気がなかった。"
                    },
                    "Aliases": []
                },
                "33": {
                    "ID": "5734491",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5734491",
                    "Titles": {
                        "eng": "Conflicted Feelings! Father and Daughter’s Difficult Day!",
                        "jpn": "すれ違う想い！父と娘のビミョ～な1日！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法界で考古学者をしているリコのパパ・リアンがナシマホウ界にやって来た。リアンは、いつも仕事で世界中を飛び回っていて、リコと会うのは久しぶり。だが、調べものに夢中でリコのことはそっちのけだった。"
                    },
                    "Aliases": []
                },
                "34": {
                    "ID": "5734492",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5734492",
                    "Titles": {
                        "eng": "Heart Pounding! Love Tastes Like Strawberry Melon Bread!?",
                        "jpn": "ドキドキ！初恋の味はイチゴメロンパン！？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "クラスメートのまゆみが、ある男の子に一目惚れした。だが、名前もどこの学校に通っているかも不明で、分かっているのは着ている制服だけだった。みらいは、その話を聞いてまゆみを応援することにした。"
                    },
                    "Aliases": []
                },
                "35": {
                    "ID": "5774782",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5774782",
                    "Titles": {
                        "eng": "Student Council General Election! Vote for Riko!",
                        "jpn": "生徒会長総選挙！リコに清き一票を！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいたちの学校では、生徒会長を決める選挙が始まり、リコは立候補することにした。すると、リコはポスターを作り、モフルンをマスコットキャラクターにして、みらいやはーちゃんたちに協力してもらう。"
                    },
                    "Aliases": []
                },
                "36": {
                    "ID": "5774784",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5774784",
                    "Titles": {
                        "eng": "Mirai and Mofurun, and Sometimes Chikurun! Wait, Who!?",
                        "jpn": "みらいとモフルン、ときどきチクルン！って誰！？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "みらいの家では、パンケーキとハチミツ、クリームでおやつの時間を過ごしていた。すると、みらいの家からの甘い匂いに誘われて妖精が部屋に入ってきた。それは、プリキュアを狙うオルーバのスパイ・チクルンだった。"
                    },
                    "Aliases": []
                },
                "37": {
                    "ID": "5774785",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5774785",
                    "Titles": {
                        "eng": "The Secret Ingredient is Magic? A Recipe for Frozen Mandarins!",
                        "jpn": "魔法が決め手? 冷凍みかんのレシピ!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "再び校長先生が魔法学校からいなくなる。みらいたちは、教頭先生から連絡をもらい、カタツムリニアで魔法界へ向かう。そんな中、水晶のキャシーから校長先生がぬっくい島にいるとの情報が寄せられる。"
                    },
                    "Aliases": []
                },
                "38": {
                    "ID": "5774786",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5774786",
                    "Titles": {
                        "eng": "Sweet? Not Sweet? The Magical Pumpkin Festival!",
                        "jpn": "甘い? 甘くない? 魔法のかぼちゃ祭り!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法界のお祭りの日。街はお菓子であふれ、みらいたちの気持ちは高ぶる。ところが、リコは「そんなに甘いお祭りじゃない」と一人気合が入っていた。そんな中、ナシマホウ界のアイドル・マユが姿を現す。"
                    },
                    "Aliases": []
                },
                "39": {
                    "ID": "5774787",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5774787",
                    "Titles": {
                        "eng": "Today is Halloween! Smile, Everyone!",
                        "jpn": "今日はハロウィン! みんな笑顔になぁれ!"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法学校のみんながハロウィンを体験しようと、ナシマホウ界にやって来た。みらいはモフルンに、リコは黒ネコに、はーちゃんはユニコーンに、モフルンは憧れのプリキュアの仮装にチャレンジするが…。"
                    },
                    "Aliases": []
                },
                "40": {
                    "ID": "5834911",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5834911",
                    "Titles": {
                        "eng": "Celebrations Filled With Love! Liko's Birthday!",
                        "jpn": "愛情いっぱいのおめでとう！リコの誕生日！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "テレビで活躍している料理研究家のリリアが、大量の野菜や肉、フルーツを抱えてみらいの家へやって来た。テレビでリリアを見ていたみらいたちは驚くが、彼女は、リコのお母さんだった。今日はリコの誕生日だった。"
                    },
                    "Aliases": []
                },
                "41": {
                    "ID": "5834912",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5834912",
                    "Titles": {
                        "eng": "Shining Brightly Every Day! Studying After School at Magic School!",
                        "jpn": "ジュエリーな毎日！魔法学校へ放課後留学！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法界とナシマホウ界の行き来が早くなったため、学校から帰ったみらいたちは、すぐにカタツムリニアで魔法界へ向かう。そして、魔法学校でも魔法の勉強をして、その後はまたナシマホウ界に戻って夕食を取る。"
                    },
                    "Aliases": []
                },
                "42": {
                    "ID": "5834913",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5834913",
                    "Titles": {
                        "eng": "Delivery for Chikurun! A Magical Pudding with Feelings!",
                        "jpn": "チクルンにとどけ！想いをのせた魔法のプリン！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法学校で調理実習をすることになった。魔法界に泊まったみらいたちも一緒に参加する。リズ先生が教えてくれるのは、魔法で作るナシマホウ界のプリン。手を使わずに、卵を割ったりする様子にみらいたちは驚く。"
                    },
                    "Aliases": []
                },
                "43": {
                    "ID": "5834914",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5834914",
                    "Titles": {
                        "eng": "To the Fairy Village! The Secret of the Magical World is Revealed!",
                        "jpn": "いざ妖精の里へ！あかされる魔法界のヒミツ！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "アメジストの力で、チクルンのふるさとである妖精の里への扉が開く。そこには、うっとりとするような妖精の世界が広がっていた。その時、はーちゃんは頭にある昔の記憶がよぎったため、小さな体に戻ってしまう。"
                    },
                    "Aliases": []
                },
                "44": {
                    "ID": "5885244",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5885244",
                    "Titles": {
                        "eng": "Mofurun’s Great Struggle! Everyone Has Become Children!?",
                        "jpn": "モフルン大奮闘！みんな子供になっちゃった！？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "何かが光り、みらい、リコ、はーちゃんが小さな子供になってしまった。空からオルーバが3人に何かをしたらしい。みらいたちは大慌てで、校長先生に相談しようとするが、結局子供であることを楽しんでしまう。"
                    },
                    "Aliases": []
                },
                "45": {
                    "ID": "5885245",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5885245",
                    "Titles": {
                        "eng": "Thoughts Over Time...! Forms of Friendship!",
                        "jpn": "想いは時を超えて…！友情のかたち！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法学校の校長先生がナシマホウ界にやって来た。見た目が若くてイケメンな校長先生は、カフェにいるだけで、みんなの注目を集める。みらいたちは、落ち着いて話をしたくて、校長先生を近くの公園へ連れ出す。"
                    },
                    "Aliases": []
                },
                "46": {
                    "ID": "5885246",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5885246",
                    "Titles": {
                        "eng": "Magical Christmas! Mirai Becomes Santa!?",
                        "jpn": "魔法のクリスマス！みらい、サンタになる！？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "魔法商店街はクリスマスムードに包まれていた。みらいたちは、魔法界のサンタに会いに行き、サンタの帽子をかぶったグスタフさんやアイザック先生を発見。また、みらいは、サンタの正体が魔法使いだと知り驚く。"
                    },
                    "Aliases": []
                },
                "47": {
                    "ID": "5919448",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5919448",
                    "Titles": {
                        "eng": "All of Our Wishes! Which Way is Tomorrow?",
                        "jpn": "それぞれの願い！明日はどっちだー？"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "冬休み最後の日。みらいは、ナシマホウ界でしかできないことをしようと考え、みんなと初詣に行くことにした。神社でみらいたちは、「魔法界もこっちの世界もみんな一緒に笑顔になれたら」と願う。"
                    },
                    "Aliases": []
                },
                "48": {
                    "ID": "5919449",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5919449",
                    "Titles": {
                        "eng": "Endless Chaos! The World of Deusmast!",
                        "jpn": "終わりなき混沌！デウスマストの世界！！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ナシマホウ界なのに、ペガサスや魔法のほうきで飛んでいる人が存在していた。ナシマホウ界と魔法界が混ざり合ったような世界が築かれていたのだ。みらいたちは校長先生にこのことを説明しようとする。"
                    },
                    "Aliases": []
                },
                "49": {
                    "ID": "5938390",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5938390",
                    "Titles": {
                        "eng": "Goodbye... Magicians! Come Back Again Miraculous Magic!",
                        "jpn": "さよなら…魔法つかい！奇跡の魔法よ、もう一度！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "プリキュアたちの強い思いが届いたことによって、レインボーキャリッジに太陽の魔法陣が完成した。3人は手を繋ぎ合って、デウスマストの「終わりなき混沌」にひるむことなく立ち向かおうとするが…。"
                    },
                    "Aliases": []
                },
                "50": {
                    "ID": "5950349",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/maho-girls-precure/episodes/5950349",
                    "Titles": {
                        "eng": "Cure Up Rapapa! The Future is Looking Bright!",
                        "jpn": "キュアップ・ラパパ！未来もいい日になあれ！！"
                    },
                    "Summaries": {
                        "eng": "",
