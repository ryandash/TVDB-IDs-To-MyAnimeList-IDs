        "1": {
            "ID": "731580",
            "URL": "https://thetvdb.com/series/the-idolm-ster-sidem/seasons/official/1",
            "Titles": {
                "eng": null,
                "jpn": null
            },
            "Summaries": {
                "eng": null,
                "jpn": null
            },
            "# Episodes": 13,
            "Episodes": {
                "1": {
                    "ID": "6333921",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6333921",
                    "Titles": {
                        "eng": "Idol with a Past",
                        "jpn": "理由(ワケ)あって、アイドル！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "弁護士の仕事に行き詰まりを感じていた天道輝は、酔った勢いでアイドルになる契約を交わしてしまう。身に覚えのない契約書と名刺の住所を頼りに315プロダクションを訪れた天道。\r\nそこで新人アイドルとして同じくスカウトされた元外科医・桜庭薫と元パイロット・柏木翼に出会う。\r\nアイドルになるつもりはなかった天道だが、プロデューサーの提案で、桜庭、柏木とともにライブハウスへと赴くことに。そこでアイドルグループ・Jupiterのライブを目の当たりにした天道は、あることに気づく・・・。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "6361686",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6361686",
                    "Titles": {
                        "eng": "Where Each Star Shines",
                        "jpn": "それぞれの輝き"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "商店街で働く仲間、教師、高校生バンド・・・と、様々な前職を持つアイドル達が、続々と集まってきた315プロダクション。しかし、彼らはアイドルとしてはまだまだ前途多難のようす。\r\nそんな中、勉強のため、アイドルの先輩であるJupiterのライブを全員で見学することに。ところが、悪天候からライブは中止の危機に追い込まれてしまう。\r\n果たしてJupiterのライブは無事開催されるのか、そして新人アイドル達は──！？"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "6361688",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6361688",
                    "Titles": {
                        "eng": "Courage to Fly",
                        "jpn": "飛び立つ勇気"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついにアイドルとして正式にデビューすることが決まったDRAMATIC STARS。\r\nメンバーそれぞれの思いが交錯するなか、営業に取材に忙しい日々を送っていた。\r\nデビューを目前にして少しずつと距離が縮まってきた3人。\r\nそしていよいよ、音楽番組の公開収録でデビュー曲を披露する日がやってくる。\r\nしかし、リハーサルの最中、柏木に異変が──！？"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "6364735",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6364735",
                    "Titles": {
                        "eng": "Happy Smile",
                        "jpn": "ハッピースマイル"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "商店街の紹介ムービーを撮影することになったBeit。\r\nそこはBeitのメンバーが出会うきっかけとなった、思い出の場所だった。\r\nしかし、近くに大型ショッピングモールの建設が決まり、商店街の人々は客足が遠のくのではないかと危惧していた。\r\nBeitの3人は商店街を盛り上げるために、お祭りでライブを開催することになったが・・・。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "6394390",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6394390",
                    "Titles": {
                        "eng": "Teachers, be ambitious!",
                        "jpn": "先生よ、大志を抱け！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "予備校主催の受験生応援ステージに出演することになったS.E.M。\r\nステージで初披露する振付けを完璧なものにするために、トレーニングとして早朝ランニングを取り入れることに。\r\nS.E.Mだけでなく、DRAMATIC STARS、Beit、High×Jokerのメンバーも加わり、一丸となってトレーニングに励むアイドル達。\r\n果たしてS.E.Mのステージは成功するのか──！？"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "6394391",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6394391",
                    "Titles": {
                        "eng": "Victory, Chosen by Both",
                        "jpn": "二人が選ぶVictor"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "盲腸のため、緊急入院となってしまったプロデューサー。\r\n入院先の病院で蒼井享介・悠介の双子の兄弟に出会う。\r\n二人はプロのサッカー選手として活躍しており、兄の悠介は試合中に負傷して入院をしていた。\r\nコンビネーションばっちりの蒼井兄弟。交流を深めるうち、二人にアイドルとしての素質を感じたプロデューサーは、315プロダクションにスカウトすることを決める。\r\nそんな折、悠介の引退報道が出て──！？"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "6415306",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6415306",
                    "Titles": {
                        "eng": "Limit of youth",
                        "jpn": "青春のリミット"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "ついにメジャーデビューが決定したHigh×Joker。\r\n知名度アップのために自作のプロモーションビデオを撮影することに。\r\n密着取材を続けていくうちに、お互いに知らなかった一面や、胸に秘めた本音が明らかになっていく。四季が軽音部に入部した理由、そしてHigh×Joker結成の経緯とは――？"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "6426079",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6426079",
                    "Titles": {
                        "eng": "Once again",
                        "jpn": "海・合宿・315の夏！"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "合同ライブの準備のため、海辺の宿舎で合宿をすることになった３１５プロダクションのメンバー。弱点を克服するためにチームに分かれてトレーニングをすることに。練習も食事の準備も自分たちの力でこなしていくうち、メンバー同士の絆も深まっていく。\r\n果たして合宿の成果は――？"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "6437768",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6437768",
                    "Titles": {
                        "eng": "Over Again",
                        "jpn": "Over AGAIN…"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "アイドルとしての活動が少しずつ軌道に乗り始め、名指しの仕事も増えてきた３１５プロダクションのメンバー。Jupiterの面々も先輩としてメンバーをフォローしながら、ますます熱心に練習へ打ち込んでいく。\r\nさらなる高みを目指すJupiterの胸の内には、自分たちの運命を変えたプロデューサーの言葉が強く焼き付いていた…。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "6447486",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6447486",
                    "Titles": {
                        "eng": "Sunset of Youth",
                        "jpn": "sunset of youth"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "自分たちの高校の文化祭でライブを行うことになったHigh×Joker。\r\n新曲を披露しようと盛り上がるメンバーの中で旬だけがどこか思いつめた様子で…。\r\n完璧な演奏を披露したいと願う旬は次第に焦る気持ちを露わにする。\r\n果たして文化祭ライブは成功するのか――？"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "6450872",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6450872",
                    "Titles": {
                        "eng": "Resolution on a Breezy Day",
                        "jpn": "風薫る日の決意"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "３１５プロダクションのメンバーが一丸となって開催する合同ライブが決定し、告知活動に追われるメンバーたち。そんな中、桜庭がソロ活動をしたいとプロデューサーに申し出る。突然の申し出に驚く天道と柏木だが、それぞれのやり方でライブの準備に取りかかることに。そんな折、突然桜庭のもとに天道から連絡が入り――。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "6463851",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6463851",
                    "Titles": {
                        "eng": "No Matter the Reason, No Matter the Dream...",
                        "jpn": "どんな理由も、どんな夢も、、、"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "事務所に相談せずソロの仕事を決めた桜庭。プロデューサーやDRAMATIC STARSのメンバーが心配するなか、桜庭はひとり仕事をこなしていく。心身の疲労もかえりみず、完璧を目指してひたすら仕事とレッスンに打ち込む桜庭だが、とうとう倒れてしまう。その時、３１５プロダクションのメンバーは――。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "6477765",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/the-idolm-ster-sidem/episodes/6477765",
                    "Titles": {
                        "eng": "Further and Further Still",
                        "jpn": "ずっと、ずっと、その先へ"
                    },
                    "Summaries": {
                        "eng": "",
                        "jpn": "いよいよ３１５プロダクション合同ライブ当日。\r\n大勢のファンが見守るなか、ライブが幕を開ける。それぞれの思いを胸に最高のパフォーマンスを繰り広げるアイドルたちと、ステージに立つ彼らを見守るプロデューサー。果たしてライブの行方は、そして３１５プロダクションの未来は――？"
                    },
                    "Aliases": []
                }
            }
        }
    }
}