    "Titles": {
        "eng": "My Senior Brother Has A Pit in His Brain",
        "jpn": null
    },
    "Summaries": {
        "eng": "The hilarious adventures of the eldest apprentice of a sect who has a problem with his brain.\r\n\r\nDongfang Xianyun is reincarnated as the eldest disciple of the Care-free sect. But the only thing that goes through his mind is to make sure he doesn't end up dying by the hands of the \"main character\". Read as he makes no sense to his sibling disciples while avoiding flags left and right.",
        "jpn": null
    },
    "Aliases": [
        "There's A Pit in  My Martial Senior Brother's Brain",
        "What's Wrong with My Big Brother (season 2)"
    ],
