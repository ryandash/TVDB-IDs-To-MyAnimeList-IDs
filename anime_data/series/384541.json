                "pt": null,
                "por": null
            },
            "Summaries": {
                "eng": null,
                "jpn": "人体改造が一般化した不正がはびこる街で、才能に恵まれながらもむてっぽうに生きる貧しい少年は、アウトローの傭兵(ようへい)である\"エッジランナー\"として歩み始める。",
                "fra": "Dans cet univers futuriste, les améliorations du corps est une pratique courante. Un jeune garçon doué, baignant dans une injustice permanente, sans moyen de gagner sa vie, choisie la voie du mercenariat hors-la-loi, un \"edge-runner\".",
                "pt": "Para sobreviver em uma realidade distópica na qual a corrupção e os implantes cibernéticos controlam tudo, um jovem talentoso e impulsivo decide se tornar um mercenário.",
                "por": "Numa distopia mergulhada em corrupção e paixão pelos implantes corporais, um miúdo talentoso, mas imprudente, esforça-se para se tornar um mercenário fora da lei."
            },
            "# Episodes": 10,
            "Episodes": {
                "1": {
                    "ID": "8761901",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8761901",
                    "Titles": {
                        "eng": "Let You Down",
                        "jpn": "Let You Down／期待を背に"
                    },
                    "Summaries": {
                        "eng": "After a night of streaming illegal braindance, David wakes up to reality: a rundown apartment with a broken washing machine and an overworked mother.",
                        "jpn": "ボロアパート、動かない洗濯機、そして過労気味の母親。夜遅くまで違法ブレインダンスに没頭したデイビッドが目覚めると、そこにはいつも通りのつらい現実が待っていた。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "8865679",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865679",
                    "Titles": {
                        "eng": "Like a Boy",
                        "jpn": "Like a Boy／少年は何を思う"
                    },
                    "Summaries": {
                        "eng": "With his newly enhanced body, David heads to the Academy seeking revenge on his bully. Later, he meets a mysterious woman who wants to recruit him.",
                        "jpn": "新しい体を手に入れたデイビッドは、自分をいじめた生徒に仕返しをするため、アカデミーにやって来る。その後、謎の女から手を組むことを提案され...。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "8865680",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865680",
                    "Titles": {
                        "eng": "Smooth Criminal",
                        "jpn": "Smooth Criminal／裏稼業"
                    },
                    "Summaries": {
                        "eng": "Surrounded by a group of rowdy edgerunners, David makes a plea to join their team. Meanwhile, sinister forces plot to lure him back to Arasaka Academy.",
                        "jpn": "エッジランナーたちに囲まれたデイビッドは、自分を仲間に入れてほしいと頼む。一方、悪しき思惑を持つ人物がデイビッドをアカデミーに呼び戻そうとする。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "8865681",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865681",
                    "Titles": {
                        "eng": "Lucky You",
                        "jpn": "Lucky You／ツキが回って"
                    },
                    "Summaries": {
                        "eng": "Eager to learn the edgerunner ropes, David pesters Maine for another mission. Instead, Maine tasks Lucy with training him.",
                        "jpn": "いち早く一人前のエッジランナーになるため、次の仕事をくれるようメインに催促するデイビッド。その結果、ルーシーの指導の下でトレーニングを受けることになる。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "8865682",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865682",
                    "Titles": {
                        "eng": "All Eyez on Me",
                        "jpn": "All Eyez on Me／刺さる目線"
                    },
                    "Summaries": {
                        "eng": "David makes a clever suggestion when the team strategizes for their next mission. However, he soon learns that their target can't be underestimated.",
                        "jpn": "作戦の成功に向け、機転の良さを発揮するデイビッド。だがその後、自分たちの標的がかなり手ごわい相手だということを身をもって知らされる。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "8865683",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865683",
                    "Titles": {
                        "eng": "Girl on Fire",
                        "jpn": "Girl on Fire／炎に包まれて"
                    },
                    "Summaries": {
                        "eng": "Maine doesn’t seem to be himself. But the team has bigger fish to fry: They must race against time to extract vital information from their prisoner.",
                        "jpn": "メインの様子がおかしいことに気づきながらも、目の前の重大な仕事を完遂しようとする仲間たち。タイムリミットが迫るなか、捕らえた標的から情報を抽出することはできるのか。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "8865684",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865684",
                    "Titles": {
                        "eng": "Stronger",
                        "jpn": "Stronger／もっと強く"
                    },
                    "Summaries": {
                        "eng": "Now an all-star edgerunner enhanced with more cybernetics, David leads his team into a new mission. An old contact reaches out to him for a big job.",
                        "jpn": "多数のサイバーウェアをインストールし、有名なエッジランナーとなったデイビッドはリーダーとしてチームをけん引。そんななか、知らぬ仲ではない相手から大きな仕事を持ちかけられる。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "8865685",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865685",
                    "Titles": {
                        "eng": "Stay",
                        "jpn": "Stay／いかないで"
                    },
                    "Summaries": {
                        "eng": "Faraday finds himself stuck between Arasaka and Militech. Lucy and Rebecca confront David about his change in behavior, but he refuses to listen.",
                        "jpn": "アラサカとミリテクの間で板挟みになるファラデー。デイビッドの様子を心配するルーシーやレベッカが本人と話をしようとするが、デイビッドは聞く耳を持たない。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "8865686",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865686",
                    "Titles": {
                        "eng": "Humanity",
                        "jpn": "Humanity／人間らしさ"
                    },
                    "Summaries": {
                        "eng": "Lucy’s captors learn about her secret mission and dark past. David and his team head out to complete Faraday’s job but realize that something is off.",
                        "jpn": "身柄を拘束され、自分の行いの動機や悲しい過去を知られてしまうルーシー。一方ファラデーの指示で仕事に取りかかったデイビッドたちは、何かがおかしいことに気づく。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "8865687",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/cyberpunk-edgerunners/episodes/8865687",
                    "Titles": {
                        "eng": "My Moon My Man",
                        "jpn": "My Moon My Man／私の月、私の恋"
                    },
                    "Summaries": {
                        "eng": "On the edge of cyberpsychosis but determined to save Lucy, David storms into Night City as Arasaka plots to deploy their ultimate lethal weapon.",
                        "jpn": "サイバーサイコ化しながらも、ルーシーを救うためにナイトシティに戻るデイビッド。アラサカは、そんなデイビッドを止めるべく最終兵器を発動させる。"
                    },
                    "Aliases": []
                }
            }
        },
