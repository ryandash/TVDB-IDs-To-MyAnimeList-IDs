            "Episodes": {
                "1": {
                    "ID": "7864811",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864811",
                    "Titles": {
                        "eng": null,
                        "jpn": "あらしのみつばち城"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハッチ、アーヤ、女王が暮らす「みどりの森」で、お城の完成パーティが行われていた。その責で、女王は娘のアーヤを新しい女王にすると宣言。一方、モモスズメガたちが、食料をめぐりいさかいを起こしていた。"
                    },
                    "Aliases": []
                },
                "2": {
                    "ID": "7864813",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864813",
                    "Titles": {
                        "eng": null,
                        "jpn": "ママ死なないで!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハッチとアーヤのママは女王の座を追われ、子供たちと共に働き蜂の生活を強いられていた。そして孫を新女王にし、権力を手にしたアグリーは軍隊を率いて戦いを起こす。そこへスズメバチの大群が現れ...。"
                    },
                    "Aliases": []
                },
                "3": {
                    "ID": "7864821",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864821",
                    "Titles": {
                        "eng": null,
                        "jpn": "幻のママがよんでいる"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ママを探して森の中を彷徨うハッチとアーヤは、スズメバチの少年・アバッチと出会う。「ママと会わせてやる」と言うアバッチに1人でついていくハッチ。しかし、そこでハッチが見たのは、ママのお墓だった。"
                    },
                    "Aliases": []
                },
                "4": {
                    "ID": "7864825",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864825",
                    "Titles": {
                        "eng": null,
                        "jpn": "飛びたて!美しの丘へ"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハッチはアーヤを悲しませたくないため、ママの死を言えずにいた。何も知らず「ママを探す」と言い張るアーヤに、困り果てるハッチ。そんななか、鳥に襲われたアーヤはバッタのお爺さんに助けられるが...。"
                    },
                    "Aliases": []
                },
                "5": {
                    "ID": "7864827",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864827",
                    "Titles": {
                        "eng": null,
                        "jpn": "力マキリー座の踊り子アーヤ"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "美しの丘へ向かう決意を固めたハッチとアーヤ。しかしそれも束の間、アーヤは鳥に襲われ、ハッチとはぐれてしまう。アーヤはアカアブのブン太と出会い、カマキリのカマ蔵のもとに連れていかれてしまい...。"
                    },
                    "Aliases": []
                },
                "6": {
                    "ID": "7864829",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864829",
                    "Titles": {
                        "eng": null,
                        "jpn": "泣くなテンテン坊主"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "アーヤを探す途中、ハッチはテントウ虫の少年・テンテンと出会う。テンテンの暮らすアブラ虫牧場は、ならず者のシオヤアブたちの暴力に悩まされていた。ハッチは悪人たちからテンテンを守り、仲良くなるが...。"
                    },
                    "Aliases": []
                },
                "7": {
                    "ID": "7864831",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864831",
                    "Titles": {
                        "eng": null,
                        "jpn": "ハッチ大都会をいく"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "アーヤを探して人間の住む大都会へやってきたハッチ。しかし、汚れた空気のせいでハッチは苦しみ、アスファルトの地面に落下して気絶してしまう。コオロギのコロ吉の一家に助けられたハッチは、病気を治すことに。"
                    },
                    "Aliases": []
                },
                "8": {
                    "ID": "7864833",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864833",
                    "Titles": {
                        "eng": null,
                        "jpn": "きもっ玉シデムシおばさん"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "アーヤを探して「悪魔の森」と呼ばれる森を訪れたハッチ。そこには「悪魔」が住んでおり、迷い込んだ子供を食べてしまうという。そこでハッチは檻に捕らえられた虫たちを逃がしてやるが、シデムシの女に襲われ...。"
                    },
                    "Aliases": []
                },
                "9": {
                    "ID": "7864835",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864835",
                    "Titles": {
                        "eng": null,
                        "jpn": "飛べ!わんぱくトリオ"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハッチを父の敵と思い込み、後を追うスズメバチのアバッチは忍者虫の亀三を使いアーヤの行方を探らせる。一方、孤独に旅を続けるアーヤはハッチを知っているテントウ虫のテンテンと出会うが、偽名を名乗り...。"
                    },
                    "Aliases": []
                },
                "10": {
                    "ID": "7864837",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864837",
                    "Titles": {
                        "eng": null,
                        "jpn": "ホタルまつりの夜"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "一緒に旅をすることになったハッチ、アーヤ、テンテンは船で川を下っている途中で、意地悪なホタルの少女・ピカルと出会う。ピカルは行方不明のテンテンの父親を知っていた。テンテンはピカルについていくことに。"
                    },
                    "Aliases": []
                },
                "11": {
                    "ID": "7864838",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864838",
                    "Titles": {
                        "eng": null,
                        "jpn": "もーれつ!しごき魔"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハサミ虫のカスタローと出会ったハッチたち。いじめられているカスタローを助け、家まで送ってやるが、カスタローの母・サミーはとても厳しく、息子を「いくじなし」と突き放す。ハッチはカスタローを連れ出す。"
                    },
                    "Aliases": []
                },
                "12": {
                    "ID": "7864839",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864839",
                    "Titles": {
                        "eng": null,
                        "jpn": "ああ!セミ吉くんの168時間"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ハッチ、アーヤ、テンテンは、アブラゼミのセミ吉の羽化を目撃。7年間の地中での生活から地上に出てこられたものの、その命は残り1週間だった。だが、彼には死んだママの抜け殻に会いにいくという目的があった。"
                    },
                    "Aliases": []
                },
                "13": {
                    "ID": "7864842",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864842",
                    "Titles": {
                        "eng": null,
                        "jpn": "アバッチ番長をぶっとばせ!"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "川を渡っていた途中、テッポウ魚に襲われたハッチたち。ハッチはテンテンを救うが、アーヤが行方不明に。テンテンは責任を感じ、アーヤを探しに出かける。その頃アーヤはスズメバチのアバッチに助けられていた。"
                    },
                    "Aliases": []
                },
                "14": {
                    "ID": "7864843",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864843",
                    "Titles": {
                        "eng": null,
                        "jpn": "毒ぐものわな"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "蝶に扮して出かけたお城のパーティで、アーヤは蝶の王子と互いに惹かれあうが、妬む蝶子に毒グモの住む森へと誘われてしまう。傷ついた心をアーヤに癒やされた王子は、お妃になってほしいとプロポーズする。"
                    },
                    "Aliases": []
                },
                "15": {
                    "ID": "7864844",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864844",
                    "Titles": {
                        "eng": null,
                        "jpn": "みの虫の消える悪魔の森"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "煙を吐く怪獣の森にやってきたハッチたちは、みの虫の家に住むみの吉と出会う。煙にまかれ倒れたテンテンの姿が消え、アーヤとみの吉は怪獣にさらわれてしまう。一方、テンテンはハッチたちと共にアーヤを探す。"
                    },
                    "Aliases": []
                },
                "16": {
                    "ID": "7864845",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864845",
                    "Titles": {
                        "eng": null,
                        "jpn": "がんばれ!ブーブー大将"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "虫の遊園地では、ヘッピリ虫のブー太郎と遊ぶアーヤを虫の子供たちがからかっていた。ブー太郎は、おならをみんなにあざ笑われるブーブー大将だった。妹のプー子を殺されたブー太郎は、アーヤに妹の面影を重ね...。"
                    },
                    "Aliases": []
                },
                "17": {
                    "ID": "7864846",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864846",
                    "Titles": {
                        "eng": null,
                        "jpn": "ラブラブ・テンテン・港町"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "浜辺で波と戯れるハッチたち。丸太に乗ったテンテンはナナフシの娘・ナナと出会う。ナナは寒い国では長生きできないと物知りなフナ虫の爺さんに聞かされたハッチだが、テンテンは一緒に連れていくと言い張り...。"
                    },
                    "Aliases": []
                },
                "18": {
                    "ID": "7864847",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864847",
                    "Titles": {
                        "eng": null,
                        "jpn": "アリの巣城のチョウチョ"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "ヤスデに襲われ逃げ惑うハッチたちは、クロオオアリのお爺さん・クロジイに助けられ、アリの巣にかくまわれる。アリの巣で歓待されるハッチたちだが、食料が底を突いた時、アリたちの怒りが爆発し...。"
                    },
                    "Aliases": []
                },
                "19": {
                    "ID": "7864848",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864848",
                    "Titles": {
                        "eng": null,
                        "jpn": "タガメ海賊のしゅうげき"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "アメンボ、メダカ、川の仲間たちと仲良く暮らすヤゴのケン。ヤゴの大将たちといがみあうがケンだが、立派なトンボになることを夢見ていた。ハッチと仲良くなったケンは一緒に空を飛ぶ約束をするが...。"
                    },
                    "Aliases": []
                },
                "20": {
                    "ID": "7864849",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864849",
                    "Titles": {
                        "eng": null,
                        "jpn": "燃えろ!砂漠の決闘"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "果てしなく続く砂漠のあまりの暑さに力尽きたアーヤをハナダカバチのハジミが助ける。ハジミの家に身を寄せたハッチたちだが、そこにはアバッチが待ち伏せていた。アバッチに加勢を約束するハジミだが...。"
                    },
                    "Aliases": []
                },
                "21": {
                    "ID": "7864851",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864851",
                    "Titles": {
                        "eng": null,
                        "jpn": "飛べ!飛べ!虫の運動会"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "雨上がりの日、虫たちが運動会をしていた。賞品の風船がどうしても欲しいアーヤは運動会に参加させてと頼む。長距離飛行の賞品を懸けて、飛んだことのない黄金虫のキン子とアーヤ、ヤンマのトビ助らが飛び出すが...。"
                    },
                    "Aliases": []
                },
                "22": {
                    "ID": "7864852",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864852",
                    "Titles": {
                        "eng": null,
                        "jpn": "コロコロ・リンリン・のどじまん"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "トンボのおじさんに乗って「音楽の森」に来たハッチたち。そこに聞こえてくるスズ虫の娘・スズ子の歌。惹かれあうハッチとスズ子だったが、音楽会の賞品を狙うウマ子たちの策略でスズ子の羽根が切られてしまう。"
                    },
                    "Aliases": []
                },
                "23": {
                    "ID": "7864854",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864854",
                    "Titles": {
                        "eng": null,
                        "jpn": "せまる!コウモリ軍団"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "季節は秋。旅を急ぐハッチたちだが、うっかりママの羽根を飛ばしてしまう。川に落ちた羽根を追い鍾乳洞に迷い込んでしまったハッチとアーヤ。コウモリに追われるゴミムシの子供・ゴロを助けたハッチたちだが...。"
                    },
                    "Aliases": []
                },
                "24": {
                    "ID": "7864856",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864856",
                    "Titles": {
                        "eng": null,
                        "jpn": "決闘!ジガバチ砦"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "森に着いたハッチたちは、フンコロガシの仲良し親子・玉五郎とブン太に出会うが、村では虫たちに避けられてしまう。それは、ハッチとアーヤが村の大人を連れ去ったジガバチと同じハチの仲間だからだった。"
                    },
                    "Aliases": []
                },
                "25": {
                    "ID": "7864858",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864858",
                    "Titles": {
                        "eng": null,
                        "jpn": "火の山!最後の死闘"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "煙吹く溶岩が流れる火山地帯にぶつかったハッチたち。この山を通らなければ「美しの丘」にはたどり着けない。さらに、「美しの丘には山の仙人虫の案内がないと行けない」と、ムカデとクモの子供にだまされ...。"
                    },
                    "Aliases": []
                },
                "26": {
                    "ID": "7864859",
                    "TYPE": null,
                    "URL": "https://www.thetvdb.com/series/honeybee-hutch/episodes/7864859",
                    "Titles": {
                        "eng": null,
                        "jpn": "ああ!ハッチ最後の日"
                    },
                    "Summaries": {
                        "eng": null,
                        "jpn": "日照りに襲われた森。バッタの大群が最後の草を食い荒らす。バッタのリーダー・バッタバに挑みかかるハッチだったが、バッタたちも生き残るために必死だった。最後の難関の雪山を越えれば「美しの丘」だが...。"
                    },
                    "Aliases": []
                }
            }
        }
    }
}